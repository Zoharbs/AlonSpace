<%- include('partials/head', { title }) %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="container" style="position:relative; z-index:2;">
    <div class="breadcrumb">
      <a href="/">דף הבית</a> / קביעת סיור
    </div>

    <span class="eyebrow">סיור אישי</span>

    <h1>בואו לראות את המשרדים.</h1>

    <p>
      השאירו פרטים, בחרו זמן בשבועיים הקרובים,
      ואנחנו נחזור אליכם לאישור הסיור.
    </p>
  </div>
</section>


<section>
  <div class="container booking-layout">

    <!-- צד הסבר -->
    <div class="booking-side">

      <span class="eyebrow">מה קורה בסיור?</span>

      <h2>20 דקות, בלי התחייבות.</h2>

      <p>
        נראה לכם את המתחם, את המשרדים הפנויים,
        את חדר הישיבות והשירותים מסביב.
        אם זה מתאים - ממשיכים משם.
      </p>

      <div class="booking-points">
        <div>✓ מגדלי אלון, תל אביב</div>
        <div>✓ משרדים פרטיים ומרוהטים</div>
        <div>✓ תיאום לפי זמינות בשבועיים הקרובים</div>
      </div>

    </div>


    <!-- טופס -->
    <div>

      <div id="formMsg" class="form-msg"></div>

      <form id="bookingForm" class="booking-card">

        <div class="form-row-2">

          <div class="field">
            <label for="name">שם מלא</label>

            <input
              type="text"
              id="name"
              name="name"
              autocomplete="name"
              required
            >
          </div>


          <div class="field">
            <label for="phone">טלפון</label>

            <input
              type="tel"
              id="phone"
              name="phone"
              autocomplete="tel"
              required
            >
          </div>

        </div>


        <div class="form-row-2">

          <div class="field">

            <label for="booking_date">
              בחרו יום
            </label>

            <input
              type="date"
              id="booking_date"
              name="booking_date"
              lang="he"
              required
            >

          </div>


          <div class="field">

            <label for="time_slot">
              בחרו שעה
            </label>

            <select
              id="time_slot"
              name="time_slot"
              required
            >
              <option value="">
                בחרו שעה
              </option>

              <option value="09:00">09:00</option>
              <option value="10:00">10:00</option>
              <option value="11:00">11:00</option>
              <option value="12:00">12:00</option>
              <option value="13:00">13:00</option>
              <option value="14:00">14:00</option>
              <option value="15:00">15:00</option>
              <option value="16:00">16:00</option>
              <option value="17:00">17:00</option>

            </select>

          </div>

        </div>


        <div class="field">

          <label for="message">
            משהו חשוב שנדע?
          </label>

          <textarea
            id="message"
            name="message"
            placeholder="למשל: כמה אנשים יגיעו, מתי תרצו להיכנס או כל שאלה אחרת."
          ></textarea>

        </div>


        <button
          type="submit"
          class="btn btn-gold btn-block"
        >
          שלח
        </button>

      </form>

    </div>

  </div>
</section>


<%- include('partials/footer') %>
<%- include('partials/scripts') %>


<script>
const form =
  document.getElementById('bookingForm');

const dateInput =
  document.getElementById('booking_date');

const formMsg =
  document.getElementById('formMsg');


// ========================================
// הגבלת תאריך לשבועיים הקרובים
// ========================================

function formatDateForInput(date) {
  const year = date.getFullYear();

  const month =
    String(date.getMonth() + 1)
      .padStart(2, '0');

  const day =
    String(date.getDate())
      .padStart(2, '0');

  return `${year}-${month}-${day}`;
}


const today = new Date();

const maxDate = new Date();
maxDate.setDate(
  maxDate.getDate() + 14
);

dateInput.min =
  formatDateForInput(today);

dateInput.max =
  formatDateForInput(maxDate);


// ========================================
// שליחה לוואטסאפ
// ========================================

form.addEventListener(
  'submit',
  function (e) {

    e.preventDefault();

    const data =
      Object.fromEntries(
        new FormData(form).entries()
      );


    if (
      !data.name ||
      !data.phone ||
      !data.booking_date ||
      !data.time_slot
    ) {

      formMsg.textContent =
        'נא למלא שם, טלפון, יום ושעה.';

      formMsg.className =
        'form-msg show err';

      return;
    }


    const selectedDate =
      new Date(
        data.booking_date + 'T12:00:00'
      );


    const formattedDate =
      selectedDate.toLocaleDateString(
        'he-IL'
      );


    const dayName =
      selectedDate.toLocaleDateString(
        'he-IL',
        {
          weekday: 'long'
        }
      );


    let message =
`היי, אשמח להגיע לסיור ב${dayName} (${formattedDate}) בשעה ${data.time_slot}

שם: ${data.name}
טלפון: ${data.phone}`;


    if (data.message.trim()) {

      message +=
        `\nהערות: ${data.message.trim()}`;

    }


    message +=
      `\n\nאשמח לאישור הסיור.`;


    const whatsappNumber =
      '972544730266';


    const whatsappUrl =
      `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;


    window.location.href =
      whatsappUrl;

  }
);
</script>