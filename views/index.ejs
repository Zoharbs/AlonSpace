<!doctype html><html lang="he" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#142b46"><link rel="manifest" href="/expenses-app/manifest.webmanifest"><link rel="icon" href="/expenses-app/icon.svg" type="image/svg+xml"><title>AlonSpace Expenses</title><style>
:root{font-family:Arial,sans-serif;color:#1a2b42;background:#f4f6f9}*{box-sizing:border-box}body{margin:0}header{background:#142b46;color:white;padding:20px 24px}header a{color:#fff}main{padding:18px;max-width:1450px;margin:auto}h1{margin:0 0 8px}.bar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:14px 0}button,.btn{border:0;background:#183858;color:#fff;border-radius:9px;padding:10px 14px;cursor:pointer}input,select{padding:9px;border:1px solid #ccd3dc;border-radius:8px;max-width:100%}section{background:white;border-radius:14px;padding:16px;margin:14px 0;box-shadow:0 1px 6px #0001}.tablewrap{overflow:auto}table{border-collapse:separate;border-spacing:3px;min-width:1040px;width:100%;font-size:13px}th{background:#1b3552;color:white;padding:12px;white-space:nowrap}td{padding:3px;text-align:center}td:first-child{min-width:170px;text-align:right;font-weight:bold}.cell{display:block;width:100%;border:0;border-radius:6px;padding:10px 5px;cursor:pointer;white-space:nowrap;color:#16253a}.estimated{background:#f9e49a}.paid{background:#b7e4c3}.empty{background:#edf0f5}.summary td{background:#e4edf7;font-weight:bold}.cards{display:flex;gap:12px;flex-wrap:wrap}.card{flex:1;min-width:160px;background:#eef2f7;border-radius:12px;padding:14px}.card strong{display:block;font-size:22px;margin-top:8px}.alert{padding:12px;border-radius:8px;background:#ffeadf;color:#8e2c1d}dialog{border:0;border-radius:16px;box-shadow:0 20px 60px #0004;width:min(500px,94vw);padding:24px}dialog form{display:grid;gap:12px}dialog label{display:grid;gap:5px}dialog::backdrop{background:#101b2d99}.months{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.months label{display:flex;align-items:center;gap:4px;font-size:13px}.muted{color:#64748b;font-size:12px}
</style></head><body><header><h1>AlonSpace · ניהול הוצאות</h1><span>שלום <%= user.display_name %></span></header><main>
<div class="bar"><a class="btn" href="/expenses?floor=4&year=<%= year %>">קומה 4</a><a class="btn" href="/expenses?floor=6&year=<%= year %>">קומה 6</a><strong>קומה <%= floor %></strong><form method="get"><input type="hidden" name="floor" value="<%= floor %>"><label>שנה <input type="number" min="2020" max="2100" name="year" value="<%= year %>"></label><button>הצג</button></form></div>
<% if(error){ %><p class="alert"><%= error %></p><% } %><% if(success){ %><p><%= success %></p><% } %>
<% const money=n=>'₪'+Number(n||0).toLocaleString('he-IL',{minimumFractionDigits:0,maximumFractionDigits:2}); const names=['ינואר','פברואר','מרץ','אפריל','מאי','יוני','יולי','אוגוסט','ספטמבר','אוקטובר','נובמבר','דצמבר']; %>
<section><div class="bar"><button type="button" onclick="openPayment('electricity')">חשבון חשמל</button><button type="button" onclick="openPayment('arnona')">תשלום ארנונה</button><button type="button" onclick="document.getElementById('categoryDialog').showModal()">קטגוריה / ברירת מחדל</button><span class="muted">צהוב = הערכה · ירוק = שולם בפועל</span></div>
<div class="tablewrap"><table><thead><tr><th>קטגוריה</th><% months.forEach((m,i)=>{ %><th><%= names[i] %></th><% }) %></tr></thead><tbody>
<% categories.forEach(c=>{ %><tr><td><%= c.name %> <span class="muted">(<%= c.kind==='electricity'?'חשמל':c.kind==='arnona'?'ארנונה':'רגיל' %>)</span></td><% months.forEach(m=>{ const e=entryMap[c.id+':'+m];const amount=e?(e.status==='paid'?e.actual_amount:e.estimated_amount):c.default_amount; %><td><button class="cell <%= e&&e.status==='paid'?'paid': 'estimated' %>" type="button" data-category="<%= c.id %>" data-kind="<%= c.kind %>" data-month="<%= m %>" data-entry="<%= e?e.id:'' %>" data-amount="<%= amount %>" data-status="<%= e?e.status:'estimated' %>" onclick="openCell(this)"><%= money(amount) %></button></td><% }) %></tr><% }) %>
<tr class="summary"><td>סה״כ הוצאות צפויות / סופיות</td><% months.forEach(m=>{let total=0;categories.forEach(c=>{const e=entryMap[c.id+':'+m];total+=Number(e?(e.status==='paid'?e.actual_amount:e.estimated_amount):c.default_amount||0)}); %><td><%= money(total) %></td><% }) %></tr>
</tbody></table></div></section>
<section><h2>איך עובדים עם הטבלה?</h2><p>לחיצה על תא רגיל מאפשרת לערוך הערכה או לסמן תשלום סופי. חשמל וארנונה מוזנים באמצעות טופס ייעודי. כל חודש ללא רשומה מציג את סכום ברירת המחדל של הקטגוריה.</p><p class="muted">בגרסה זו תשלום מחולק אינו ניתן לדריסה, כדי למנוע אובדן עקיבות. יש להוסיף בהמשך מסך תיקון / ביטול מסודר לחשבונות.</p></section>
</main>
<dialog id="categoryDialog"><form method="post" action="/expenses/categories"><h2>קטגוריה / ברירת מחדל</h2><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="floor" value="<%= floor %>"><label>שם קטגוריה<input name="name" required maxlength="100" list="categoryNames"></label><datalist id="categoryNames"><% categories.forEach(c=>{ %><option value="<%= c.name %>"></option><% }) %></datalist><label>סכום ברירת מחדל לחודש<input type="number" name="default_amount" min="0" step="0.01" required value="0"></label><button>שמור</button><button type="button" onclick="categoryDialog.close()">ביטול</button></form></dialog>
<dialog id="cellDialog"><form id="cellForm" method="post" action="/expenses/estimate"><h2 id="cellTitle">עריכת הוצאה</h2><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="category_id" id="cellCategory"><input type="hidden" name="month" id="cellMonth"><input type="hidden" name="entry_id" id="cellEntry"><label>סכום (₪)<input type="number" name="amount" id="cellAmount" min="0" step="0.01" required></label><button id="saveEstimate">שמור הערכה</button><button id="finalize" type="button" onclick="finalizeCell()">סמן כשולם (ירוק)</button><button type="button" onclick="cellDialog.close()">ביטול</button></form></dialog>
<dialog id="paymentDialog"><form method="post" action="/expenses/payment" id="paymentForm"><h2 id="paymentTitle">תשלום חדש</h2><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="category_id" id="paymentCategory"><label>סכום כולל (₪)<input type="number" min="0.01" step="0.01" name="amount" required></label><div id="electricDates"><label>תחילת תקופת הצריכה לפי החשבון<input type="date" name="period_start"></label><label>סיום תקופת הצריכה לפי החשבון<input type="date" name="period_end"></label><p class="muted">למשל 28/08–27/10 יחולק לספטמבר ואוקטובר. תאריכים הם חובה.</p></div><div id="arnonaMonths"><p>בחרו חודשים שהתשלום מכסה:</p><div class="months"><% months.forEach((m,i)=>{ %><label><input type="checkbox" class="arnonaMonth" value="<%= m %>"><%= names[i] %></label><% }) %></div><input type="hidden" name="months" id="selectedMonths"></div><div id="regularMonth"><label>חודש<input type="month" name="month" value="<%= year %>-01"></label></div><label>מצב התשלום<select name="status"><option value="estimated">הערכה / טרם שולם (צהוב)</option><option value="paid">שולם בפועל (ירוק)</option></select></label><button type="submit">שמור וחלק לחודשים</button><button type="button" onclick="paymentDialog.close()">ביטול</button></form></dialog>
<script>
const categories=<%- JSON.stringify(categories.map(c=>({id:c.id,kind:c.kind,name:c.name}))).replace(/</g,'\\u003c') %>;
function openPayment(kind){const c=categories.find(c=>c.kind===kind);if(!c){alert('יש ליצור קטגוריה מתאימה קודם');return}paymentForm.reset();paymentCategory.value=c.id;paymentTitle.textContent=kind==='electricity'?'חשבון חשמל':'תשלום ארנונה';electricDates.hidden=kind!=='electricity';arnonaMonths.hidden=kind!=='arnona';regularMonth.hidden=true;electricDates.querySelectorAll('input').forEach(i=>i.required=kind==='electricity');paymentDialog.showModal()}
function openCell(el){const kind=el.dataset.kind;if(kind!=='regular'){openPayment(kind);return}cellCategory.value=el.dataset.category;cellMonth.value=el.dataset.month;cellEntry.value=el.dataset.entry;cellAmount.value=el.dataset.amount;cellTitle.textContent='הוצאה — '+el.dataset.month;saveEstimate.disabled=el.dataset.status==='paid';finalize.disabled=el.dataset.status==='paid';cellDialog.showModal()}
function finalizeCell(){if(!cellEntry.value){alert('קודם שמרו הערכה, ואז סמנו אותה כשולמה');return}const f=document.getElementById('cellForm');f.action='/expenses/finalize';cellAmount.name='actual_amount';f.submit()}
cellDialog.addEventListener('close',()=>{cellForm.action='/expenses/estimate';cellAmount.name='amount'});
paymentForm.addEventListener('submit',e=>{if(!arnonaMonths.hidden){selectedMonths.value=[...document.querySelectorAll('.arnonaMonth:checked')].map(x=>x.value).join(',');if(!selectedMonths.value){e.preventDefault();alert('יש לבחור לפחות חודש אחד')}}});
if('serviceWorker' in navigator)navigator.serviceWorker.register('/expenses-app/sw.js',{scope:'/expenses'}).catch(()=>{});
</script></body></html>
