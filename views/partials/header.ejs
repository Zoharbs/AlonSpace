<% const loggedInUser=typeof currentUser !=='undefined' && currentUser ? currentUser : null; const currentPath=typeof
  path !=='undefined' ? path : '' ; const isTenant=loggedInUser && loggedInUser.role==='tenant' ; const
  isAdmin=loggedInUser && loggedInUser.role==='admin' ; %>

  <style>
    .header-account {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .header-account-name {
      color: var(--cream);
      font-weight: 700;
      white-space: nowrap;
    }

    .header-logout-form {
      margin: 0;
    }

    .header-logout {
      background: transparent;
      color: var(--cream);
      border: 1px solid rgba(247, 242, 230, .45);
    }

    .header-logout:hover {
      background: var(--cream);
      color: var(--ink);
    }

    @media (max-width: 900px) {
      .header-cta {
        display: none;
      }

      .mobile-nav-action {
        display: block;
      }

      .mobile-nav-login {
        font-weight: 700;
      }

      .mobile-nav-tour {
        font-weight: 700;
      }

      .header-account-name {
        display: none;
      }

      .header-cta {
        display: none;
      }

      .header-account {
        margin-inline-start: auto;
      }

      .header-logout {
        padding: 9px 12px;
        font-size: .82rem;
      }
      .nav-dropdown {
  width: 100%;
  display: block;
}

.nav-dropdown-trigger {
  width: 100%;
}

.nav-dropdown-menu {
  position: static;
  min-width: 0;
  width: 100%;
  margin-top: 4px;
  padding: 4px 12px;

  background: transparent;
  box-shadow: none;

  opacity: 1;
  visibility: visible;
  transform: none;
}

.nav-dropdown-menu a {
  color: var(--cream) !important;
  padding: 8px 16px;
  font-size: .9rem;
  opacity: .8;
}
    }

    .nav-dropdown {
      position: relative;
      display: flex;
      align-items: center;
    }

    .nav-dropdown-trigger {
      display: flex !important;
      align-items: center;
      gap: 5px;
    }

    .nav-dropdown-arrow {
      font-size: .8em;
      transition: transform .2s ease;
    }

    .nav-dropdown-menu {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;

      min-width: 190px;
      padding: 8px;

      background: var(--cream);
      border-radius: 10px;
      box-shadow: var(--shadow);

      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);

      transition:
        opacity .2s ease,
        visibility .2s ease,
        transform .2s ease;

      z-index: 1000;
    }

    .nav-dropdown-menu a {
      display: block;
      padding: 10px 12px;

      color: var(--ink) !important;
      text-decoration: none;
      white-space: nowrap;

      border-radius: 7px;
    }

    .nav-dropdown-menu a:hover {
      background: var(--stone);
    }

    .nav-dropdown:hover .nav-dropdown-menu,
    .nav-dropdown:focus-within .nav-dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .nav-dropdown:hover .nav-dropdown-arrow,
    .nav-dropdown:focus-within .nav-dropdown-arrow {
      transform: rotate(180deg);
    }

    .mobile-nav-action {
      display: none;
    }
  </style>

