      <path d="M15.5 3c.3 1.8 1.4 3.2 3.5 3.7v3.1c-1.4 0-2.7-.4-3.8-1.2v6.2a6.2 6.2 0 11-5.3-6.1v3.2a3.1 3.1 0 103 3.1V3h2.6z"/>
    </svg>
  </a>

</div>
<script>
  const accessibilityButton =
    document.getElementById('accessibilityButton');

  const accessibilityMenu =
    document.getElementById('accessibilityMenu');

  const increaseButton =
    document.getElementById('accessibilityIncrease');

  const decreaseButton =
    document.getElementById('accessibilityDecrease');

  const contrastButton =
    document.getElementById('accessibilityContrast');

  const linksButton =
    document.getElementById('accessibilityLinks');

  const resetButton =
    document.getElementById('accessibilityReset');


  let accessibilityFontSize =
    Number(
      localStorage.getItem('accessibilityFontSize')
    ) || 100;


  function applyAccessibilitySettings() {

    document.documentElement.style.fontSize =
      accessibilityFontSize + '%';

    const highContrast =
      localStorage.getItem(
        'accessibilityHighContrast'
      ) === 'true';

    const highlightLinks =
      localStorage.getItem(
        'accessibilityHighlightLinks'
      ) === 'true';

    document.body.classList.toggle(
      'accessibility-high-contrast',
      highContrast
    );

    document.body.classList.toggle(
      'accessibility-highlight-links',
      highlightLinks
    );
  }
accessibilityMenu?.addEventListener(
  'click',
  (event) => {
    event.stopPropagation();
  }
);

  accessibilityButton?.addEventListener(
    'click',
    (event) => {

      event.stopPropagation();

      const isOpen =
        !accessibilityMenu.hidden;

      accessibilityMenu.hidden = isOpen;

      accessibilityButton.setAttribute(
        'aria-expanded',
        String(!isOpen)
      );
    }
  );


  increaseButton?.addEventListener(
    'click',
    () => {

      accessibilityFontSize =
        Math.min(
          accessibilityFontSize + 10,
          140
        );

      localStorage.setItem(
        'accessibilityFontSize',
        accessibilityFontSize
      );

      applyAccessibilitySettings();
    }
  );


  decreaseButton?.addEventListener(
    'click',
    () => {

      accessibilityFontSize =
        Math.max(
          accessibilityFontSize - 10,
          80
        );

      localStorage.setItem(
        'accessibilityFontSize',
        accessibilityFontSize
      );

      applyAccessibilitySettings();
    }
  );


  contrastButton?.addEventListener(
    'click',
    () => {

      const active =
        document.body.classList.toggle(
          'accessibility-high-contrast'
        );

      localStorage.setItem(
        'accessibilityHighContrast',
        String(active)
      );
    }
  );


  linksButton?.addEventListener(
    'click',
    () => {

      const active =
        document.body.classList.toggle(
          'accessibility-highlight-links'
        );

      localStorage.setItem(
        'accessibilityHighlightLinks',
        String(active)
      );
    }
  );


  resetButton?.addEventListener(
    'click',
    () => {

      accessibilityFontSize = 100;

      localStorage.removeItem(
        'accessibilityFontSize'
      );

      localStorage.removeItem(
        'accessibilityHighContrast'
      );

      localStorage.removeItem(
        'accessibilityHighlightLinks'
      );

      document.documentElement.style.fontSize = '';

      document.body.classList.remove(
        'accessibility-high-contrast',
        'accessibility-highlight-links'
      );
    }
  );


  document.addEventListener(
    'click',
    (event) => {

      if (
        accessibilityMenu &&
        accessibilityButton &&
        !accessibilityMenu.contains(event.target) &&
        !accessibilityButton.contains(event.target)
      ) {
        accessibilityMenu.hidden = true;

        accessibilityButton.setAttribute(
          'aria-expanded',
          'false'
        );
      }
    }
  );


  applyAccessibilitySettings();
</script>