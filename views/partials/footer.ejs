<div class="floating-side-buttons">

  <!-- כפתור נגישות -->
<div class="accessibility-wrapper">

  <button
    type="button"
    class="floating-side-btn accessibility-btn"
    id="accessibilityButton"
    aria-label="פתיחת תפריט נגישות"
    aria-expanded="false"
    aria-controls="accessibilityMenu"
    title="נגישות"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="4" r="2"></circle>
      <path d="M5 7.5h14"></path>
      <path d="M12 6v6"></path>
      <path d="M12 12l-4 8"></path>
      <path d="M12 12l4 8"></path>
    </svg>
  </button>

  <div
    class="accessibility-menu"
    id="accessibilityMenu"
    hidden
  >
    <div class="accessibility-menu-title">
      אפשרויות נגישות
    </div>

    <button type="button" id="accessibilityIncrease">
      א+ הגדלת טקסט
    </button>

    <button type="button" id="accessibilityDecrease">
      א− הקטנת טקסט
    </button>

    <button type="button" id="accessibilityContrast">
      ◐ ניגודיות גבוהה
    </button>

    <button type="button" id="accessibilityLinks">
      🔗 הדגשת קישורים
    </button>

    <button type="button" id="accessibilityReset">
      ↻ איפוס נגישות
    </button>

    <a href="/accessibility">
      הצהרת נגישות
    </a>
  </div>

</div>

  <!-- Instagram -->
