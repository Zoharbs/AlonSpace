<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body style="background:var(--ink); min-height:100vh; display:flex; align-items:center; justify-content:center;">

  <div class="card" style="width:100%; max-width:380px; margin:20px;">

    <div class="text-center" style="margin-bottom:20px;">
      <img
        src="/images/Asset 11.svg"
        alt="AlonSpace"
        style="width:60px; height:60px; margin:0 auto 12px; display:block;"
      >

      <h2 class="mt-0">שכחת סיסמה?</h2>

      <p class="small">
        הזן את כתובת המייל המשויכת לחשבון שלך ונשלח לך קישור לאיפוס הסיסמה.
      </p>
    </div>

    <% if (error) { %>
      <div class="form-msg show err"><%= error %></div>
    <% } %>

    <% if (success) { %>
      <div class="form-msg show"><%= success %></div>
    <% } %>

    <form method="POST" action="/forgot-password" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <label for="email">כתובת מייל</label>
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
        >
      </div>

      <button type="submit" class="btn btn-primary btn-block">
        שליחת קישור לאיפוס סיסמה
      </button>
    </form>

    <div class="text-center" style="margin-top:20px;">
      <a href="/login">חזרה להתחברות</a>
    </div>

  </div>

</body>
</html>