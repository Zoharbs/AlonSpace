<!DOCTYPE html>
<html lang="he" dir="rtl">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= title %></title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <style>
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    body {
      background: var(--ink);
      color: var(--cream);
    }

    .room-screen {
      position: relative;

      width: 100vw;
      height: 100vh;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      text-align: center;

      background:
        radial-gradient(
          circle at 50% 45%,
          rgba(124, 108, 240, .16),
          transparent 42%
        ),
        var(--ink);
    }


    /* =========================
       לוגו
    ========================= */

    .room-brand {
      position: absolute;
      top: 42px;
      right: 50%;

      transform: translateX(50%);

      display: flex;
      align-items: center;
      gap: 12px;
    }

    .room-brand img {
      width: 54px;
      height: 54px;
      object-fit: contain;
    }

    .room-brand-name {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 900;
    }


    /* =========================
       קומה
    ========================= */

    .room-floor {
      margin-bottom: 28px;

      color: rgba(236, 233, 247, .6);

      font-size: 1.25rem;
      font-weight: 500;
    }


    /* =========================
       סטטוס
    ========================= */

    .room-status {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;

      margin-bottom: 22px;

      font-family: var(--font-display);

      font-size: clamp(
        4.5rem,
        10vw,
        9rem
      );

      font-weight: 900;

      line-height: 1;
    }

    .status-dot {
      width: 28px;
      height: 28px;

      flex-shrink: 0;

      border-radius: 50%;
    }


    /* פנוי */

    .room-screen.free .room-status {
      color: var(--moss);
    }

    .room-screen.free .status-dot {
      background: var(--moss);

      box-shadow:
        0 0 18px rgba(61, 218, 215, .8),
        0 0 50px rgba(61, 218, 215, .4);
    }


    /* תפוס */

    .room-screen.busy .room-status {
      color: var(--gold-light);
    }

    .room-screen.busy .status-dot {
      background: var(--gold);

      box-shadow:
        0 0 18px rgba(242, 193, 78, .8),
        0 0 50px rgba(242, 193, 78, .4);
    }


    /* =========================
       עד שעה
    ========================= */

    .room-until {
      font-family: var(--font-display);

      font-size: clamp(
        2rem,
        4vw,
        3.8rem
      );

      font-weight: 600;

      color: var(--cream);
    }


    /* =========================
       שעון
    ========================= */

    .room-clock {
      position: absolute;

      bottom: 38px;
      left: 45px;

      direction: ltr;

      color: rgba(236, 233, 247, .5);

      font-size: 1.1rem;
    }


    /* =========================
       טעינה / שגיאה
    ========================= */

    .room-screen.loading .room-status {
      color: rgba(236, 233, 247, .5);
    }

    .room-screen.loading .status-dot {
      background: rgba(236, 233, 247, .4);
      box-shadow: none;
    }

    .room-screen.error .room-status {
      font-size: clamp(
        2.5rem,
        5vw,
        5rem
      );

      color: var(--cream);
    }

    .room-screen.error .status-dot {
      display: none;
    }


    /* =========================
       מסכים קטנים
    ========================= */

    @media (max-width: 700px) {

      .room-brand {
        top: 25px;
      }

      .room-brand img {
        width: 42px;
        height: 42px;
      }

      .room-brand-name {
        font-size: 1.1rem;
      }

      .room-status {
        gap: 12px;
      }

      .status-dot {
        width: 18px;
        height: 18px;
      }

      .room-clock {
        bottom: 20px;
        left: 20px;
      }

    }
  </style>
</head>


<body>

  <main
    id="roomScreen"
    class="room-screen loading"
  >

    <!-- לוגו -->

    <div class="room-brand">

      <img
        src="/images/Asset 11.svg"
        alt="AlonSpace"
      >

      <span class="room-brand-name">
        AlonSpace
      </span>

    </div>


    <!-- קומה -->

    <div class="room-floor">
      חדר ישיבות · קומה <%= floor %>
    </div>


    <!-- סטטוס -->

    <div class="room-status">

      <span class="status-dot"></span>

      <span id="statusText">
        טוען...
      </span>

    </div>


    <!-- עד שעה -->

    <div
      id="untilText"
      class="room-until"
    ></div>


    <!-- שעון -->

    <div
      id="clock"
      class="room-clock"
    ></div>

  </main>


<script>

  const floor = <%- JSON.stringify(floor) %>;

  const roomScreen =
    document.getElementById(
      'roomScreen'
    );

  const statusText =
    document.getElementById(
      'statusText'
    );

  const untilText =
    document.getElementById(
      'untilText'
    );

  const clock =
    document.getElementById(
      'clock'
    );


  // ========================================
  // שעון
  // ========================================

  function updateClock() {

    const now = new Date();

    clock.textContent =
      now.toLocaleTimeString(
        'he-IL',
        {
          hour: '2-digit',
          minute: '2-digit',
          timeZone: 'Asia/Jerusalem'
        }
      );

  }


  // ========================================
  // עדכון המסך
  // ========================================

  async function updateRoomStatus() {

    try {

      const response =
        await fetch(
          `/api/meeting-room-display/${floor}`,
          {
            cache: 'no-store'
          }
        );


      if (!response.ok) {
        throw new Error(
          'Failed to load room status'
        );
      }


      const data =
        await response.json();


      // =====================
      // פנוי
      // =====================

      if (data.status === 'free') {

        roomScreen.className =
          'room-screen free';

        statusText.textContent =
          'פנוי';


        if (data.until) {

          untilText.textContent =
            `עד ${data.until}`;

        } else {

          untilText.textContent =
            'להמשך היום';

        }

        return;
      }


      // =====================
      // תפוס
      // =====================

      if (data.status === 'busy') {

        roomScreen.className =
          'room-screen busy';

        statusText.textContent =
          'תפוס';

        untilText.textContent =
          data.until
            ? `עד ${data.until}`
            : '';

        return;
      }


      throw new Error(
        'Unknown room status'
      );

    }

    catch (error) {

      console.error(
        'ROOM DISPLAY ERROR:',
        error
      );

      roomScreen.className =
        'room-screen error';

      statusText.textContent =
        'לא ניתן לטעון את מצב החדר';

      untilText.textContent =
        '';

    }

  }


  // ========================================
  // התחלה
  // ========================================

  updateClock();
  updateRoomStatus();


  // השעון מתעדכן כל שנייה

  setInterval(
    updateClock,
    1000
  );


  // מצב החדר נבדק כל 15 שניות

  setInterval(
    updateRoomStatus,
    15000
  );

</script>

</body>

</html>