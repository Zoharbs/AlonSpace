<%- include('partials/head', { title }) %>
<%- include('partials/header') %>

<section class="page-hero">
  <%- include('partials/rings') %>
  <div class="container" style="position:relative; z-index:2;">
    <div class="breadcrumb"><a href="/">דף הבית</a> / גלריה</div>
    <span class="eyebrow">גלריית ההשראה שלנו</span>
    <h1>המתחם, בדיוק כמו שהוא</h1>
<p>הצצנו למשרדים, תיעדנו את חדרי הישיבות, אזור הלאונג', המטבחון וחדר הכושר- מקצועי, מודרני, פרטי.</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="gallery-grid">
      <% gallery.forEach(g => { %>
        <figure data-full="<%= g.url %>">
          <img src="<%= g.url %>" alt="<%= g.alt %>" loading="lazy">
        </figure>
      <% }) %>
    </div>
  </div>
</section>

<div class="lightbox" id="lightbox">

  <button
    class="lightbox-close"
    id="lightboxClose"
    aria-label="סגירה"
  >
    &times;
  </button>

  <button
    class="lightbox-nav lightbox-prev"
    id="lightboxPrev"
    type="button"
    aria-label="התמונה הקודמת"
  >
    &#10094;
  </button>

  <img
    id="lightboxImg"
    src=""
    alt=""
    draggable="false"
  >

  <button
    class="lightbox-nav lightbox-next"
    id="lightboxNext"
    type="button"
    aria-label="התמונה הבאה"
  >
    &#10095;
  </button>

</div>

<section class="section-dark text-center">
  <div class="container">
    <h2>מה שרואים בתמונה, מרגישים במציאות</h2>
    <div class="hero-actions" style="justify-content:center;">
      <a href="/booking" class="btn btn-gold">קביעת סיור</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
<script>
  const galleryFigures =
    Array.from(
      document.querySelectorAll(
        '.gallery-grid figure'
      )
    );

  const lightbox =
    document.getElementById('lightbox');

  const lightboxImg =
    document.getElementById('lightboxImg');

  const lightboxClose =
    document.getElementById('lightboxClose');

  const lightboxPrev =
    document.getElementById('lightboxPrev');

  const lightboxNext =
    document.getElementById('lightboxNext');


  let currentGalleryIndex = 0;

  let touchStartX = 0;
  let touchEndX = 0;


  function showGalleryImage(index) {

    if (!galleryFigures.length) {
      return;
    }


    /*
      אם הגענו אחרי התמונה האחרונה,
      חוזרים לראשונה.
    */

    if (index >= galleryFigures.length) {
      index = 0;
    }


    /*
      אם חזרנו אחורה מהראשונה,
      עוברים לאחרונה.
    */

    if (index < 0) {
      index =
        galleryFigures.length - 1;
    }


    currentGalleryIndex = index;


    const figure =
      galleryFigures[
        currentGalleryIndex
      ];

    const image =
      figure.querySelector('img');


    lightboxImg.src =
      figure.dataset.full;

    lightboxImg.alt =
      image?.alt || '';
  }


  function openLightbox(index) {

    showGalleryImage(index);

    lightbox.classList.add('open');

    document.body.style.overflow =
      'hidden';
  }


  function closeLightbox() {

    lightbox.classList.remove('open');

    document.body.style.overflow = '';
  }


  function showNextImage() {
    showGalleryImage(
      currentGalleryIndex + 1
    );
  }


  function showPreviousImage() {
    showGalleryImage(
      currentGalleryIndex - 1
    );
  }


  /* פתיחת תמונה */

  galleryFigures.forEach(
    (figure, index) => {

      figure.addEventListener(
        'click',
        () => {
          openLightbox(index);
        }
      );

    }
  );


  /* כפתור סגירה */

  lightboxClose
    ?.addEventListener(
      'click',
      closeLightbox
    );


  /* חצים */

  lightboxNext
    ?.addEventListener(
      'click',
      (event) => {

        event.stopPropagation();

        showNextImage();
      }
    );


  lightboxPrev
    ?.addEventListener(
      'click',
      (event) => {

        event.stopPropagation();

        showPreviousImage();
      }
    );


  /* לחיצה על הרקע */

  lightbox
    ?.addEventListener(
      'click',
      (event) => {

        if (event.target === lightbox) {
          closeLightbox();
        }

      }
    );


  /* מקלדת */

  document.addEventListener(
    'keydown',
    (event) => {

      if (
        !lightbox.classList.contains('open')
      ) {
        return;
      }


      if (event.key === 'Escape') {
        closeLightbox();
      }


      if (event.key === 'ArrowRight') {
        showNextImage();
      }


      if (event.key === 'ArrowLeft') {
        showPreviousImage();
      }

    }
  );


  /* =====================================
     MOBILE SWIPE
  ===================================== */

  lightboxImg
    ?.addEventListener(
      'touchstart',
      (event) => {

        touchStartX =
          event.changedTouches[0]
            .screenX;

      },
      {
        passive: true
      }
    );


  lightboxImg
    ?.addEventListener(
      'touchend',
      (event) => {

        touchEndX =
          event.changedTouches[0]
            .screenX;


        const difference =
          touchEndX - touchStartX;


        /*
          תנועה קטנה מדי =
          לא נחשיב אותה כ-swipe.
        */

        if (
          Math.abs(difference) < 50
        ) {
          return;
        }


        if (difference < 0) {

          showNextImage();

        } else {

          showPreviousImage();

        }

      },
      {
        passive: true
      }
    );
</script>
