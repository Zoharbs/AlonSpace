<%- include('partials/head', { title }) %>
  <%- include('partials/header') %>
<style>
  /* =====================================
     MEET THE PEOPLE OF ALONSPACE
  ===================================== */

  .people-section {
    padding: 64px 0;
  }

  .people-section-head {
    margin-bottom: 32px;
    text-align: center;
  }

  .people-section-head h2 {
    margin: 6px 0 8px;
  }

  .people-section-head p {
    max-width: 600px;
    margin: 0 auto;

    color: var(--ink-soft);
    line-height: 1.6;
  }


  /* =====================================
     PROFILE GRID
  ===================================== */

  .people-business-grid {
    display: grid;

    grid-template-columns:
      repeat(auto-fit, minmax(320px, 440px));

    justify-content: center;

    gap: 18px;

    max-width: 920px;
    margin: 0 auto;
  }


  /* =====================================
     PROFILE CARD
  ===================================== */

  .people-profile-card {
    width: 100%;

    box-sizing: border-box;

    padding: 24px;

    background: var(--cream);

    border: 1px solid var(--stone-dark);
    border-radius: 22px;

    box-shadow:
      0 8px 28px rgba(25, 20, 15, .06);

    color: var(--ink);

    direction: rtl;
  }


  /* HEADER */

  .people-profile-head {
    display: flex;
    align-items: center;

    gap: 14px;

    margin-bottom: 18px;
  }

  .people-profile-logo {
    width: 58px;
    height: 58px;

    flex: 0 0 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background: #fff;

    border: 1px solid var(--stone-dark);
    border-radius: 14px;
  }

  .people-profile-logo img {
    display: block;

    width: 100%;
    height: 100%;

    box-sizing: border-box;

    object-fit: contain;

    padding: 6px;
  }

  .people-profile-title {
    min-width: 0;
  }

  .people-profile-title h3 {
    margin: 0 0 5px;

    color: var(--ink);

    font-size: 1.15rem;
    line-height: 1.4;
  }

  .people-profile-title span {
    display: block;

    color: var(--oak-dark);

    font-size: .8rem;
    font-weight: 700;
  }


  /* BIO */

  .people-profile-bio {
    margin: 0;

    color: var(--ink-soft);

    font-size: .92rem;
    line-height: 1.75;
  }


  /* LINKS */

  .people-profile-links {
    display: flex;
    flex-wrap: wrap;

    gap: 9px;

    margin-top: 20px;
    padding-top: 16px;

    border-top: 1px solid var(--stone-dark);
  }

  .people-profile-links .btn {
    min-width: 0;
  }


  /* MOBILE */

  @media (max-width: 700px) {

    .people-section {
      padding: 46px 0;
    }

    .people-section-head {
      margin-bottom: 24px;
    }

    .people-business-grid {
      grid-template-columns: 1fr;

      gap: 14px;
    }

    .people-profile-card {
      padding: 20px;
    }

  }
.people-person-name {
  margin: 3px 0 5px;

  color: var(--ink-soft);

  font-size: .9rem;
  font-weight: 600;
}
/* =====================================
   COMPACT PUBLIC BUSINESS CARDS
===================================== */

@media (min-width: 701px) {

  .people-business-grid {
    grid-template-columns:
      repeat(auto-fit, minmax(280px, 360px));

    max-width: 760px;

    gap: 16px;
  }

}


.people-profile-card {
  padding: 18px;
}


.people-profile-head {
  margin-bottom: 12px;
}


.people-profile-bio {
  font-size: .88rem;
  line-height: 1.6;
}


.people-profile-links {
  gap: 7px;

  margin-top: 14px;
  padding-top: 12px;
}


.people-profile-links .btn {
  min-width: 0;

  padding: 7px 12px;

  font-size: .78rem;
}
/* =====================================
   SMART PEOPLE CAROUSEL
===================================== */

.people-carousel-viewport {
  width: 100%;
  max-width: 1200px;

  margin: 0 auto;

  overflow: hidden;
}


.people-carousel-viewport
.people-business-grid {
  display: flex;

  flex-wrap: nowrap;

  justify-content: center;

  gap: 16px;

  max-width: none;
  margin: 0 auto;
}


.people-carousel-viewport
.people-profile-card {
  flex: 0 0 280px;

  width: 280px;

  min-width: 0;

  direction: rtl;
}


/* רק כשבאמת אין מקום */

.people-carousel-viewport.is-overflowing
.people-business-grid {
  justify-content: flex-start;

  width: max-content;

  margin: 0;

  direction: ltr;

  will-change: transform;
}


.people-carousel-viewport.is-overflowing
.people-profile-card {
  direction: rtl;
}


/* MOBILE */

@media (max-width: 700px) {

  .people-carousel-viewport
  .people-profile-card {
    flex: 0 0 min(82vw, 330px);

    width: min(82vw, 330px);
  }

}
</style>
