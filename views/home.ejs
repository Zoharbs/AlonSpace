<script>
  /* =====================================
     HERO SLIDESHOW
  ===================================== */

  const heroSlides =
    document.querySelectorAll(
      '#heroSlideshow .hero-slide'
    );

  let heroSlideIndex = 0;


  function showNextHeroSlide() {

    if (heroSlides.length < 2) {
      return;
    }


    heroSlides[
      heroSlideIndex
    ].classList.remove('active');


    heroSlideIndex =
      (heroSlideIndex + 1) %
      heroSlides.length;


    heroSlides[
      heroSlideIndex
    ].classList.add('active');
  }
/* =====================================
   SMART INFINITE PEOPLE CAROUSEL
===================================== */

const peopleViewport =
  document.getElementById(
    'peopleCarouselViewport'
  );

const peopleTrack =
  document.getElementById(
    'peopleBusinessGrid'
  );


if (
  peopleViewport &&
  peopleTrack
) {

  const originalCards =
    Array.from(
      peopleTrack.querySelectorAll(
        '.people-profile-card'
      )
    );


  let animationFrame = null;
  let previousTime = null;
  let position = 0;
  let loopWidth = 0;


  const speed = 14;


  function getGap() {

    const styles =
      window.getComputedStyle(
        peopleTrack
      );

    return (
      parseFloat(styles.columnGap) ||
      parseFloat(styles.gap) ||
      0
    );

  }


  function getOriginalWidth() {

    const gap =
      getGap();


    const cardsWidth =
      originalCards.reduce(
        (total, card) => {

          return (
            total +
            card.getBoundingClientRect().width
          );

        },
        0
      );


    return (
      cardsWidth +
      gap *
        Math.max(
          0,
          originalCards.length - 1
        )
    );

  }


  function removeClones() {

    peopleTrack
      .querySelectorAll(
        '[data-people-clone="true"]'
      )
      .forEach((clone) => {
        clone.remove();
      });

  }


  function stopCarousel() {

    if (animationFrame) {

      cancelAnimationFrame(
        animationFrame
      );

      animationFrame = null;

    }


    previousTime = null;
    position = 0;


    peopleTrack.style.transform =
      'none';

  }


  function createClones() {

    removeClones();


    /*
      We duplicate complete sequences
      until there is always another set
      waiting outside the viewport.
    */

    const requiredWidth =
      peopleViewport.clientWidth +
      loopWidth;


    let currentWidth =
      loopWidth;


    while (
      currentWidth <
      requiredWidth
    ) {

      originalCards.forEach(
        (card) => {

          const clone =
            card.cloneNode(true);


          clone.dataset.peopleClone =
            'true';


          clone.setAttribute(
            'aria-hidden',
            'true'
          );


          peopleTrack.appendChild(
            clone
          );

        }
      );


      currentWidth +=
        loopWidth;

    }

  }


  function animateCarousel(time) {

    if (previousTime === null) {
      previousTime = time;
    }


    const delta =
      Math.min(
        (time - previousTime) / 1000,
        0.05
      );


    previousTime = time;


    position +=
      speed * delta;


    if (
      position >= loopWidth
    ) {

      position -=
        loopWidth;

    }


    peopleTrack.style.transform =
      `translate3d(
        -${position}px,
        0,
        0
      )`;


    animationFrame =
      requestAnimationFrame(
        animateCarousel
      );

  }


  function setupPeopleCarousel() {

    stopCarousel();
    removeClones();


    peopleViewport.classList.remove(
      'is-overflowing'
    );


    /*
      Measure how much space the original
      cards actually need.
    */

    const originalWidth =
      getOriginalWidth();


    const availableWidth =
      peopleViewport.clientWidth;


    /*
      Everything fits:
      keep all cards visible and static.
    */

    if (
      originalWidth <=
      availableWidth
    ) {

      return;

    }


    /*
      Not enough room:
      turn it into the infinite conveyor.
    */

    peopleViewport.classList.add(
      'is-overflowing'
    );


    const gap =
      getGap();


    loopWidth =
      originalWidth + gap;


    createClones();


    position = 0;
    previousTime = null;


    animationFrame =
      requestAnimationFrame(
        animateCarousel
      );

  }


  setupPeopleCarousel();


  let peopleResizeTimer;


  window.addEventListener(
    'resize',
    () => {

      clearTimeout(
        peopleResizeTimer
      );


      peopleResizeTimer =
        setTimeout(
          setupPeopleCarousel,
          150
        );

    }
  );

}
</script>