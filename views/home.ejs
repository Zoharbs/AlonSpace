<style>
  /* =====================================
     MEET THE PEOPLE OF ALONSPACE
  ===================================== */

  .people-section {
    padding: 64px 0;
  }

  .people-section-head {
    margin-bottom: 30px;
    text-align: center;
  }

  .people-section-head h2 {
    margin: 6px 0 8px;
  }

  .people-section-head p {
    max-width: 600px;
    margin: 0 auto;

    color: var(--ink-soft);
    line-height: 1.6;
  }


  /* =====================================
     BUSINESS GRID
  ===================================== */

  .people-business-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;

    gap: 16px;

    max-width: 820px;
    margin: 0 auto;
  }


  /* =====================================
     BUSINESS CARD
  ===================================== */

  .people-business {
    width: 330px;
    min-height: 94px;

    display: flex;
    align-items: center;

    gap: 14px;

    padding: 16px 18px;

    box-sizing: border-box;

    background: var(--cream);

    border: 1px solid var(--stone-dark);
    border-radius: 18px;

    box-shadow:
      0 6px 20px rgba(25, 20, 15, .045);

    color: var(--ink);

    direction: rtl;

    cursor: pointer;

    font: inherit;
    text-align: right;

    transition:
      transform .16s ease,
      border-color .16s ease,
      box-shadow .16s ease;
  }

  .people-business:hover {
    transform: translateY(-2px);

    border-color: var(--oak);

    box-shadow:
      0 10px 26px rgba(25, 20, 15, .08);
  }


  /* =====================================
     BUSINESS LOGO
  ===================================== */

  .people-business-logo {
    width: 58px;
    height: 58px;

    flex: 0 0 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background: #fff;

    border: 1px solid var(--stone-dark);
    border-radius: 14px;
  }

  .people-business-logo img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;

    box-sizing: border-box;

    padding: 6px;
  }


  /* =====================================
     BUSINESS INFO
  ===================================== */

  .people-business-copy {
    min-width: 0;
    flex: 1;
  }

  .people-business-copy strong {
    display: block;

    margin-bottom: 4px;

    color: var(--ink);

    font-size: .95rem;
    font-weight: 800;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .people-business-copy span {
    display: block;

    color: var(--oak-dark);

    font-size: .78rem;
    font-weight: 600;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }


  /* =====================================
     PROFILE DIALOG
  ===================================== */

  .public-profile-dialog {
    width: min(440px, calc(100% - 32px));

    padding: 0;

    border: 0;
    border-radius: 22px;

    background: var(--cream);

    box-shadow:
      0 24px 70px rgba(0, 0, 0, .24);

    color: var(--ink);

    direction: rtl;
  }

  .public-profile-dialog::backdrop {
    background: rgba(10, 12, 26, .58);
    backdrop-filter: blur(4px);
  }

  .public-profile-dialog-inner {
    position: relative;

    padding: 26px;
  }


  /* CLOSE */

  .public-profile-dialog-close {
    position: absolute;

    top: 16px;
    left: 16px;

    width: 32px;
    height: 32px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 0;
    border-radius: 50%;

    background: transparent;

    color: var(--ink-soft);

    font-size: 1.35rem;
    line-height: 1;

    cursor: pointer;

    transition:
      background .15s ease,
      color .15s ease;
  }

  .public-profile-dialog-close:hover {
    background: var(--stone);
    color: var(--ink);
  }


  /* DIALOG HEADER */

  .public-profile-dialog-head {
    display: flex;
    align-items: center;

    gap: 14px;

    min-height: 58px;

    padding-left: 42px;

    margin-bottom: 18px;
  }

  .public-profile-dialog-logo {
    width: 58px;
    height: 58px;

    flex: 0 0 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background: #fff;

    border: 1px solid var(--stone-dark);
    border-radius: 14px;
  }

  .public-profile-dialog-logo img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;

    box-sizing: border-box;

    padding: 6px;
  }

  .public-profile-dialog h3 {
    margin: 0 0 5px;

    font-size: 1.2rem;
    line-height: 1.35;
  }

  .public-profile-dialog-field {
    display: block;

    color: var(--oak-dark);

    font-size: .8rem;
    font-weight: 700;
  }


  /* DIALOG CONTENT */

  .public-profile-dialog-bio {
    margin: 0;

    color: var(--ink-soft);

    font-size: .92rem;
    line-height: 1.75;
  }

  .public-profile-dialog-links {
    display: flex;
    flex-wrap: wrap;

    gap: 9px;

    margin-top: 20px;
    padding-top: 16px;

    border-top: 1px solid var(--stone-dark);
  }

  .public-profile-dialog-links .btn {
    min-width: 0;
  }


  /* =====================================
     MOBILE
  ===================================== */

  @media (max-width: 700px) {

    .people-section {
      padding: 46px 0;
    }

    .people-section-head {
      margin-bottom: 24px;
    }

    .people-business-grid {
      display: grid;
      grid-template-columns: 1fr;

      gap: 12px;

      max-width: 100%;
    }

    .people-business {
      width: 100%;
      min-height: 90px;

      padding: 14px 16px;
    }

    .people-business-logo {
      width: 54px;
      height: 54px;

      flex-basis: 54px;
    }

    .public-profile-dialog {
      width: calc(100% - 28px);
    }

    .public-profile-dialog-inner {
      padding: 22px;
    }

  }
</style>
