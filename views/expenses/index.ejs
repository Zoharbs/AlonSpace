<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#142b46"><link rel="manifest" href="/expenses/manifest.webmanifest">
<title>ניהול הוצאות | AlonSpace</title>
<style>
body{font-family:Arial,sans-serif;background:#f4f6f9;color:#142b46;margin:0;padding:16px}main{max-width:1500px;margin:auto}section{background:white;border-radius:14px;padding:18px;margin:16px 0}input,select,button{padding:8px;border:1px solid #cdd4de;border-radius:7px}button{background:#142b46;color:white;cursor:pointer}table{border-collapse:collapse;width:100%;min-width:1150px}th,td{border:1px solid #dfe5ec;padding:8px;text-align:center}th:first-child,td:first-child{position:sticky;right:0;background:white;min-width:170px;text-align:right}.scroll{overflow:auto}.estimate{background:#fff2bd}.paid{background:#d4f4dc}.muted{color:#6d7581}.forms{display:flex;flex-wrap:wrap;gap:12px;align-items:end}label{display:flex;flex-direction:column;gap:4px}h1{margin-bottom:8px}small{display:block}.inline{display:inline-flex;gap:8px;align-items:center;margin:6px 0}.notice{padding:10px;border-radius:8px;background:#e8eef6}.error{background:#ffe5e5}
</style>
</head>
<body><main>
<h1>AlonSpace — ניהול הוצאות</h1><p>מחובר: <%= user.display_name %></p>
<form method="get" action="/expenses" class="forms"><label>קומה<select name="floor"><option value="4" <%= floor===4?'selected':'' %>>קומה 4</option><option value="6" <%= floor===6?'selected':'' %>>קומה 6</option></select></label><label>שנה<input type="number" name="year" min="2020" max="2100" value="<%= year %>"></label><button>הצגה</button><a href="/expenses/export.xlsx?floor=<%= floor %>&year=<%= year %>">ייצוא Excel</a></form>
<% if(error){ %><p role="alert" class="notice error"><%= error %></p><% } %>
<% if(success){ %><p class="notice"><%= success %></p><% } %>
<section><h2>טבלת הוצאות — קומה <%= floor %></h2><div class="scroll"><table><thead><tr><th>קטגוריה</th><% months.forEach(function(m){ %><th><%= m.slice(5) %></th><% }) %></tr></thead><tbody>
<% categories.forEach(function(c){ %><tr><td><strong><%= c.name %></strong><small class="muted">ברירת מחדל: ₪<%= Number(c.default_amount).toFixed(2) %></small></td>
<% months.forEach(function(m){ const e=entryMap[c.id+':'+m]; const paid=e&&e.status==='paid'; const amount=paid?e.actual_amount:e?e.estimated_amount:c.default_amount; %>
<td class="<%= paid?'paid':'estimate' %>"><strong>₪<%= Number(amount||0).toFixed(2) %></strong><small><%= paid?'שולם':'הערכה' %></small>
<% if(!paid && !e?.payment_id){ %>
<form method="post" action="/expenses/estimate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="category_id" value="<%= c.id %>"><input type="hidden" name="month" value="<%= m %>"><input type="number" name="amount" step="0.01" min="0" value="<%= Number(amount||0).toFixed(2) %>" style="width:90px" aria-label="הערכה עבור <%= c.name %> <%= m %>"><button>שמור</button></form>
<% if(e){ %><form method="post" action="/expenses/finalize"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="entry_id" value="<%= e.id %>"><input type="number" name="actual_amount" step="0.01" min="0" required style="width:90px" placeholder="סכום סופי"><button>סגור</button></form><% } %>
<% } %></td><% }) %></tr><% }) %>
</tbody></table></div></section>
<section><h2>חשבונות ממתינים לתשלום</h2>
<% if(!pendingPayments.length){ %><p class="muted">אין חשבונות ממתינים לתשלום בשנה זו.</p><% } %>
<% pendingPayments.forEach(function(p){ %><form class="inline" method="post" action="/expenses/finalize-payment"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="payment_id" value="<%= p.id %>"><strong><%= p.name %> — ₪<%= Number(p.total_amount).toFixed(2) %></strong><label>תאריך תשלום<input type="date" name="payment_date" required></label><button>סמן כשולם</button></form><% }) %>
</section>
<section><h2>קטגוריה חדשה / עדכון ברירת מחדל</h2><form class="forms" method="post" action="/expenses/categories"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="floor" value="<%= floor %>"><label>שם<input name="name" required maxlength="100"></label><label>סכום חודשי<input type="number" name="default_amount" step="0.01" min="0" required></label><button>שמירה</button></form><p class="muted">קטגוריות חשמל וארנונה מוגדרות במסד הנתונים עם סוג מיוחד.</p></section>
<section><h2>קליטת חשבון / תשלום</h2><form class="forms" method="post" action="/expenses/payment"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>קטגוריה<select name="category_id" id="category" required><% categories.forEach(function(c){ %><option value="<%= c.id %>" data-kind="<%= c.kind %>"><%= c.name %></option><% }) %></select></label><label>סכום כולל<input name="amount" type="number" step="0.01" min="0.01" required></label><label>מצב<select name="status" id="payment-status"><option value="estimated">הערכה</option><option value="paid">שולם</option></select></label><label class="payment-date">תאריך תשלום<input type="date" name="payment_date"></label><label class="regular">חודש<input type="month" name="month" value="<%= year %>-01"></label><label class="electricity">תחילת צריכה<input type="date" name="period_start"></label><label class="electricity">סיום צריכה<input type="date" name="period_end"></label><label class="arnona">חודשי ארנונה (YYYY-MM, מופרדים בפסיק)<input name="months" placeholder="2026-01,2026-02"></label><button>קליטת חשבון</button></form></section>
</main>
<script>
const sel=document.querySelector('#category');const statusSel=document.querySelector('#payment-status');
function refresh(){const kind=sel.selectedOptions[0]?.dataset.kind;document.querySelectorAll('.regular,.electricity,.arnona').forEach(el=>{el.style.display=el.classList.contains(kind==='electricity'?'electricity':kind==='arnona'?'arnona':'regular')?'flex':'none'});document.querySelector('.payment-date').style.display=statusSel.value==='paid'?'flex':'none';}
sel.addEventListener('change',refresh);statusSel.addEventListener('change',refresh);refresh();
if('serviceWorker' in navigator)navigator.serviceWorker.register('/expenses/sw.js',{scope:'/expenses'}).catch(()=>{});
</script>
</body></html>
