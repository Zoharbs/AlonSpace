<!doctype html><html lang="he" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>היסטוריית הוצאות | AlonSpace</title><style>body{font-family:Arial,sans-serif;background:#f4f6f9;color:#142b46;margin:24px}main{max-width:1100px;margin:auto}section{background:white;border-radius:14px;padding:18px;margin:16px 0}table{border-collapse:collapse;width:100%}th,td{border:1px solid #dce3ea;padding:9px;text-align:right}button{padding:8px;background:#8b2525;color:white;border:0;border-radius:6px;cursor:pointer}.scroll{overflow:auto}a{color:#142b46}</style></head><body><main><h1>היסטוריית הוצאות — קומה <%= floor %></h1><p><a href="/expenses">חזרה להוצאות</a> · <a href="/expenses/extras/overview?year=<%= year %>">סיכום שתי הקומות</a></p><form method="get"><label>קומה <select name="floor"><option value="4" <%= floor===4?'selected':'' %>>4</option><option value="6" <%= floor===6?'selected':'' %>>6</option></select></label><label>שנה <input type="number" name="year" value="<%= year %>" min="2020" max="2100"></label><button type="submit" style="background:#142b46">הצג</button></form><% if(error){ %><p role="alert"><%= error %></p><% } %><% if(success){ %><p><%= success %></p><% } %><section><h2>חשבונות</h2><div class="scroll"><table><thead><tr><th>קטגוריה</th><th>חודשים</th><th>סכום</th><th>מצב</th><th>תאריך תשלום</th><th>פעולה</th></tr></thead><tbody><% payments.forEach(function(p){ %><tr><td><%= p.category_name %></td><td><%= p.months %></td><td>₪<%= Number(p.total_amount).toFixed(2) %></td><td><%= p.cancelled_at?'בוטל':p.status==='paid'?'שולם':'הערכה' %></td><td><%= p.payment_date?new Date(p.payment_date).toLocaleDateString('he-IL'):'—' %></td><td><% if(!p.cancelled_at){ %><form method="post" action="/expenses/extras/payments/<%= p.id %>/cancel" onsubmit="return confirm('לבטל את החשבון? הערכות המקור יישמרו, ואפשר יהיה להזין חשבון מתוקן.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>בטל לצורך תיקון</button></form><% } %></td></tr><% }) %></tbody></table></div></section><section><h2>יומן שינויים (עד 500 רשומות)</h2><div class="scroll"><table><thead><tr><th>מועד</th><th>משתמש</th><th>קטגוריה</th><th>חודש</th><th>פעולה</th><th>לפני</th><th>אחרי</th></tr></thead><tbody><% history.forEach(function(h){ %><tr><td><%= new Date(h.created_at).toLocaleString('he-IL') %></td><td><%= h.changed_by||'משתמש לא ידוע' %></td><td><%= h.category_name %></td><td><%= h.month_key %></td><td><%= h.action %></td><td><%= h.old_value?JSON.stringify(h.old_value):'—' %></td><td><%= h.new_value?JSON.stringify(h.new_value):'—' %></td></tr><% }) %></tbody></table></div></section></main></body></html>
