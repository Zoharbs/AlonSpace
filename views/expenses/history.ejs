<!doctype html>
<html lang="he" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>היסטוריית הוצאות | AlonSpace</title><link rel="stylesheet" href="/css/style.css"><style>
body{margin:0;background:var(--stone);color:var(--ink);font-family:var(--font-body)}main{max-width:1360px;margin:auto;padding:28px 18px 65px}h1,h2{font-family:var(--font-display)}h1{margin:0 0 8px}.muted{color:var(--ink-soft)}.top{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:25px}.btn{display:inline-flex;align-items:center;justify-content:center;background:var(--oak);color:white;border:0;border-radius:var(--radius);padding:9px 16px;text-decoration:none;cursor:pointer;font:inherit}.btn.danger{background:#a13b3b}.panel{background:var(--cream);border:1px solid var(--stone-dark);border-radius:var(--radius-lg);box-shadow:var(--shadow);padding:22px;margin-bottom:20px}.field{border:1px solid var(--stone-dark);border-radius:var(--radius);padding:9px 12px;background:white;font:inherit}.scroll{overflow:auto}table{border-collapse:collapse;width:100%;min-width:800px}th,td{border-bottom:1px solid var(--stone-dark);padding:12px;text-align:right;vertical-align:top}th{background:var(--stone);font-family:var(--font-display)}.status{font-weight:700}.good{color:#247552}.bad{color:#a13b3b}.json{max-width:290px;white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;direction:ltr;text-align:left}.notice{background:#e5f4eb;padding:12px;border-radius:10px;margin-bottom:14px}.notice.error{background:#fcebea}@media(max-width:600px){main{padding:16px 10px}.panel{padding:14px}}
</style></head><body><main><div class="top"><div><h1>היסטוריית הוצאות — קומה <%= floor %></h1><p class="muted">חשבונות, ביטולים ויומן שינויים</p></div><a class="btn" href="/expenses?floor=<%= floor %>&year=<%= year %>">חזרה לניהול</a></div>
<% if(error){ %><div class="notice error" role="alert"><%= error %></div><% } %><% if(success){ %><div class="notice"><%= success %></div><% } %>
<form class="panel" method="get"><label>קומה <select class="field" name="floor"><option value="4" <%= floor===4?'selected':'' %>>4</option><option value="6" <%= floor===6?'selected':'' %>>6</option></select></label> <label>שנה <input class="field" type="number" name="year" value="<%= year %>" min="2020" max="2100"></label> <button class="btn" type="submit">הצג</button></form>
<section class="panel"><h2>חשבונות</h2><div class="scroll"><table><thead><tr><th>קטגוריה</th><th>חודשים</th><th>סכום לקומה</th><th>סטטוס</th><th>תאריך תשלום</th><th>פעולה</th></tr></thead><tbody><% payments.forEach(p=>{ %><tr><td><%= p.category_name %></td><td><%= p.months %></td><td>₪<%= Number(p.total_amount).toFixed(2) %></td><td class="status <%= p.cancelled_at?'bad':p.status==='paid'?'good':'' %>"><%= p.cancelled_at?'בוטל':p.status==='paid'?'שולם':'ממתין' %></td><td><%= p.payment_date?new Date(p.payment_date).toLocaleDateString('he-IL'):'—' %></td><td><% if(!p.cancelled_at){ %><form method="post" action="/expenses/extras/payments/<%= p.id %>/cancel" onsubmit="return confirm('לבטל את החשבון? בחשבון משותף יבוטלו שתי הקומות. ההערכות המקוריות יישמרו.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn danger" type="submit">ביטול לצורך תיקון</button></form><% } %></td></tr><% }) %></tbody></table></div><% if(!payments.length){ %><p class="muted">אין חשבונות בשנה זו.</p><% } %></section>
<section class="panel"><h2>יומן שינויים</h2><p class="muted">עד 500 פעולות אחרונות, כולל הערכים שנשמרו לפני ואחרי השינוי.</p><div class="scroll"><table><thead><tr><th>מועד</th><th>משתמש</th><th>קטגוריה</th><th>חודש</th><th>פעולה</th><th>לפני</th><th>אחרי</th></tr></thead><tbody><% history.forEach(h=>{ %><tr><td><%= new Date(h.created_at).toLocaleString('he-IL') %></td><td><%= h.changed_by||'לא ידוע' %></td><td><%= h.category_name %></td><td><%= h.month_key %></td><td><%= ({estimate:'עדכון הערכה',payment:'קליטת חשבון',finalize:'סימון כשולם',finalize_payment:'סגירת חשבון',cancel_payment:'ביטול חשבון'})[h.action]||h.action %></td><td><details><summary>הצג</summary><pre class="json"><%= h.old_value?JSON.stringify(h.old_value,null,2):'—' %></pre></details></td><td><details><summary>הצג</summary><pre class="json"><%= h.new_value?JSON.stringify(h.new_value,null,2):'—' %></pre></details></td></tr><% }) %></tbody></table></div></section>
</main></body></html>
