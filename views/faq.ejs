<%- include('partials/head', { title }) %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="container" style="position:relative; z-index:2;">
    <div class="breadcrumb"><a href="/">דף הבית</a> / שאלות נפוצות</div>
    <span class="eyebrow">שאלות נפוצות</span>
    <h1>תשובות לשאלות החשובות באמת </h1>
    <p>חפשו לפי נושא או עברו על השאלות המרכזיות לגבי המשרדים, המתחם והסיור.</p>
  </div>
</section>

<section>
  <div class="container" style="max-width:860px;">
    <input
      id="faqSearch"
      class="faq-search"
      type="search"
      placeholder="חפשו שאלה... לדוגמה: סיור, אינטרנט, חוזה"
      autocomplete="off"
    />

    <div class="faq-list" id="faqList">
      <div class="faq-item" data-faq="סיור ביקור לראות מתחם">
        <button class="faq-q"><span>איך אפשר להגיע לראות את המתחם?</span><span class="plus"></span></button>
        <div class="faq-a"><div class="faq-a-inner">ניתן לתאם סיור דרך עמוד <a href="/booking" style="text-decoration:underline;">קביעת סיור</a>, בטלפון או בוואטסאפ.</div></div>
      </div>

      <div class="faq-item" data-faq="חדר ישיבות פגישות לקוחות">
        <button class="faq-q"><span>האם יש חדר ישיבות?</span><span class="plus"></span></button>
        <div class="faq-a"><div class="faq-a-inner">כן. במתחם קיים חדר ישיבות עבורכם לפגישות, מצגות וסתם שיחות עבודה.</div></div>
      </div>

      <div class="faq-item" data-faq="חוזה התחייבות השכרה חודשית גמישות">
        <button class="faq-q"><span>האם יש התחייבות ארוכת טווח?</span><span class="plus"></span></button>
        <div class="faq-a"><div class="faq-a-inner">יש מספר אפשרויות השכרה. את הפרטים המדויקים נוכל להתאים לפי הצורך והזמינות.</div></div>
      </div>

      <div class="faq-item" data-faq="אינטרנט wifi רשת">
        <button class="faq-q"><span>מה זה אומר הכל כלול?</span><span class="plus"></span></button>
        <div class="faq-a"><div class="faq-a-inner">המחיר הוא תשלום יחיד. הכולל בתוכו הכל (ארנונה,חשמל, אינטרנט,מטבחון וגם חדר הכושר)</div></div>
      </div>

      <div class="faq-item" data-faq="כתובת מיקום תל אביב מגדלי אלון יגאל אלון">
        <button class="faq-q"><span>איפה אתם נמצאים?</span><span class="plus"></span></button>
        <div class="faq-a"><div class="faq-a-inner">אלוןספייס נמצאת במגדל אלון 2, יגאל אלון 94, תל אביב.</div></div>
      </div>



    </div>

    <p id="faqEmpty" class="faq-empty">לא נמצאו שאלות מתאימות.</p>
  </div>
</section>

<section class="section-dark text-center">
  <div class="container">
    <h2>לא מצאתם תשובה לשאלה שלכם?</h2>
    <p class="hero-sub" style="margin-inline:auto;">שלחו לנו הודעה ונחזור אליכם.</p>
    <div class="hero-actions" style="justify-content:center;">
      <a href="<%= site.whatsapp %>" target="_blank" rel="noopener" class="btn btn-gold">וואטסאפ</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>