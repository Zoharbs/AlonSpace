<%- include('partials/head', { title }) %>
<%- include('partials/header') %>

<style>

  /* =====================================
     ALONSPACE COMMUNITY
  ===================================== */

  .community-page {
    padding: 54px 0 72px;
  }

  .community-page .container {
    width: calc(100% - 64px);
    max-width: 1400px;
  }


  /* HEADER */

  .community-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;

    margin-bottom: 34px;
  }

  .community-head-copy {
    max-width: 680px;
  }

  .community-head h1 {
    margin: 6px 0 10px;
  }

  .community-head p {
    margin: 0;

    color: var(--ink-soft);

    line-height: 1.65;
  }

  .community-head-actions {
    flex-shrink: 0;
  }


  /* COUNT */

  .community-count {
    display: inline-flex;
    align-items: center;

    margin-top: 16px;
    padding: 6px 11px;

    background: var(--stone);

    border-radius: 999px;

    color: var(--ink-soft);

    font-size: .78rem;
    font-weight: 700;
  }


  /* GRID */

  .community-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 18px;
  }


  /* CARD */

  .community-card {
    display: flex;
    flex-direction: column;

    min-width: 0;
    min-height: 260px;

    padding: 22px;

    background: var(--cream);

    border: 1px solid var(--stone-dark);
    border-radius: 22px;

    box-shadow: var(--shadow);

    transition:
      transform .18s ease,
      box-shadow .18s ease,
      border-color .18s ease;
  }

  .community-card:hover {
    transform: translateY(-2px);

    border-color:
      rgba(90, 75, 55, .28);

    box-shadow:
      0 14px 34px rgba(25, 20, 15, .09);
  }


  /* CARD TOP */

  .community-card-top {
    display: flex;
    align-items: center;

    gap: 15px;

    margin-bottom: 17px;
  }


  /* LOGO */

  .community-logo {
    width: 68px;
    height: 68px;

    flex: 0 0 68px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background: #fff;

    border: 1px solid var(--stone-dark);
    border-radius: 17px;
  }

  .community-logo img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;

    box-sizing: border-box;

    padding: 7px;
  }

  .community-logo-placeholder {
    font-size: 1.65rem;
  }


  /* NAME */

  .community-card-title {
    min-width: 0;
  }

  .community-card-title h2 {
    margin: 0 0 4px;

    font-size: 1.08rem;

    overflow-wrap: anywhere;
  }

  .community-field {
    display: block;

    color: var(--oak-dark);

    font-size: .8rem;
    font-weight: 700;

    line-height: 1.4;
  }


  /* BIO */

  .community-bio {
    flex: 1;

    margin: 0 0 18px;

    color: var(--ink-soft);

    font-size: .9rem;
    line-height: 1.65;
  }

  .community-no-bio {
    opacity: .7;
  }


  /* LINKS */

  .community-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 8px;

    padding-top: 15px;

    border-top: 1px solid var(--stone-dark);
  }

  .community-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 7px 11px;

    border: 1px solid var(--stone-dark);
    border-radius: 10px;

    color: var(--ink);

    font-size: .77rem;
    font-weight: 700;

    text-decoration: none;

    transition:
      background .15s ease,
      border-color .15s ease;
  }

  .community-link:hover {
    background: var(--stone);

    border-color: var(--oak);
  }


  /* OWN PROFILE */

  .community-own-profile {
    margin-right: auto;

    color: var(--ink-soft);

    font-size: .72rem;
    font-weight: 700;
  }


  /* EMPTY STATE */

  .community-empty {
    padding: 60px 30px;

    background: var(--cream);

    border: 1px solid var(--stone-dark);
    border-radius: 24px;

    box-shadow: var(--shadow);

    text-align: center;
  }

  .community-empty-icon {
    width: 64px;
    height: 64px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin: 0 auto 16px;

    background: var(--stone);

    border-radius: 50%;

    font-size: 1.7rem;
  }

  .community-empty h2 {
    margin: 0 0 8px;
  }

  .community-empty p {
    max-width: 480px;

    margin: 0 auto 20px;

    color: var(--ink-soft);

    line-height: 1.6;
  }


  /* MOBILE */

  @media (max-width: 1000px) {

    .community-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

  }


  @media (max-width: 700px) {

    .community-page {
      padding: 34px 0 50px;
    }

    .community-page .container {
      width: calc(100% - 28px);
    }

    .community-head {
      align-items: stretch;
      flex-direction: column;

      gap: 20px;

      margin-bottom: 24px;
    }

    .community-head-actions .btn {
      width: 100%;

      box-sizing: border-box;

      text-align: center;
    }

    .community-grid {
      grid-template-columns: 1fr;
    }

    .community-card {
      min-height: 0;
    }

  }

</style>


<main>

  <section class="community-page">

    <div class="container">


      <!-- HEADER -->

      <div class="community-head">

        <div class="community-head-copy">

          <span class="eyebrow">
            קהילת AlonSpace
          </span>

          <h1>
            האנשים והעסקים של AlonSpace
          </h1>

          <p>
            הכירו את העסקים שפועלים לצדכם במתחם.
            מקום להכיר, להתחבר ולגלות מי נמצא ממש לידכם.
          </p>


          <% if (communityProfiles.length) { %>

            <span class="community-count">

              <%= communityProfiles.length %>

              <%=
                communityProfiles.length === 1
                  ? 'עסק בקהילה'
                  : 'עסקים בקהילה'
              %>

            </span>

          <% } %>

        </div>


        <div class="community-head-actions">

          <a
            href="/dashboard#business-profile"
            class="btn btn-outline"
          >
            עריכת הפרופיל שלי
          </a>

        </div>

      </div>


      <!-- PROFILES -->

      <% if (communityProfiles.length) { %>

        <div class="community-grid">


          <% communityProfiles.forEach(profile => { %>

            <article class="community-card">


              <div class="community-card-top">


                <!-- LOGO -->

                <div class="community-logo">

                  <% if (profile.has_logo) { %>

                    <img
                      src="/dashboard/community/business-profiles/<%= profile.id %>/logo"
                      alt="לוגו <%= profile.display_name %>"
                      loading="lazy"
                    >

                  <% } else { %>

                    <span
                      class="community-logo-placeholder"
                      aria-hidden="true"
                    >
                      🏢
                    </span>

                  <% } %>

                </div>


                <!-- NAME -->

                <div class="community-card-title">

                  <h2>
                    <%= profile.display_name %>
                  </h2>


                  <% if (profile.business_field) { %>

                    <span class="community-field">
                      <%= profile.business_field %>
                    </span>

                  <% } %>

                </div>

              </div>


              <!-- BIO -->

              <% if (profile.bio) { %>

                <p class="community-bio">
                  <%= profile.bio %>
                </p>

              <% } else { %>

                <p class="community-bio community-no-bio">
                  מידע נוסף על העסק יתווסף בהמשך.
                </p>

              <% } %>


              <!-- LINKS -->

              <div class="community-links">


                <% if (profile.website_url) { %>

                  <a
                    href="<%= profile.website_url %>"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="community-link"
                  >
                    אתר ↗
                  </a>

                <% } %>


                <% if (profile.linkedin_url) { %>

                  <a
                    href="<%= profile.linkedin_url %>"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="community-link"
                  >
                    LinkedIn ↗
                  </a>

                <% } %>


                <% if (
                  Number(profile.user_id) ===
                  Number(user.id)
                ) { %>

                  <span class="community-own-profile">
                    הפרופיל שלי
                  </span>

                <% } %>


              </div>

            </article>

          <% }) %>


        </div>


      <% } else { %>


        <!-- EMPTY STATE -->

        <div class="community-empty">

          <div
            class="community-empty-icon"
            aria-hidden="true"
          >
            🏢
          </div>

          <h2>
            הקהילה רק מתחילה
          </h2>

          <p>
            עדיין אין פרופילים שמוצגים בקהילה.
            אפשר להיות הראשונים ולהציג את העסק שלכם
            לדיירי AlonSpace.
          </p>

          <a
            href="/dashboard#business-profile"
            class="btn btn-primary"
          >
            יצירת הפרופיל שלי
          </a>

        </div>


      <% } %>


    </div>

  </section>

</main>


<%- include('partials/footer') %>
<%- include('partials/scripts') %>