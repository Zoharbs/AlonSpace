  <script>
  const meetingBookings =
    <%- JSON.stringify(meetingBookings || [])
      .replace(/</g, '\\u003c') %>;


  /* =====================================
     ELEMENTS
  ===================================== */

  const calendar =
    document.getElementById('weeklyCalendar');

  const weekTitle =
    document.getElementById('calendarWeekTitle');

  const bookingForm =
    document.getElementById('meetingBookingForm');

  const bookingDateInput =
    document.getElementById('booking_date');

  const startTimeInput =
    document.getElementById('start_time');

  const endTimeInput =
    document.getElementById('end_time');


  const bookingPopupOverlay =
    document.getElementById('bookingPopupOverlay');

  const bookingPopup =
    document.getElementById('bookingPopup');

  const bookingPopupClose =
    document.getElementById('bookingPopupClose');

  const bookingPopupCancel =
    document.getElementById('bookingPopupCancel');

  const bookingPopupDate =
    document.getElementById('bookingPopupDate');

  const bookingPopupTime =
    document.getElementById('bookingPopupTime');

const bookingMobileStart =
  document.getElementById('bookingMobileStart');

const bookingMobileEnd =
  document.getElementById('bookingMobileEnd');
  /* =====================================
     SETTINGS
  ===================================== */

  const dayNames = [
    'ראשון',
    'שני',
    'שלישי',
    'רביעי',
    'חמישי',
    'שישי',
    'שבת',
  ];

  const calendarStartHour = 8;
  const calendarEndHour = 21;
  const slotMinutes = 30;

  let displayedWeekStart =
    getStartOfWeek(new Date());


  /* =====================================
     SELECTION STATE
  ===================================== */

  let selectedStartSlot = null;

  let isCalendarDragging = false;

  let dragStartSlot = null;
  let dragCurrentSlot = null;

  let dragMoved = false;

let touchStartX = 0;
let touchStartY = 0;
  /* =====================================
     HELPERS
  ===================================== */

  function getStartOfWeek(date) {
    const result = new Date(date);

    result.setHours(0, 0, 0, 0);

    result.setDate(
      result.getDate() - result.getDay()
    );

    return result;
  }


  function addDays(date, amount) {
    const result = new Date(date);

    result.setDate(
      result.getDate() + amount
    );

    return result;
  }


  function dateKey(date) {
    const year =
      date.getFullYear();

    const month =
      String(
        date.getMonth() + 1
      ).padStart(2, '0');

    const day =
      String(
        date.getDate()
      ).padStart(2, '0');

    return `${year}-${month}-${day}`;
  }


  function normalizeBookingDate(value) {
    return String(value || '').slice(0, 10);
  }


  function normalizeTime(value) {
    return String(value || '').slice(0, 5);
  }


  function timeToMinutes(value) {
    const normalized =
      normalizeTime(value);

    const match =
      /^(\d{2}):(\d{2})$/.exec(normalized);

    if (!match) {
      return null;
    }

    return (
      Number(match[1]) * 60 +
      Number(match[2])
    );
  }


  function minutesToTime(minutes) {
    const hours =
      Math.floor(minutes / 60);

    const remainingMinutes =
      minutes % 60;

    return (
      String(hours).padStart(2, '0') +
      ':' +
      String(remainingMinutes).padStart(2, '0')
    );
  }


  function isPastSlot(day, minutes) {
    const slotDate =
      new Date(day);

    slotDate.setHours(
      Math.floor(minutes / 60),
      minutes % 60,
      0,
      0
    );

    return slotDate <= new Date();
  }


  function formatSelectedDate(dateString) {
    const [year, month, day] =
      dateString
        .split('-')
        .map(Number);

    const date =
      new Date(
        year,
        month - 1,
        day
      );

    return date.toLocaleDateString(
      'he-IL',
      {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
      }
    );
  }

function fillMobileTimeOptions(
  selectedStartMinutes,
  selectedEndMinutes
) {
  bookingMobileStart.innerHTML = '';
  bookingMobileEnd.innerHTML = '';

  /*
    שעות התחלה
  */
  for (
    let minutes = calendarStartHour * 60;
    minutes < calendarEndHour * 60;
    minutes += slotMinutes
  ) {
    const option =
      document.createElement('option');

    option.value =
      minutesToTime(minutes);

    option.textContent =
      minutesToTime(minutes);

    option.selected =
      minutes === selectedStartMinutes;

    bookingMobileStart.appendChild(
      option
    );
  }


  /*
    שעות סיום
  */
  for (
    let minutes =
      calendarStartHour * 60 + slotMinutes;

    minutes <= calendarEndHour * 60;

    minutes += slotMinutes
  ) {
    const option =
      document.createElement('option');

    option.value =
      minutesToTime(minutes);

    option.textContent =
      minutesToTime(minutes);

    option.selected =
      minutes === selectedEndMinutes;

    bookingMobileEnd.appendChild(
      option
    );
  }
}

function updateBookingTimesFromPopup() {
  const startMinutes =
    timeToMinutes(
      bookingMobileStart.value
    );

  const endMinutes =
    timeToMinutes(
      bookingMobileEnd.value
    );

  if (
    startMinutes === null ||
    endMinutes === null
  ) {
    return;
  }


  if (endMinutes <= startMinutes) {
    alert(
      'שעת הסיום חייבת להיות אחרי שעת ההתחלה.'
    );

    fillMobileTimeOptions(
      timeToMinutes(startTimeInput.value),
      timeToMinutes(endTimeInput.value)
    );

    return;
  }


  const date =
    bookingDateInput.value;


  if (
    rangeHasBooking(
      date,
      startMinutes,
      endMinutes
    )
  ) {
    alert(
      'חלק מהטווח שבחרת כבר תפוס.'
    );

    fillMobileTimeOptions(
      timeToMinutes(startTimeInput.value),
      timeToMinutes(endTimeInput.value)
    );

    return;
  }


  startTimeInput.value =
    minutesToTime(startMinutes);

  endTimeInput.value =
    minutesToTime(endMinutes);


  paintCalendarRange(
    date,
    startMinutes,
    endMinutes - slotMinutes
  );
}


bookingMobileStart
  ?.addEventListener(
    'change',
    updateBookingTimesFromPopup
  );


bookingMobileEnd
  ?.addEventListener(
    'change',
    updateBookingTimesFromPopup
  );

function updateBookingFromMobileTimes() {
  if (
    !bookingMobileStart ||
    !bookingMobileEnd
  ) {
    return;
  }

  const startMinutes =
    timeToMinutes(
      bookingMobileStart.value
    );

  const endMinutes =
    timeToMinutes(
      bookingMobileEnd.value
    );

  if (
    startMinutes === null ||
    endMinutes === null
  ) {
    return;
  }

  if (endMinutes <= startMinutes) {
    alert(
      'שעת הסיום חייבת להיות אחרי שעת ההתחלה.'
    );

    bookingMobileStart.value =
      startTimeInput.value;

    bookingMobileEnd.value =
      endTimeInput.value;

    return;
  }

  const date =
    bookingDateInput.value;

  if (
    rangeHasBooking(
      date,
      startMinutes,
      endMinutes
    )
  ) {
    alert(
      'חלק מהטווח שבחרת כבר תפוס.'
    );

    bookingMobileStart.value =
      startTimeInput.value;

    bookingMobileEnd.value =
      endTimeInput.value;

    return;
  }

  startTimeInput.value =
    minutesToTime(startMinutes);

  endTimeInput.value =
    minutesToTime(endMinutes);

  bookingPopupTime.textContent =
    `${minutesToTime(startMinutes)}–` +
    `${minutesToTime(endMinutes)}`;

  paintCalendarRange(
    date,
    startMinutes,
    endMinutes - slotMinutes
  );
}


bookingMobileStart?.addEventListener(
  'change',
  updateBookingFromMobileTimes
);

bookingMobileEnd?.addEventListener(
  'change',
  updateBookingFromMobileTimes
);

  /* =====================================
     SELECTION
  ===================================== */

  function clearCalendarSelection() {
    calendar
      .querySelectorAll('.calendar-slot')
      .forEach((slot) => {
        slot.classList.remove(
          'selected-start',
          'selected-range'
        );
      });
  }


  function paintCalendarRange(
    date,
    startMinutes,
    endMinutes
  ) {
    clearCalendarSelection();

    calendar
      .querySelectorAll(
        `.calendar-slot[data-date="${date}"]`
      )
      .forEach((slot) => {
        const slotMinutesValue =
          Number(
            slot.dataset.startMinutes
          );

        if (
          slotMinutesValue >= startMinutes &&
          slotMinutesValue <= endMinutes
        ) {
          slot.classList.add(
            'selected-range'
          );
        }
      });
  }


  function rangeHasBooking(
    date,
    startMinutes,
    endMinutes
  ) {
    return meetingBookings.some(
      (booking) => {

        if (
          normalizeBookingDate(
            booking.booking_date
          ) !== date
        ) {
          return false;
        }

        const bookingStart =
          timeToMinutes(
            booking.start_time
          );

        const bookingEnd =
          timeToMinutes(
            booking.end_time
          );

        if (
          bookingStart === null ||
          bookingEnd === null
        ) {
          return false;
        }

        return (
          startMinutes < bookingEnd &&
          endMinutes > bookingStart
        );
      }
    );
  }


  /* =====================================
     POPUP
  ===================================== */

  function openBookingPopup(
    date,
    startMinutes,
    endMinutes
  ) {
    bookingDateInput.value =
      date;

    startTimeInput.value =
      minutesToTime(startMinutes);

    endTimeInput.value =
      minutesToTime(endMinutes);
fillMobileTimeOptions(
  startMinutes,
  endMinutes
);

    bookingPopupDate.textContent =
      formatSelectedDate(date);




    bookingPopupOverlay
      .classList.add('open');

    document.body.style.overflow =
      'hidden';


    window.setTimeout(() => {
      document
        .getElementById('note')
        ?.focus();
    }, 180);
  }


  function closeBookingPopup(
    clearSelection = true
  ) {
    bookingPopupOverlay
      .classList.remove('open');

    document.body.style.overflow = '';

    if (clearSelection) {
      clearCalendarSelection();

      selectedStartSlot = null;
    }
  }


  bookingPopupClose
    ?.addEventListener(
      'click',
      () => closeBookingPopup()
    );


  bookingPopupCancel
    ?.addEventListener(
      'click',
      () => closeBookingPopup()
    );


  bookingPopupOverlay
    ?.addEventListener(
      'click',
      (event) => {

        if (
          event.target ===
          bookingPopupOverlay
        ) {
          closeBookingPopup();
        }
      }
    );


  document.addEventListener(
    'keydown',
    (event) => {

      if (
        event.key === 'Escape' &&
        bookingPopupOverlay
          ?.classList.contains('open')
      ) {
        closeBookingPopup();
      }
    }
  );


  /* =====================================
     FINISH RANGE
  ===================================== */

  function finishCalendarRange(
    date,
    firstMinutes,
    lastMinutes
  ) {
    const startMinutes =
      Math.min(
        firstMinutes,
        lastMinutes
      );

    const endMinutes =
      Math.max(
        firstMinutes,
        lastMinutes
      ) + slotMinutes;


    if (
      rangeHasBooking(
        date,
        startMinutes,
        endMinutes
      )
    ) {
      clearCalendarSelection();

      selectedStartSlot = null;

      alert(
        'חלק מהטווח שבחרת כבר תפוס.'
      );

      return;
    }


    paintCalendarRange(
      date,
      startMinutes,
      endMinutes - slotMinutes
    );


    selectedStartSlot = null;


    openBookingPopup(
      date,
      startMinutes,
      endMinutes
    );
  }


  function setFirstClickSelection(
    date,
    minutes,
    element
  ) {
    clearCalendarSelection();

    selectedStartSlot = {
      date,
      minutes,
      element,
    };

    element.classList.add(
      'selected-start'
    );
  }


  /* =====================================
     RENDER
  ===================================== */

  function renderCalendar() {
    calendar.innerHTML = '';

    selectedStartSlot = null;

    const weekEnd =
      addDays(
        displayedWeekStart,
        6
      );


    weekTitle.textContent =
      displayedWeekStart
        .toLocaleDateString(
          'he-IL',
          {
            day: 'numeric',
            month: 'long',
          }
        ) +
      ' – ' +
      weekEnd
        .toLocaleDateString(
          'he-IL',
          {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          }
        );


    const corner =
      document.createElement('div');

    corner.className =
      'calendar-corner';

    calendar.appendChild(corner);


    const todayKey =
      dateKey(new Date());


    /* DAY HEADERS */

    for (
      let dayIndex = 0;
      dayIndex < 7;
      dayIndex += 1
    ) {
      const day =
        addDays(
          displayedWeekStart,
          dayIndex
        );

      const header =
        document.createElement('div');

      header.className =
        'calendar-day-header';


      if (
        dateKey(day) === todayKey
      ) {
        header.classList.add(
          'today'
        );
      }


      header.innerHTML = `
        <span class="calendar-day-name">
          ${dayNames[dayIndex]}
        </span>

        <span class="calendar-day-date">
          ${day.toLocaleDateString(
            'he-IL',
            {
              day: '2-digit',
              month: '2-digit',
            }
          )}
        </span>
      `;


      calendar.appendChild(header);
    }


    /* TIME ROWS */

    for (
      let minutes =
        calendarStartHour * 60;

      minutes <
        calendarEndHour * 60;

      minutes += slotMinutes
    ) {

      const timeLabel =
        document.createElement('div');

      timeLabel.className =
        'calendar-time-label';

      timeLabel.textContent =
        minutesToTime(minutes);

      calendar.appendChild(
        timeLabel
      );


      for (
        let dayIndex = 0;
        dayIndex < 7;
        dayIndex += 1
      ) {

        const day =
          addDays(
            displayedWeekStart,
            dayIndex
          );

        const currentDateKey =
          dateKey(day);

        const slot =
          document.createElement('div');

        slot.className =
          'calendar-slot';

        slot.dataset.date =
          currentDateKey;

        slot.dataset.startMinutes =
          String(minutes);


        const past =
          isPastSlot(
            day,
            minutes
          );


        if (past) {

          slot.classList.add(
            'past'
          );

        } else {
/* =========================
   MOBILE TAP
========================= */

slot.addEventListener(
  'touchstart',
  (event) => {
    const touch =
      event.touches[0];

    touchStartX =
      touch.clientX;

    touchStartY =
      touch.clientY;
  },
  {
    passive: true
  }
);

slot.addEventListener(
  'touchend',
  (event) => {
    const touch =
      event.changedTouches[0];

    const movedX =
      Math.abs(
        touch.clientX -
        touchStartX
      );

    const movedY =
      Math.abs(
        touch.clientY -
        touchStartY
      );

    /*
      הייתה תנועה של האצבע:
      המשתמש גלל את הלוח/העמוד.
    */
    if (
      movedX > 10 ||
      movedY > 10
    ) {
      return;
    }

    /*
      Tap אמיתי על המשבצת.
    */
    finishCalendarRange(
      currentDateKey,
      minutes,
      minutes
    );
  },
  {
    passive: true
  }
);
          /* =========================
             MOUSE DOWN
          ========================= */

          slot.addEventListener(
            'mousedown',
            (event) => {

              if (
                event.button !== 0
              ) {
                return;
              }

              event.preventDefault();

              isCalendarDragging = true;

              dragMoved = false;

              dragStartSlot = {
                date:
                  currentDateKey,

                minutes,

                element:
                  slot,
              };

              dragCurrentSlot =
                dragStartSlot;


              if (
                !selectedStartSlot
              ) {
                clearCalendarSelection();

                slot.classList.add(
                  'selected-start'
                );
              }
            }
          );


          /* =========================
             DRAG
          ========================= */

          slot.addEventListener(
            'mouseenter',
            () => {

              if (
                !isCalendarDragging ||
                !dragStartSlot
              ) {
                return;
              }


              if (
                dragStartSlot.date !==
                currentDateKey
              ) {
                return;
              }


              if (
                minutes !==
                dragStartSlot.minutes
              ) {
                dragMoved = true;
              }


              dragCurrentSlot = {
                date:
                  currentDateKey,

                minutes,

                element:
                  slot,
              };


              const rangeStart =
                Math.min(
                  dragStartSlot.minutes,
                  minutes
                );

              const rangeEnd =
                Math.max(
                  dragStartSlot.minutes,
                  minutes
                );


              paintCalendarRange(
                currentDateKey,
                rangeStart,
                rangeEnd
              );
            }
          );
        }


        /* =========================
           EXISTING BOOKING
        ========================= */

        const booking =
          meetingBookings.find(
            (item) => {

              const bookingStart =
                timeToMinutes(
                  item.start_time
                );

              const bookingEnd =
                timeToMinutes(
                  item.end_time
                );


              return (
                normalizeBookingDate(
                  item.booking_date
                ) ===
                  currentDateKey &&

                bookingStart !== null &&

                bookingEnd !== null &&

                bookingStart <=
                  minutes &&

                bookingEnd >
                  minutes
              );
            }
          );


        if (
          booking &&
          timeToMinutes(
            booking.start_time
          ) === minutes
        ) {

          const bookingElement =
            document.createElement(
              'div'
            );

          bookingElement.className =
            'calendar-booking';


          if (booking.is_mine) {
            bookingElement
              .classList.add('mine');
          }


          const durationMinutes =
            timeToMinutes(
              booking.end_time
            ) -
            timeToMinutes(
              booking.start_time
            );


          const slotCount =
            Math.max(
              1,
              durationMinutes /
                slotMinutes
            );


          /*
            גובה כל slot אצלך הוא 42px.
          */

          bookingElement.style.height =
            `calc(${slotCount * 42}px - 6px)`;


          if (booking.is_mine) {

            const createdByAdmin =
              booking.booking_source ===
              'admin';


            bookingElement.innerHTML = `
              <strong>
                השריון שלי
              </strong>

              ${normalizeTime(
                booking.start_time
              )}
              –
              ${normalizeTime(
                booking.end_time
              )}

              ${
                createdByAdmin
                  ? `
                    <br>
                    <span class="booking-admin-label">
                      נוצר על ידי מנהל
                    </span>
                  `
                  : ''
              }
            `;


            bookingElement.title =
              `השריון שלי\n` +
              `${normalizeTime(
                booking.start_time
              )}–${normalizeTime(
                booking.end_time
              )}` +
              (
                createdByAdmin
                  ? '\nנוצר על ידי מנהל'
                  : ''
              ) +
              (
                booking.note
                  ? `\n${booking.note}`
                  : ''
              );

          } else {

            bookingElement.innerHTML = `
              <strong>
                תפוס
              </strong>

              ${normalizeTime(
                booking.start_time
              )}
              –
              ${normalizeTime(
                booking.end_time
              )}
            `;


            bookingElement.title =
              `תפוס\n` +
              `${normalizeTime(
                booking.start_time
              )}–${normalizeTime(
                booking.end_time
              )}`;
          }


          slot.appendChild(
            bookingElement
          );
        }


        calendar.appendChild(slot);
      }
    }
  }


  /* =====================================
     MOUSE UP
  ===================================== */

  document.addEventListener(
    'mouseup',
    () => {

      if (
        !isCalendarDragging ||
        !dragStartSlot
      ) {
        return;
      }


      isCalendarDragging = false;


      const start =
        dragStartSlot;

      const end =
        dragCurrentSlot ||
        dragStartSlot;


      /* DRAG */

      if (dragMoved) {

        if (
          start.date === end.date
        ) {
          finishCalendarRange(
            start.date,
            start.minutes,
            end.minutes
          );
        } else {
          clearCalendarSelection();

          selectedStartSlot =
            null;
        }


        dragStartSlot = null;
        dragCurrentSlot = null;
        dragMoved = false;

        return;
      }


      /* SINGLE CLICK */

if (!selectedStartSlot) {

  finishCalendarRange(
    start.date,
    start.minutes,
    start.minutes + slotMinutes
  );

  dragStartSlot = null;
  dragCurrentSlot = null;
  dragMoved = false;

  return;
}


      /*
        לחיצה שנייה באותו יום
        סוגרת את הטווח.
      */

      if (
        selectedStartSlot.date !==
        start.date
      ) {

        setFirstClickSelection(
          start.date,
          start.minutes,
          start.element
        );

        dragStartSlot = null;
        dragCurrentSlot = null;

        return;
      }


      finishCalendarRange(
        start.date,
        selectedStartSlot.minutes,
        start.minutes
      );


      dragStartSlot = null;
      dragCurrentSlot = null;
      dragMoved = false;
    }
  );


  /* =====================================
     WEEK NAVIGATION
  ===================================== */

  document
    .getElementById('previousWeek')
    ?.addEventListener(
      'click',
      () => {

        closeBookingPopup();

        displayedWeekStart =
          addDays(
            displayedWeekStart,
            -7
          );

        renderCalendar();
      }
    );


  document
    .getElementById('nextWeek')
    ?.addEventListener(
      'click',
      () => {

        closeBookingPopup();

        displayedWeekStart =
          addDays(
            displayedWeekStart,
            7
          );

        renderCalendar();
      }
    );


  document
    .getElementById('currentWeek')
    ?.addEventListener(
      'click',
      () => {

        closeBookingPopup();

        displayedWeekStart =
          getStartOfWeek(
            new Date()
          );

        renderCalendar();
      }
    );


  /* =====================================
     INIT
  ===================================== */

  renderCalendar();
</script>