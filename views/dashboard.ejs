<%- include('partials/head', { title }) %>
  <%- include('partials/header') %>

    <style>
      .tenant-hero {
        padding: 58px 0 46px;
      }

      .tenant-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-top: -34px;
        position: relative;
        z-index: 3;
      }

      .tenant-summary-card {
        background: var(--cream);
        border: 1px solid var(--stone-dark);
        border-radius: 22px;
        padding: 24px;
        box-shadow: var(--shadow);
      }

      .tenant-summary-card h3 {
        margin-bottom: 8px;
      }

      .tenant-section {
        padding-top: 54px;
      }

.meeting-portal-grid {
  display: grid;

  grid-template-columns:
    minmax(280px, 320px)
    minmax(0, 1fr);

  gap: 32px;

  align-items: start;

  width: 100%;
}

      .meeting-booking-card {
        position: sticky;
        top: 100px;
      }

      .quota-line {
        height: 10px;
        overflow: hidden;
        border-radius: 999px;
        background: var(--stone-dark);
        margin-top: 14px;
      }

      .quota-line span {
        display: block;
        height: 100%;
        width: var(--quota-used);
        background: var(--oak);
        border-radius: inherit;
      }

      .portal-table-wrap {
        overflow-x: auto;
        border-radius: 20px;
        box-shadow: var(--shadow);
      }

      .portal-table {
        width: 100%;
        min-width: 760px;
        border-collapse: collapse;
        background: var(--cream);
      }

      .portal-table th,
      .portal-table td {
        padding: 14px 16px;
        text-align: right;
        border-bottom: 1px solid var(--stone-dark);
      }

      .portal-table th {
        background: var(--stone-dark);
      }

      .portal-table tr:last-child td {
        border-bottom: 0;
      }

      .meeting-calendar-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 18px;
      }

      .calendar-navigation {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

.weekly-calendar-wrap {
  width: 100%;
  overflow: hidden;

  border: 1px solid rgba(20, 20, 45, 0.08);
  border-radius: 20px;

  background: #fff;

  box-shadow:
    0 10px 30px rgba(25, 25, 50, 0.04);
}

.weekly-calendar {
  display: grid;

  /*
    עמודת שעות + 7 ימים.
    כולם חייבים להיכנס לרוחב הקיים.
  */
  grid-template-columns:
    64px repeat(7, minmax(0, 1fr));

  width: 100%;
  min-width: 0;

  background: #fff;
}


/* =========================
   כותרות הימים
========================= */

.calendar-corner,
.calendar-day-header {
  height: 82px;

  background: #faf9fd;

  border-bottom: 1px solid
    rgba(55, 50, 90, 0.10);
}

.calendar-corner {
  border-left: 1px solid
    rgba(55, 50, 90, 0.08);
}

.calendar-day-header {
  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  gap: 6px;

  position: relative;

  border-left: 1px solid
    rgba(55, 50, 90, 0.08);
}

.calendar-day-name {
  font-size: .95rem;
  font-weight: 800;

  color: #151522;
}

.calendar-day-date {
  font-size: .82rem;
  font-weight: 500;

  color: #68677d;
}


/* היום הנוכחי */

.calendar-day-header.today {
  background: #f7f5ff;
}

.calendar-day-header.today::after {
  content: "";

  position: absolute;

  right: 14%;
  left: 14%;
  bottom: 0;

  height: 3px;

  border-radius: 999px 999px 0 0;

  background: #7865f6;
}


/* =========================
   שעות
========================= */

.calendar-time-label {
  height: 38px;

  display: flex;
  align-items: flex-start;
  justify-content: center;

  padding-top: 6px;

  box-sizing: border-box;

  background: #fbfafd;

  color: #68677d;

  font-size: .76rem;

  border-left: 1px solid
    rgba(55, 50, 90, 0.08);

  border-bottom: 1px solid
    rgba(55, 50, 90, 0.065);
}


/* =========================
   משבצות
========================= */

.calendar-slot {
  position: relative;

  height: 38px;

  box-sizing: border-box;

  background: #fff;

  border-left: 1px solid
    rgba(55, 50, 90, 0.065);

  border-bottom: 1px solid
    rgba(55, 50, 90, 0.065);

  cursor: pointer;

  user-select: none;

  transition:
    background .12s ease;
}


/* hover עדין */

.calendar-slot:not(.past):hover {
  background: #faf9ff;
}


/* עבר */

.calendar-slot.past {
  background: #f7f7f9;
  cursor: default;
}


/* =========================
   בחירת טווח
========================= */

.calendar-slot.selected-start,
.calendar-slot.selected-range {
  background: #ebe8ff;
}

.calendar-slot.selected-start {
  box-shadow:
    inset 3px 0 0 #7865f6;
}


/* =========================
   שריונים
========================= */

.calendar-booking {
  position: absolute;

  top: 3px;
  right: 4px;
  left: 4px;

  z-index: 5;

  box-sizing: border-box;

  padding: 6px 7px;

  border-radius: 7px;

  background: #e8e6ee;

  border-right: 3px solid #77738a;

  font-size: .72rem;
  line-height: 1.35;

  overflow: hidden;
}

.calendar-booking.mine {
  background: #e6e2ff;
  border-right-color: #7865f6;
}

      .calendar-booking strong {
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .my-bookings-card {
        margin-top: 24px;
      }

      .my-bookings-list {
        display: grid;
        gap: 10px;
      }

      .my-booking-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 12px 0;
        border-bottom: 1px solid var(--stone-dark);
      }

      .my-booking-item:last-child {
        border-bottom: 0;
      }

      .calendar-slot.selected-start,
.calendar-slot.selected-range {
  background: #ebe8ff;
}

.calendar-slot.selected-start {
  box-shadow:
    inset 3px 0 0 #7865f6;
}

      .onboarding-survey-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;

        margin-bottom: 28px;
        padding: 22px 24px;

        background: var(--cream);
        border: 1px solid var(--stone-dark);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow);
      }

      .onboarding-survey-content {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .onboarding-survey-icon {
        width: 44px;
        height: 44px;
        flex: 0 0 44px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        background: var(--oak);
        color: var(--cream);

        font-size: 1.2rem;
        font-weight: 700;
      }

      .onboarding-survey-card h3 {
        margin: 0 0 5px;
      }

      .onboarding-survey-card p {
        margin: 0;
        color: var(--ink-soft);
      }

      @media (max-width: 700px) {
        .onboarding-survey-card {
          align-items: stretch;
          flex-direction: column;
        }

        .onboarding-survey-card .btn {
          width: 100%;
          text-align: center;
        }
      }

      @media (max-width:900px) {
        .meeting-portal-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 900px) {

        .tenant-summary,
        .meeting-portal-grid {
          grid-template-columns: 1fr;
        }

        .tenant-summary {
          margin-top: 24px;
        }

        .meeting-booking-card {
          position: static;
        }
      }


/* כותרות ימים */

.calendar-corner,
.calendar-day-header {
  height: 88px;
  background: #f7f6fc;
  border-bottom: 1px solid #dddbea;
}

.calendar-corner {
  border-left: 1px solid #e3e1ed;
}

.calendar-day-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 7px;

  border-left: 1px solid #e3e1ed;

  position: relative;
}

.calendar-day-name {
  font-weight: 800;
  font-size: 1rem;
  color: #111223;
}

.calendar-day-date {
  font-size: .88rem;
  color: #62627a;
}

/* היום הנוכחי */

.calendar-day-header.today::after {
  content: "";

  position: absolute;

  bottom: 0;
  left: 0;
  right: 0;

  height: 4px;

  background: #7765f5;
}

.calendar-day-header.today {
  background: #f4f2ff;
}


/* =========================
   TIME COLUMN
========================= */

.calendar-time-label {
  height: 36px;

  display: flex;
  align-items: flex-start;
  justify-content: center;

  padding-top: 5px;

  font-size: .78rem;
  color: #66667d;

  background: #faf9fd;

  border-left: 1px solid #e5e3ee;
  border-bottom: 1px solid #eeeeF4;

  box-sizing: border-box;
}


/* =========================
   CALENDAR CELLS
========================= */

.calendar-slot {
  position: relative;

  height: 36px;

  background: #fff;

  border-left: 1px solid #eceaf3;
  border-bottom: 1px solid #eeeeF4;

  box-sizing: border-box;

  cursor: pointer;

  user-select: none;
}

/* עבר */

.calendar-slot.past {
  background: #f5f5f7;
  cursor: default;
}

/* hover */

.calendar-slot:not(.past):hover {
  background: #f7f6ff;
}


/* =========================
   RANGE SELECTION
========================= */

.calendar-slot.selected-start,
.calendar-slot.selected-range {
  background: #e8e4ff;
}

.calendar-slot.selected-start {
  box-shadow:
    inset 0 2px 0 #7765f5,
    inset 0 -2px 0 #7765f5;
}

.calendar-slot.selected-range {
  border-bottom-color: #d9d3ff;
}


/* =========================
   BOOKINGS
========================= */

.calendar-booking {
  position: absolute;

  top: 3px;
  right: 4px;
  left: 4px;

  z-index: 5;

  border-radius: 8px;

  padding: 7px 8px;

  box-sizing: border-box;

  background: #dedbe8;

  border-right: 4px solid #77738a;

  font-size: .76rem;
  line-height: 1.35;

  overflow: hidden;

  cursor: default;
}

.calendar-booking strong {
  display: block;
  margin-bottom: 3px;
}

/* השריון של המשתמש */

.calendar-booking.mine {
  background: #e4e0ff;
  border-right-color: #7765f5;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 900px) {

  .weekly-calendar {
    grid-template-columns:
      60px repeat(7, minmax(105px, 1fr));

    min-width: 800px;
  }

  .calendar-corner,
  .calendar-day-header {
    height: 76px;
  }

  .calendar-slot,
  .calendar-time-label {
    height: 34px;
  }
}
.tenant-section .container {
  max-width: 1600px;
  width: calc(100% - 64px);
}
/* =====================================
   TENANT WEEKLY CALENDAR
===================================== */

.weekly-calendar-wrap {
  width: 100%;

  overflow: hidden;

  background: #ffffff;

  border: 1px solid rgba(35, 32, 65, 0.07);
  border-radius: 24px;

  box-shadow:
    0 8px 30px rgba(30, 27, 60, 0.045);
}

.weekly-calendar {
  display: grid;

  grid-template-columns:
    58px repeat(7, minmax(0, 1fr));

  width: 100%;
  min-width: 0;

  background: #ffffff;
}


/* =====================================
   DAY HEADERS
===================================== */

.calendar-corner,
.calendar-day-header {
  height: 86px;

  background: #fbfaff;

  border-bottom:
    1px solid rgba(45, 40, 80, 0.07);
}

.calendar-corner {
  border-left:
    1px solid rgba(45, 40, 80, 0.055);
}

.calendar-day-header {
  position: relative;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  gap: 7px;

  border-left:
    1px solid rgba(45, 40, 80, 0.055);
}

.calendar-day-name {
  color: #151522;

  font-size: 1rem;
  font-weight: 800;
}

.calendar-day-date {
  color: #777589;

  font-size: .82rem;
  font-weight: 500;
}


/* TODAY */

.calendar-day-header.today {
  background: #f8f6ff;
}

.calendar-day-header.today::after {
  content: "";

  position: absolute;

  bottom: 0;
  left: 22%;
  right: 22%;

  height: 3px;

  border-radius: 10px 10px 0 0;

  background: #7865f6;
}


/* =====================================
   TIME LABELS
===================================== */

.calendar-time-label {
  height: 42px;

  display: flex;
  align-items: flex-start;
  justify-content: center;

  box-sizing: border-box;

  padding-top: 7px;

  background: #fcfbff;

  color: #747287;

  font-size: .75rem;
  font-weight: 500;

  border-left:
    1px solid rgba(45, 40, 80, 0.055);

  border-bottom:
    1px solid rgba(45, 40, 80, 0.045);
}


/* =====================================
   CALENDAR CELLS
===================================== */

.calendar-slot {
  position: relative;

  height: 42px;

  box-sizing: border-box;

  background: #ffffff;

  /*
    הקווים בכוונה מאוד עדינים.
  */

  border-left:
    1px solid rgba(45, 40, 80, 0.04);

  border-bottom:
    1px solid rgba(45, 40, 80, 0.045);

  cursor: pointer;

  user-select: none;

  transition:
    background-color .12s ease;
}


/* hover */

.calendar-slot:not(.past):hover {
  background: #faf9ff;
}


/* past */

.calendar-slot.past {
  background: #f8f8fa;

  cursor: default;
}


/* =====================================
   SELECTION
===================================== */

.calendar-slot.selected-start,
.calendar-slot.selected-range {
  background: #ebe8ff;
}

.calendar-slot.selected-start {
  box-shadow:
    inset 3px 0 0 #7865f6;
}


/* =====================================
   BOOKINGS
===================================== */

.calendar-booking {
  position: absolute;

  top: 3px;
  right: 5px;
  left: 5px;

  z-index: 5;

  box-sizing: border-box;

  padding: 7px 9px;

  border: 0;
  border-radius: 9px;

  background: #ebeaf0;

  box-shadow:
    0 2px 7px rgba(30, 28, 55, 0.06);

  color: #242333;

  font-size: .72rem;
  line-height: 1.35;

  overflow: hidden;
}

.calendar-booking strong {
  display: block;

  margin-bottom: 2px;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}


/* booking של המשתמש */

.calendar-booking.mine {
  background: #e7e3ff;

  color: #302a65;

  box-shadow:
    inset 3px 0 0 #7865f6,
    0 2px 7px rgba(30, 28, 55, 0.05);
}


/* =====================================
   MOBILE
===================================== */

@media (max-width: 900px) {

  .tenant-section .container {
    width: calc(100% - 28px);
  }

  .meeting-portal-grid {
    grid-template-columns: 1fr;
  }

  .weekly-calendar-wrap {
    overflow-x: auto;
  }

  .weekly-calendar {
    grid-template-columns:
      55px repeat(7, minmax(100px, 1fr));

    min-width: 755px;
  }
}
/* ========================================
   DASHBOARD MESSAGES
======================================== */

main > section:first-child .form-msg,
main > section:first-child .quota-warning {
  position: relative;
  inset: auto;
  transform: none;

  width: 100%;
  margin: 0 0 24px;
  box-sizing: border-box;

  z-index: 1;
}

main > section:first-child .tenant-summary {
  margin-top: 0;
}
.booking-admin-label {
  display: inline-block;
  margin-top: 4px;

  font-size: .67rem;
  font-weight: 700;

  color: #6657d9;
}
.booking-popup-time-editor {
  display: flex;
  align-items: center;
  gap: 7px;

  margin-top: 7px;
}

.booking-popup-time-editor select {
  appearance: none;
  -webkit-appearance: none;

  width: auto;

  padding: 2px 4px;

  border: 0;
  border-bottom: 1px dashed rgba(30, 30, 45, .3);
  border-radius: 0;

  background: transparent;

  color: inherit;

  font: inherit;
  font-weight: 700;

  cursor: pointer;
}

.booking-popup-time-editor select:focus {
  outline: none;
  border-bottom-color: var(--oak);
}

.booking-time-separator {
  opacity: .65;
}
    </style>

    <section class="page-hero tenant-hero">
      <div class="container">
        <span class="eyebrow">פורטל הדיירים</span>
        <h1>שלום, <%= user.display_name %>
        </h1>
        <p>
          כאן נמצאים פרטי המשרד שלך, תקופת השכירות ולוח השריונים
          המשותף של חדר הישיבות.
        </p>
      </div>
    </section>
    <% if (shouldShowSurvey) { %>

      <div class="onboarding-survey-card">

        <div class="onboarding-survey-content">

          <div class="onboarding-survey-icon">
            ✓
          </div>

          <div>
            <h3>
              עזרו לנו להתאים את AlonSpace אליכם
            </h3>

            <p>
              הכנו סקר קצר של כדקה שיעזור לנו להבין
              איך אתם משתמשים במתחם ומה חשוב לכם.
            </p>
          </div>

        </div>
        <br>
        <a href="/dashboard/survey" class="btn btn-primary">
          לסקר הקצר
        </a>
        <br>
      </div>

      <% } %>
        <main>
          <section style="padding-top:0;">
            <div class="container">
              <% if (error) { %>
                <div class="form-msg show err">
                  <%= error %>
                </div>
                <% } %>

                  <% if (success) { %>
                    <div class="form-msg show ok">
                      <%= success %>
                    </div>
                    <% } %>
                      <% if (quotaExceeded) { %>

                        <div class="quota-warning">

                          <% if (hasChargeableBookings) { %>

                            <strong>
                              שימוש מעבר למכסת חדר הישיבות
                            </strong>

                            <p>
                              עברת את מכסת
                              <%= Number(user.monthly_meeting_hours || 6).toFixed(1) %>
                                השעות החודשית.

                                בוצעו החודש שריונים נוספים מעבר למכסה,
                                ולכן חלק מהשימוש עשוי להיות כרוך בתשלום.
                            </p>

                            <% } else { %>

                              <strong>
                                עברת את מכסת חדר הישיבות החודשית
                              </strong>

                              <p>
                                ניצלת יותר מ־
                                <%= Number(user.monthly_meeting_hours || 6).toFixed(1) %>
                                  שעות החודש.

                                  השריון הנוכחי אושר.
                                  שימוש נוסף מעבר למכסה עשוי להיות כרוך בתשלום.
                              </p>

                              <% } %>

                        </div>

                        <% } %>
                          <div class="tenant-summary">
                            <article class="tenant-summary-card">
                              <span class="eyebrow">המשרד שלי</span>

                              <h3>
                                <%= user.office_number ? `משרד ${user.office_number}` : 'משרד טרם הוגדר' %>
                              </h3>

                              <p class="small">
                                <%= user.floor ? `קומה ${user.floor}` : 'קומה טרם הוגדרה' %>
                              </p>

                              <% if (user.business_name) { %>
                                <p><strong>
                                    <%= user.business_name %>
                                  </strong></p>
                                <% } %>
                            </article>

                            <article class="tenant-summary-card">
                              <span class="eyebrow">תקופת השכירות</span>

                              <% if (user.rental_start_date || user.rental_end_date) { %>
                                <h3>
                                  <%= formatDate(user.rental_start_date) %>
                                    –
                                    <%= formatDate(user.rental_end_date) %>
                                </h3>

                                <p class="small">
                                  תקופת השכירות המעודכנת בחשבון
                                </p>
                                <% } else { %>
                                  <h3>טרם הוגדרה</h3>

                                  <p class="small">
                                    יש לפנות להנהלת AlonSpace לעדכון התקופה
                                  </p>
                                  <% } %>
                            </article>

                            <article class="tenant-summary-card"
                              style="--quota-used:<%= Math.min(100, (usedHours / Number(user.monthly_meeting_hours || 6)) * 100) %>%">
                              <span class="eyebrow">חדר ישיבות</span>

                              <h3>
                                <%= remainingHours.toFixed(1) %> שעות נותרו
                              </h3>

                              <p class="small">
                                נוצלו:
                                <%= usedHours.toFixed(1) %>
                                  מתוך
                                  <%= Number(user.monthly_meeting_hours || 6).toFixed(1) %>
                                    שעות החודש
                              </p>

                              <div class="quota-line" aria-hidden="true">
                                <span></span>
                              </div>
                            </article>
                          </div>
            </div>
          </section>
          <% if (user.must_change_password) { %>

            <div class="password-recommendation">

              <div>
                <strong>עדיין משתמשים בסיסמה הראשונית?</strong>

                <p>
                  מומלץ לשנות אותה לסיסמה אישית שתהיה רק שלכם.
                </p>
              </div>

              <a href="/change-password" class="btn btn-outline">
                שינוי סיסמה
              </a>

            </div>

