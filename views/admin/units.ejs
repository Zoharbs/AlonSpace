<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title><%= title %></title>

  <link rel="stylesheet" href="/css/style.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0a0c1a;
      color: #ece9f7;
      line-height: 1.6;
    }

    .container {
      max-width: 1250px;
      margin: 0 auto;
      padding: 36px 20px 80px;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 32px;
    }

    .back-link {
      color: #f2c14e;
      text-decoration: none;
      font-weight: bold;
    }

    h1 {
      margin: 0 0 8px;
      font-size: 30px;
    }

    .subtitle {
      color: #a6a8bd;
      margin: 0;
    }

    .stats {
      display: grid;
      grid-template-columns:
        repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin: 28px 0 36px;
    }

    .stat-card,
    .floor-section {
      background: #14182b;
      border: 1px solid #292f48;
      border-radius: 14px;
    }

    .stat-card {
      padding: 22px;
    }

    .stat-label {
      color: #a6a8bd;
      font-size: 14px;
    }

    .stat-value {
      font-size: 30px;
      font-weight: bold;
      margin-top: 6px;
    }

    .floor-section {
      margin-bottom: 28px;
      overflow: hidden;
    }

    .floor-heading {
      padding: 20px 24px;
      border-bottom: 1px solid #292f48;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .floor-heading h2 {
      margin: 0;
      font-size: 21px;
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: right;
      min-width: 780px;
    }

    th,
    td {
      padding: 15px 18px;
      border-bottom: 1px solid #292f48;
    }

    th {
      color: #a6a8bd;
      font-size: 13px;
      font-weight: normal;
    }

    td {
      font-size: 14px;
    }

    tr:last-child td {
      border-bottom: none;
    }

    .muted {
      color: #a6a8bd;
    }

    .pill {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 20px;
      background: #242a40;
      font-size: 12px;
      white-space: nowrap;
    }

    .pill.occupied {
      background: #193a32;
      color: #83e3bc;
    }

    .pill.vacant {
      background: #49351d;
      color: #f2c14e;
    }

    .empty {
      padding: 40px 24px;
      text-align: center;
      color: #a6a8bd;
    }

    @media (max-width: 700px) {
      .stats {
        grid-template-columns: 1fr;
      }

      h1 {
        font-size: 24px;
      }

      .container {
        padding: 24px 14px;
      }
    }
      /* AlonSpace admin visual alignment */

    body {
      font-family: 'Assistant', Arial, sans-serif;
      background: var(--stone);
      color: var(--ink);
    }

    .topbar {
      background: var(--ink);
      color: var(--cream);
      padding: 20px 24px;
      border-radius: var(--radius-lg);
    }

    .topbar h1 {
      color: var(--cream);
    }

    .topbar .subtitle {
      color: var(--cream);
      opacity: .8;
    }

    .back-link {
      color: var(--cream);
    }

    .stat-card,
    .floor-section,
    .owner-management {
      background: var(--cream);
      border: 1px solid var(--stone-dark);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
    }

    .stat-label,
    .muted {
      color: var(--ink-soft);
    }

    .floor-heading,
    th,
    td {
      border-color: var(--stone-dark);
    }

    th {
      background: var(--stone-dark);
      color: var(--ink);
    }

    .owner-management {
      padding: 24px;
      margin-bottom: 28px;
    }

    .owner-management h2 {
      margin: 0 0 8px;
    }

    .owner-form {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin-top: 18px;
    }

    .owner-form label {
      display: grid;
      gap: 6px;
      font-weight: 600;
    }

    .owner-form input,
    .owner-form select,
    .owner-form textarea {
      width: 100%;
      padding: 11px 13px;
      border: 1px solid var(--stone-dark);
      border-radius: 9px;
      background: #fff;
      color: var(--ink);
      font: inherit;
    }

    .owner-form .full-width {
      grid-column: 1 / -1;
    }

    .owner-form button {
      justify-self: start;
      padding: 11px 24px;
      border: 0;
      border-radius: 9px;
      background: var(--ink);
      color: var(--cream);
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .owner-feedback {
      padding: 12px 16px;
      margin-bottom: 16px;
      border-radius: 9px;
      background: var(--stone);
    }

    .owner-feedback.error {
      color: #9c3b3b;
      background: #f1d4d4;
    }

    @media (max-width: 700px) {
      .owner-form {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <main class="container">

    <div class="topbar">
      <div>
        <h1>יחידות וכספים</h1>
        <p class="subtitle">
          ניהול היחידות בקומות 4 ו־6
        </p>
      </div>

      <a href="/admin" class="back-link">
        ← חזרה לפאנל הניהול
      </a>
    </div>

    <%
      const activeUnits = units.filter(
        unit => unit.is_active
      );

      const occupiedUnits = activeUnits.filter(
        unit => unit.tenancy_id
      );

      const ownedUnits = activeUnits.filter(
        unit => unit.ownership_type === 'alonspace'
      );

      const rentalModelNames = {
        managed: 'ניהול AlonSpace',
        direct_owner: 'דרך הבעלים',
        alonspace_owned: 'בבעלות AlonSpace'
      };
    %>
    <% if (success) { %>
      <div class="owner-feedback" role="status">
        <%= success %>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="owner-feedback error" role="alert">
        <%= error %>
      </div>
    <% } %>

    <section class="owner-management">
      <h2>ניהול בעלי יחידות</h2>

      <p class="muted">
        הוסף בעלים כדי שנוכל לשייך אליו יחידות
        ולנהל את דמי הניהול שלו.
      </p>

      <details>
        <summary style="cursor:pointer; font-weight:700;">
          + הוספת בעלים חדש
        </summary>

        <form
          method="POST"
          action="/admin/units/owners"
          class="owner-form"
        >
          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >

          <label>
            שם הבעלים *
            <input
              type="text"
              name="name"
              maxlength="200"
              required
            >
          </label>

          <label>
            טלפון
            <input
              type="tel"
              name="phone"
              maxlength="50"
            >
          </label>

          <label>
            אימייל
            <input
              type="email"
              name="email"
              maxlength="254"
            >
          </label>

          <label class="full-width">
            הערות
            <textarea
              name="notes"
              rows="3"
              maxlength="2000"
            ></textarea>
          </label>

          <button type="submit">
            שמירת בעלים
          </button>
        </form>
      </details>

      <% if (owners.length > 0) { %>
        <div style="margin-top:24px;" class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>שם הבעלים</th>
                <th>טלפון</th>
                <th>אימייל</th>
                <th>הערות</th>
              </tr>
            </thead>

            <tbody>
              <% owners.forEach(owner => { %>
                <tr>
                  <td><strong><%= owner.name %></strong></td>
                  <td><%= owner.phone || '—' %></td>
                  <td><%= owner.email || '—' %></td>
                  <td><%= owner.notes || '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
        <section class="owner-management">

      <h2>ניהול יחידות</h2>

      <p class="muted">
        הוסף משרדים בקומות 4 ו־6,
        והגדר את סוג הבעלות של כל יחידה.
      </p>

      <details>
        <summary style="cursor:pointer; font-weight:700;">
          + הוספת יחידה חדשה
        </summary>

        <form
          method="POST"
          action="/admin/units/create"
          class="owner-form"
        >

          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >

          <label>
            קומה *
            <select name="floor" required>
              <option value="">בחר קומה</option>
              <option value="4">קומה 4</option>
              <option value="6">קומה 6</option>
            </select>
          </label>

          <label>
            מספר יחידה *
            <input
              type="text"
              name="unit_number"
              maxlength="30"
              placeholder="לדוגמה: 12"
              required
            >
          </label>

          <label>
            סוג בעלות *
            <select
              name="ownership_type"
              id="unitOwnershipType"
              required
            >
              <option value="external">
                בעלות חיצונית
              </option>

              <option value="alonspace">
                בבעלות AlonSpace
              </option>
            </select>
          </label>

          <label id="unitOwnerField">
            בעל היחידה *
            <select
              name="owner_id"
              id="unitOwnerSelect"
              required
            >
              <option value="">
                בחר בעלים
              </option>

              <% owners.forEach(owner => { %>
                <option value="<%= owner.id %>">
                  <%= owner.name %>
                </option>
              <% }); %>
            </select>
          </label>

          <label class="full-width">
            הערות
            <textarea
              name="notes"
              rows="3"
              maxlength="2000"
              placeholder="הערות על היחידה (לא חובה)"
            ></textarea>
          </label>

          <button type="submit">
            שמירת יחידה
          </button>

        </form>
      </details>

    </section>

    <script>
      (() => {
        const ownershipSelect =
          document.getElementById('unitOwnershipType');

        const ownerField =
          document.getElementById('unitOwnerField');

        const ownerSelect =
          document.getElementById('unitOwnerSelect');

        function updateOwnerField() {
          const isExternal =
            ownershipSelect.value === 'external';

          ownerField.hidden = !isExternal;
          ownerSelect.disabled = !isExternal;
          ownerSelect.required = isExternal;

          if (!isExternal) {
            ownerSelect.value = '';
          }
        }

        ownershipSelect.addEventListener(
          'change',
          updateOwnerField
        );

        updateOwnerField();
      })();
    </script>
    <div class="stats">

      <div class="stat-card">
        <div class="stat-label">
          יחידות פעילות
        </div>
        <div class="stat-value">
          <%= activeUnits.length %>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-label">
          יחידות מושכרות
        </div>
        <div class="stat-value">
          <%= occupiedUnits.length %>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-label">
          יחידות בבעלות AlonSpace
        </div>
        <div class="stat-value">
          <%= ownedUnits.length %>
        </div>
      </div>

    </div>

    <% [4, 6].forEach(floor => { %>

      <%
        const floorUnits = units.filter(
          unit => Number(unit.floor) === floor
        );
      %>

      <section class="floor-section">

        <div class="floor-heading">
          <h2>קומה <%= floor %></h2>
          <span class="muted">
            <%= floorUnits.length %> יחידות
          </span>
        </div>

        <% if (floorUnits.length === 0) { %>

          <div class="empty">
            עדיין לא הוגדרו יחידות בקומה זו.
          </div>

        <% } else { %>

          <div class="table-wrap">
            <table>

              <thead>
                <tr>
                  <th>יחידה</th>
                  <th>בעלות</th>
                  <th>בעלים</th>
                  <th>שוכר ראשי</th>
                  <th>מודל השכרה</th>
                  <th>מצב</th>
                </tr>
              </thead>

              <tbody>

                <% floorUnits.forEach(unit => { %>

                  <tr>

                    <td>
                      <strong>
                        <%= unit.unit_number %>
                      </strong>
                    </td>

                    <td>
                      <%= unit.ownership_type === 'alonspace'
                        ? 'AlonSpace'
                        : 'בעלות חיצונית' %>
                    </td>

                    <td>
                      <%= unit.ownership_type === 'alonspace'
                        ? 'AlonSpace'
                        : (unit.owner_name || 'לא הוגדר') %>
                    </td>

                    <td>
                      <%= unit.tenant_name || '—' %>

                      <% if (unit.tenant_business_name) { %>
                        <div class="muted">
                          <%= unit.tenant_business_name %>
                        </div>
                      <% } %>
                    </td>

                    <td>
                      <%= rentalModelNames[unit.rental_model]
                        || 'לא הוגדר' %>
                    </td>

                    <td>
                      <% if (!unit.is_active) { %>
                        <span class="pill">
                          לא פעילה
                        </span>
                      <% } else if (unit.tenancy_id) { %>
                        <span class="pill occupied">
                          מושכרת
                        </span>
                      <% } else { %>
                        <span class="pill vacant">
                          פנויה
                        </span>
                      <% } %>
                    </td>

                  </tr>

                <% }); %>

              </tbody>
            </table>
          </div>

        <% } %>

      </section>

    <% }); %>

  </main>
</body>
</html>