<!DOCTYPE html>
<html lang="he" dir="rtl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="/css/style.css">

  <style>
    body {
      background: var(--stone);
    }

    .admin-header {
      background: var(--ink);
      color: var(--cream);
      padding: 18px 0;
    }

    .admin-header .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .admin-wrap {
      padding: 40px 0;
    }

    .stat-cards {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      margin-bottom: 36px;
    }

    .stat-card {
      background: var(--cream);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow);
    }

    .stat-card .n {
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: 700;
      color: var(--oak-dark);
    }

    .stat-card .l {
      font-size: .85rem;
      color: var(--ink-soft);
    }

    .tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--stone-dark);
      flex-wrap: wrap;
    }

    .tab-btn {
      padding: 12px 18px;
      background: none;
      border: none;
      font-weight: 600;
      color: var(--ink-soft);
      border-bottom: 2px solid transparent;
    }

    .tab-btn.active {
      color: var(--ink);
      border-color: var(--oak);
    }

    .tab-panel {
      display: none;
    }

    .tab-panel.active {
      display: block;
    }

    .admin-card {
      background: var(--cream);
      border-radius: var(--radius-lg);
      padding: 24px;
      box-shadow: var(--shadow);
      margin-bottom: 24px;
    }

    .admin-collapse {
      margin-bottom: 20px;
    }

    .admin-collapse>summary {
      cursor: pointer;
      background: var(--cream);
      padding: 16px 20px;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
      font-weight: 700;
      list-style: none;
    }

    .admin-collapse>summary::-webkit-details-marker {
      display: none;
    }

    .admin-collapse>summary::before {
      content: "▾";
      display: inline-block;
      margin-left: 8px;
      transition: transform .2s ease;
    }

    .admin-collapse[open]>summary::before {
      transform: rotate(180deg);
    }

    .admin-collapse[open]>summary {
      margin-bottom: 12px;
    }

    .table-wrap {
      width: 100%;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: var(--cream);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    th,
    td {
      padding: 12px 14px;
      text-align: right;
      font-size: .88rem;
      border-bottom: 1px solid var(--stone-dark);
      vertical-align: top;
    }

    th {
      background: var(--stone-dark);
      white-space: nowrap;
    }

    .row-actions {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .mini-btn {
      font-size: .78rem;
      padding: 6px 10px;
      border-radius: 6px;
      border: 1px solid var(--stone-dark);
      background: var(--cream);
    }

    .mini-btn.primary {
      background: var(--ink);
      color: var(--cream);
      border-color: var(--ink);
    }

    .mini-btn.danger {
      border-color: #c76c6c;
      color: #9c3b3b;
    }

    .pill {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: .75rem;
      font-weight: 700;
    }

    .pill.ok {
      background: #dce7d6;
      color: #3a5c33;
    }

    .pill.warn {
      background: #f3e3c4;
      color: #8a6a1f;
    }

    .pill.bad {
      background: #f1d4d4;
      color: #9c3b3b;
    }

    .inline-form {
      display: grid;
      gap: 8px;
      min-width: 190px;
    }

    .inline-form input,
    .inline-form select {
      width: 100%;
      padding: 7px 9px;
      border: 1px solid var(--stone-dark);
      border-radius: 6px;
    }

    .meeting-calendar-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      margin: 18px 0;
    }

    .calendar-navigation {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .weekly-calendar-wrap {
      overflow-x: auto;
      background: var(--cream);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
      margin-bottom: 24px;
    }

    .weekly-calendar {
      display: grid;
      grid-template-columns: 70px repeat(7, minmax(125px, 1fr));
      min-width: 980px;
      position: relative;
    }

    .calendar-corner,
    .calendar-day-header,
    .calendar-time-label,
    .calendar-slot {
      border-left: 1px solid var(--stone-dark);
      border-bottom: 1px solid var(--stone-dark);
    }

    .calendar-corner {
      min-height: 70px;
      background: var(--stone-dark);
    }

    .calendar-day-header {
      min-height: 70px;
      padding: 10px;
      text-align: center;
      background: var(--stone-dark);
      position: sticky;
      top: 0;
      z-index: 5;
    }

    .calendar-day-header.today {
      background: #f8f6ff;
    }

    .calendar-day-header.today::after {
      content: "";

      position: absolute;

      bottom: 0;
      left: 22%;
      right: 22%;

      height: 3px;

      border-radius: 10px 10px 0 0;

      background: #7865f6;
    }

    .calendar-day-name {
      display: block;
      font-weight: 700;
    }

    .calendar-day-date {
      display: block;
      margin-top: 4px;
      font-size: .8rem;
      color: var(--ink-soft);
    }

    .calendar-time-label {
      height: 48px;
      padding: 5px 8px;
      font-size: .75rem;
      color: var(--ink-soft);
      background: var(--stone);
      text-align: center;
    }

    .calendar-slot {
      height: 48px;
      position: relative;
      background: var(--cream);
      cursor: pointer;
      transition: background .15s ease;
    }

    .calendar-slot:not(.past):hover {
      background: #faf9ff;
    }

    .calendar-slot.past {
      background: #eceae4;
      cursor: not-allowed;
    }

    .calendar-slot.selected-start {
      background: #e8d49a;
      box-shadow: inset 0 0 0 2px var(--oak-dark);
    }

    .calendar-slot.selected-range {
      background: #f3e7bd;
    }

    .calendar-booking {
      position: absolute;
      inset: 3px;
      z-index: 3;
      padding: 5px 7px;
      border-radius: 7px;
      background: #e7e3ff;
      color: #302a65;

      box-shadow:
        inset 3px 0 0 #7865f6,
        0 2px 7px rgba(30, 28, 55, 0.05);
      font-size: .72rem;
      line-height: 1.25;
      overflow: hidden;
      cursor: default;
    }

    .calendar-booking strong {
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .clients-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .client-card summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .client-card .admin-card {
      margin-top: 14px;
    }

    @media (max-width:900px) {
      .stat-cards {
        grid-template-columns: 1fr;
      }

      .admin-header .container {
        align-items: flex-start;
        flex-direction: column;
      }
    }

    .quota-alerts-section {
      margin-bottom: 32px;
    }

    .quota-alerts-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;

      margin-bottom: 14px;
    }

    .quota-alerts-heading h2 {
      margin: 5px 0 0;
    }

    .quota-alert-label {
      font-size: .78rem;
      font-weight: 800;
      color: #9c3b3b;
    }

    .quota-alert-count {
      min-width: 38px;
      height: 38px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;

      background: #9c3b3b;
      color: #fff;

      font-weight: 800;
    }

    .quota-alerts-list {
      display: grid;
      gap: 14px;
    }

    .quota-admin-alert {
      background: #fff8e8;

      border: 1px solid #dfc684;
      border-right: 5px solid #c59631;

      border-radius: var(--radius-lg);

      padding: 20px;

      box-shadow: var(--shadow);
    }

    .quota-admin-alert.chargeable {
      background: #fff0f0;
      border-color: #df9c9c;
      border-right-color: #b74343;
    }

    .quota-admin-alert-main {
      display: flex;
      align-items: center;
      gap: 14px;

      margin-bottom: 18px;
    }

    .quota-admin-alert-icon {
      width: 42px;
      height: 42px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;

      background: #c59631;
      color: #fff;

      font-size: 1.3rem;
      font-weight: 900;
    }

    .quota-admin-alert.chargeable .quota-admin-alert-icon {
      background: #b74343;
    }

    .quota-admin-alert-title {
      color: #9c6c17;
      font-size: .8rem;
      font-weight: 800;
    }

    .quota-admin-alert.chargeable .quota-admin-alert-title {
      color: #a32f2f;
    }

    .quota-admin-alert h3 {
      margin: 3px 0;
    }

    .quota-admin-numbers {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;

      margin-bottom: 18px;
    }

    .quota-admin-numbers>div {
      background: rgba(255, 255, 255, .65);
      border-radius: 9px;
      padding: 12px;
    }

    .quota-admin-numbers span {
      display: block;
      margin-bottom: 3px;

      font-size: .75rem;
      color: var(--ink-soft);
    }

    .quota-admin-numbers strong {
      font-size: 1rem;
    }

    .quota-admin-status {
      display: grid;
      gap: 4px;

      padding-top: 14px;
      border-top: 1px solid rgba(0, 0, 0, .1);
    }

    .quota-admin-status span {
      font-size: .85rem;
      color: var(--ink-soft);
    }

    .quota-admin-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;

      margin-top: 16px;
    }

    .quota-admin-actions a {
      text-decoration: none;
    }

    @media (max-width: 700px) {
      .quota-admin-numbers {
        grid-template-columns: 1fr;
      }
    }

    /* =====================================
   ADMIN BOOKING POPUP
===================================== */

    .booking-popup-overlay {
      position: fixed;
      inset: 0;

      display: none;
      align-items: center;
      justify-content: center;

      padding: 20px;

      background: rgba(18, 18, 30, .48);

      z-index: 99999;
    }

    .booking-popup-overlay.open {
      display: flex;
    }

    .booking-popup {
      width: min(480px, 100%);

      max-height: calc(100vh - 40px);
      overflow-y: auto;

      background: var(--cream);

      border-radius: 22px;

      padding: 24px;

      box-shadow:
        0 20px 60px rgba(0, 0, 0, .22);
    }

    .booking-popup-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;

      gap: 20px;

      margin-bottom: 18px;
    }

    .booking-popup-head h3 {
      margin: 4px 0 0;
    }

    .booking-popup-close {
      width: 38px;
      height: 38px;

      border: 0;
      border-radius: 50%;

      background: var(--stone);

      font-size: 1.5rem;
      line-height: 1;

      cursor: pointer;
    }

    .booking-popup-time {
      display: grid;
      gap: 5px;

      margin-bottom: 20px;
      padding: 14px 16px;

      background: var(--stone);

      border-radius: 12px;
    }

    .booking-popup-actions {
      display: flex;
      justify-content: flex-end;

      gap: 10px;

      margin-top: 8px;
    }


    @media (max-width: 700px) {

      .booking-popup-overlay {
        align-items: flex-end;

        padding: 0;
      }

      .booking-popup {
        width: 100%;

        max-height: 88vh;

        border-radius: 22px 22px 0 0;

        padding:
          22px 18px calc(22px + env(safe-area-inset-bottom));
      }

      .booking-popup-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }

      .booking-popup-actions .btn {
        width: 100%;
      }
    }
    /* =====================================
   ADMIN CALENDAR - FINAL DESIGN
   זהה לעיצוב לוח הדייר
===================================== */

#adminWeeklyCalendar {
  background: #ffffff;
}


/* כותרות ימים */

#adminWeeklyCalendar .calendar-corner,
#adminWeeklyCalendar .calendar-day-header {
  background: #fbfaff;

  border-left:
    1px solid rgba(45, 40, 80, 0.055);

  border-bottom:
    1px solid rgba(45, 40, 80, 0.07);
}


#adminWeeklyCalendar .calendar-day-header {
  color: #151522;
}


#adminWeeklyCalendar .calendar-day-name {
  color: #151522;

  font-size: 1rem;
  font-weight: 800;
}


#adminWeeklyCalendar .calendar-day-date {
  color: #777589;

  font-size: .82rem;
  font-weight: 500;
}


/* היום הנוכחי */

#adminWeeklyCalendar .calendar-day-header.today {
  background: #f8f6ff;
}


#adminWeeklyCalendar
.calendar-day-header.today::after {
  content: "";

  position: absolute;

  bottom: 0;
  left: 22%;
  right: 22%;

  height: 3px;

  border-radius: 10px 10px 0 0;

  background: #7865f6;
}


/* עמודת שעות */

#adminWeeklyCalendar .calendar-time-label {
  background: #fcfbff;

  color: #747287;

  border-left:
    1px solid rgba(45, 40, 80, 0.055);

  border-bottom:
    1px solid rgba(45, 40, 80, 0.045);
}


/* משבצות */

#adminWeeklyCalendar .calendar-slot {
  background: #ffffff;

  border-left:
    1px solid rgba(45, 40, 80, 0.04);

  border-bottom:
    1px solid rgba(45, 40, 80, 0.045);
}


#adminWeeklyCalendar
.calendar-slot:not(.past):hover {
  background: #faf9ff;
}


/* עבר */

#adminWeeklyCalendar .calendar-slot.past {
  background: #f8f8fa;
}


/* בחירת טווח */

#adminWeeklyCalendar
.calendar-slot.selected-start,
#adminWeeklyCalendar
.calendar-slot.selected-range {
  background: #ebe8ff;
}


#adminWeeklyCalendar
.calendar-slot.selected-start {
  box-shadow:
    inset 3px 0 0 #7865f6;
}


/* שריונים */

#adminWeeklyCalendar .calendar-booking {
  background: #e7e3ff;

  color: #302a65;

  border: 0;

  box-shadow:
    inset 3px 0 0 #7865f6,
    0 2px 7px rgba(30, 28, 55, 0.05);
}
.tabs {
  position: relative;
  z-index: 30;
}

.tab-btn {
  position: relative;
  z-index: 31;
  pointer-events: auto;
}
.booking-popup-time-editor {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;

  margin-top: 12px;
}

.booking-popup-time-editor select {
  appearance: none;
  -webkit-appearance: none;

  width: auto;

  padding: 3px 6px;

  border: 0;
  border-bottom: 1px dashed rgba(30, 30, 45, .3);

  background: transparent;

  color: inherit;

  font: inherit;
  font-size: 1.15rem;
  font-weight: 800;

  cursor: pointer;
}

.booking-popup-time-editor select:focus {
  outline: none;
  border-bottom-color: #7865f6;
}

.booking-time-separator {
  opacity: .55;
  font-size: 1.2rem;
}
/* =====================================
   CLIENT DETAILS
===================================== */

.client-details-card {
  margin-top: 14px;
  padding: 22px;
}

.client-details-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18px;
  flex-wrap: wrap;
  margin-bottom: 22px;
}

.client-details-header h3 {
  margin: 0 0 5px;
}

.client-details-meta {
  color: var(--ink-soft);
  font-size: .85rem;
}

.client-usage-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 22px;
}

.client-usage-box {
  background: var(--stone);
  border-radius: 12px;
  padding: 16px;
}

.client-usage-box span {
  display: block;
  color: var(--ink-soft);
  font-size: .78rem;
  margin-bottom: 5px;
}

.client-usage-box strong {
  display: block;
  font-size: 1.35rem;
}

.client-info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0 28px;
  margin-bottom: 20px;
}

.client-info-row {
  display: flex;
  justify-content: space-between;
  gap: 15px;

  padding: 11px 0;

  border-bottom:
    1px solid var(--stone-dark);
}

.client-info-label {
  color: var(--ink-soft);
  font-size: .85rem;
}

.client-info-value {
  font-weight: 600;
  text-align: left;
}

.client-edit-section {
  margin-top: 18px;
  border-top: 1px solid var(--stone-dark);
  padding-top: 18px;
}

.client-edit-section > summary {
  cursor: pointer;
  list-style: none;

  display: inline-flex;
  align-items: center;
  gap: 7px;

  font-weight: 700;
}

.client-edit-section > summary::-webkit-details-marker {
  display: none;
}

.client-edit-section > summary::before {
  content: "✎";
}

.client-edit-form {
  margin-top: 18px;
  max-width: 650px;
}

.client-danger-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;

  margin-top: 22px;
  padding-top: 18px;

  border-top: 1px solid var(--stone-dark);
}

@media (max-width: 700px) {
  .client-usage-grid,
  .client-info-grid {
    grid-template-columns: 1fr;
  }
}
.client-details-popup {
  width: min(620px, 100%);
}

.client-bookings-section {
  margin-top: 24px;
}

.client-bookings-section h4 {
  margin: 0 0 10px;
}

.client-bookings-list {
  display: grid;
  gap: 8px;
}

.client-booking-item {
  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 14px;

  padding: 11px 13px;

  border-radius: 9px;

  background: var(--stone);
}

.client-booking-main {
  display: grid;
  gap: 3px;
}

.client-booking-date {
  font-weight: 700;
}

.client-booking-time {
  font-size: .82rem;
  color: var(--ink-soft);
}

.client-booking-room {
  font-size: .78rem;
  color: var(--ink-soft);
}

.client-bookings-empty {
  padding: 14px;

  border-radius: 9px;

  background: var(--stone);

  color: var(--ink-soft);

  font-size: .85rem;
}
/* =====================================
   RENTAL ALERTS COLLAPSE
===================================== */

.rental-alerts-collapse {
  margin-bottom: 28px;
}

.rental-alerts-collapse > summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;

  padding: 16px 20px;

  background: var(--cream);
  border-radius: var(--radius-lg);

  box-shadow: var(--shadow);

  cursor: pointer;
  list-style: none;
}

.rental-alerts-collapse > summary::-webkit-details-marker {
  display: none;
}

.rental-alerts-summary > div {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.rental-alert-label {
  font-size: .75rem;
  font-weight: 800;

  color: #8a6a1f;

  background: #f3e3c4;

  padding: 4px 9px;
  border-radius: 20px;
}

.rental-alert-count {
  min-width: 32px;
  height: 32px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #8a6a1f;
  color: white;

  border-radius: 50%;

  font-size: .8rem;
  font-weight: 800;
}

.rental-alerts-content {
  display: grid;
  gap: 12px;

  margin-top: 12px;
}
  </style>
</head>

<body>
  <header class="admin-header">
    <div class="container">
      <strong>פאנל ניהול AlonSpace</strong>

      <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
        <span>שלום, <%= adminName %></span>
        <a href="/" target="_blank" class="btn btn-outline-light" style="padding:8px 16px;">
          צפייה באתר
        </a>
        <a href="/admin/analytics" class="btn btn-outline-light" style="padding:8px 16px;">
          מעקבי נתונים
        </a>
        <form method="POST" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <button type="submit">
            התנתקות
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="container admin-wrap">
    <% if (error) { %>
      <div class="form-msg show err">
        <%= error %>
      </div>
      <% } %>

        <% if (success) { %>
          <div class="form-msg show ok">
            <%= success %>
          </div>
          <% } %>
            <% if (quotaAlerts && quotaAlerts.length) { %>

              <section class="quota-alerts-section">

                <div class="quota-alerts-heading">
                  <div>
                    <span class="quota-alert-label">דורש טיפול</span>
