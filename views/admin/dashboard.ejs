    function filterAdminBookingTable(roomFloor) {
      meetingBookingRows.forEach((row) => {
        row.style.display =
          String(row.dataset.roomFloor) ===
            String(roomFloor)
            ? ''
            : 'none';
      });
    }


    /* =========================
       ציור הלוח
    ========================= */

    function renderAdminCalendar() {
      if (!adminCalendar || !adminWeekTitle) {
        return;
      }

      clearAdminCalendarSelection();
      adminCalendar.innerHTML = '';

      const weekEnd = addAdminDays(
        adminDisplayedWeekStart,
        6
      );

      adminWeekTitle.textContent =
        adminDisplayedWeekStart.toLocaleDateString(
          'he-IL',
          {
            day: 'numeric',
            month: 'long',
          }
        ) +
        ' – ' +
        weekEnd.toLocaleDateString(
          'he-IL',
          {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          }
        );

      const corner = document.createElement('div');
      corner.className = 'calendar-corner';

      adminCalendar.appendChild(corner);

      const todayKey = adminDateKey(new Date());

      for (
        let dayIndex = 0;
        dayIndex < 7;
        dayIndex += 1
      ) {
        const day = addAdminDays(
          adminDisplayedWeekStart,
          dayIndex
        );

        const header =
          document.createElement('div');

        header.className = 'calendar-day-header';

        if (adminDateKey(day) === todayKey) {
          header.classList.add('today');
        }

        header.innerHTML = `
        <span class="calendar-day-name">
          ${adminDayNames[dayIndex]}
        </span>

        <span class="calendar-day-date">
          ${day.toLocaleDateString('he-IL', {
          day: '2-digit',
          month: '2-digit',
        })}
        </span>
      `;

        adminCalendar.appendChild(header);
      }

      for (
        let minutes = adminCalendarStartHour * 60;
        minutes < adminCalendarEndHour * 60;
        minutes += adminSlotMinutes
      ) {
        const timeLabel =
          document.createElement('div');

        timeLabel.className =
          'calendar-time-label';

        timeLabel.textContent =
          adminMinutesToTime(minutes);

        adminCalendar.appendChild(timeLabel);

        for (
          let dayIndex = 0;
          dayIndex < 7;
          dayIndex += 1
        ) {
          const day = addAdminDays(
            adminDisplayedWeekStart,
            dayIndex
          );

          const currentDateKey =
            adminDateKey(day);

          const slot =
            document.createElement('div');

          slot.className = 'calendar-slot';
          slot.dataset.date = currentDateKey;
          slot.dataset.startMinutes =
            String(minutes);

          const past =
            isAdminPastSlot(day, minutes);

          if (past) {

            slot.classList.add('past');

          } else {

            /*
              MOBILE / TOUCH:
              לחיצה אחת פותחת שריון של חצי שעה.
              משם משנים שעת סיום ב-popup.
            */

            slot.addEventListener(
              'click',
              (event) => {

                if (
                  window.matchMedia(
                    '(max-width: 900px)'
                  ).matches
                ) {
                  event.preventDefault();

                  finishAdminCalendarRange(
                    currentDateKey,
                    minutes,
                    minutes
                  );
                }
              }
            );


            /*
              DESKTOP:
              Google Calendar style drag.
            */

            slot.addEventListener(
              'mousedown',
              (event) => {

                if (
                  window.matchMedia(
                    '(max-width: 900px)'
                  ).matches
                ) {
                  return;
                }


                if (event.button !== 0) {
                  return;
                }


                event.preventDefault();


                isAdminCalendarDragging = true;

                adminDragMoved = false;


                adminDragStartSlot = {
                  date: currentDateKey,
                  minutes,
                  element: slot,
                };


                adminDragCurrentSlot =
                  adminDragStartSlot;


                clearAdminCalendarSelection();

                slot.classList.add(
                  'selected-start'
                );
              }
            );


            slot.addEventListener(
              'mouseenter',
              () => {

                if (
                  window.matchMedia(
                    '(max-width: 900px)'
                  ).matches
                ) {
                  return;
                }


                if (
                  !isAdminCalendarDragging ||
                  !adminDragStartSlot
                ) {
                  return;
                }


                if (
                  adminDragStartSlot.date !==
                  currentDateKey
                ) {
                  return;
                }


                if (
                  minutes !==
                  adminDragStartSlot.minutes
                ) {
                  adminDragMoved = true;
                }


                adminDragCurrentSlot = {
                  date: currentDateKey,
                  minutes,
                  element: slot,
                };


                const rangeStart =
                  Math.min(
                    adminDragStartSlot.minutes,
                    minutes
                  );

                const rangeEnd =
                  Math.max(
                    adminDragStartSlot.minutes,
                    minutes
                  ) + adminSlotMinutes;


                clearAdminCalendarSelection();

                highlightAdminRange(
                  currentDateKey,
                  rangeStart,
                  rangeEnd
                );
              }
            );
          }
          const booking =
            adminMeetingBookings.find((item) => {
              const bookingStart =
                adminTimeToMinutes(
                  item.start_time
                );

              const bookingEnd =
                adminTimeToMinutes(
                  item.end_time
                );

              return (
                getBookingRoomFloor(item) ===
                Number(selectedAdminRoomFloor) &&
                normalizeAdminBookingDate(
                  item.booking_date
                ) === currentDateKey &&
                bookingStart !== null &&
                bookingEnd !== null &&
                bookingStart <= minutes &&
                bookingEnd > minutes
              );
            });

          if (
            booking &&
            adminTimeToMinutes(
              booking.start_time
            ) === minutes
          ) {
            const bookingElement =
              document.createElement('div');

            bookingElement.className =
              'calendar-booking';

            bookingElement.dataset.userId =
  String(booking.user_id);

bookingElement.style.cursor =
  'pointer';
bookingElement.addEventListener(
  'mousedown',
  (event) => {
    event.stopPropagation();
  }
);
  bookingElement.addEventListener(

  'click',
  (event) => {
    event.stopPropagation();

    openAdminClientDetails(
      booking.user_id
    );
  }
);

            const durationMinutes =
              adminTimeToMinutes(
                booking.end_time
              ) -
              adminTimeToMinutes(
                booking.start_time
              );

            const slotCount = Math.max(
              1,
              durationMinutes / adminSlotMinutes
            );

            bookingElement.style.height =
              `calc(${slotCount * 48}px - 6px)`;

            bookingElement.innerHTML = `
            <strong>
              ${booking.display_name || 'שריון'}
            </strong>

            ${normalizeAdminTime(
              booking.start_time
            )}
            –
            ${normalizeAdminTime(
              booking.end_time
            )}

            <br>

            משרד ${booking.office_number || '-'}
          `;

            bookingElement.title =
              `${booking.display_name || 'שריון'}\n` +
              `${normalizeAdminTime(
                booking.start_time
              )}–${normalizeAdminTime(
                booking.end_time
              )}\n` +
              `${booking.note || ''}`;

            slot.appendChild(bookingElement);
          }

          adminCalendar.appendChild(slot);
        }
      }
    }


    document.addEventListener(
      'mouseup',
      () => {
        if (
          window.matchMedia(
            '(max-width: 900px)'
          ).matches
        ) {
          return;
        }
        if (
          !isAdminCalendarDragging ||
          !adminDragStartSlot
        ) {
          return;
        }

        isAdminCalendarDragging = false;

        const start =
          adminDragStartSlot;

        const end =
          adminDragCurrentSlot ||
          adminDragStartSlot;

        if (start.date !== end.date) {
          clearAdminCalendarSelection();

          adminDragStartSlot = null;
          adminDragCurrentSlot = null;
          adminDragMoved = false;

          return;
        }

        finishAdminCalendarRange(
          start.date,
          start.minutes,
          end.minutes
        );

        adminDragStartSlot = null;
        adminDragCurrentSlot = null;
        adminDragMoved = false;
      }
    );

    /* =========================
       בחירת טווח בלוח
    

    function handleAdminSlotClick(
