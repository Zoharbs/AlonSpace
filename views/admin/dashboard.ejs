    document.getElementById(
    'adminPopupStartTime'
  );
    const adminBookingPopupOverlay =
      document.getElementById(
        'adminBookingPopupOverlay'
      );

    const adminBookingPopupClose =
      document.getElementById(
        'adminBookingPopupClose'
      );

    const adminBookingPopupCancel =
      document.getElementById(
        'adminBookingPopupCancel'
      );

    const adminBookingPopupDate =
      document.getElementById(
        'adminBookingPopupDate'
      );

    const adminBookingPopupTime =
      document.getElementById(
        'adminBookingPopupTime'
      );

    const adminSelectedBookingRange =
      document.getElementById(
        'adminSelectedBookingRange'
      );
    const roomFilterButtons =
      document.querySelectorAll('.room-filter-btn');

    const meetingBookingRows =
      document.querySelectorAll('.meeting-booking-row');


    /* =========================
       הגדרות לוח
    ========================= */

    const adminDayNames = [
      'ראשון',
      'שני',
      'שלישי',
      'רביעי',
      'חמישי',
      'שישי',
      'שבת',
    ];

    const adminCalendarStartHour = 8;
    const adminCalendarEndHour = 21;
    const adminSlotMinutes = 30;

    let adminDisplayedWeekStart =
      getAdminStartOfWeek(new Date());

    let adminSelectedStartSlot = null;

    let isAdminCalendarDragging = false;
    let adminDragStartSlot = null;
    let adminDragCurrentSlot = null;
    let adminDragMoved = false;

    let selectedAdminRoomFloor =
      localStorage.getItem('adminMeetingRoomFloor') || '4';


    /* =========================
       פונקציות עזר
    ========================= */

    function getAdminStartOfWeek(date) {
      const result = new Date(date);

      result.setHours(0, 0, 0, 0);
      result.setDate(result.getDate() - result.getDay());

      return result;
    }

    function addAdminDays(date, amount) {
      const result = new Date(date);

      result.setDate(result.getDate() + amount);

      return result;
    }

    function adminDateKey(date) {
      const year = date.getFullYear();

      const month = String(
        date.getMonth() + 1
      ).padStart(2, '0');

      const day = String(
        date.getDate()
      ).padStart(2, '0');

      return `${year}-${month}-${day}`;
    }

    function normalizeAdminBookingDate(value) {
      if (!value) return '';

      const text = String(value);

      if (/^\d{4}-\d{2}-\d{2}/.test(text)) {
        return text.slice(0, 10);
      }

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) {
        return '';
      }

      return adminDateKey(date);
    }

    function normalizeAdminTime(value) {
      return String(value || '').slice(0, 5);
    }

    function adminTimeToMinutes(value) {
      const normalized = normalizeAdminTime(value);

      const match = /^(\d{2}):(\d{2})$/.exec(
        normalized
      );

      if (!match) {
        return null;
      }

      return (
        Number(match[1]) * 60 +
        Number(match[2])
      );
    }

    function adminMinutesToTime(minutes) {
      const hours = Math.floor(minutes / 60);
      const remainingMinutes = minutes % 60;

      return (
        String(hours).padStart(2, '0') +
        ':' +
        String(remainingMinutes).padStart(2, '0')
      );
    }

    function isAdminPastSlot(day, minutes) {
      const slotDate = new Date(day);

      slotDate.setHours(
        Math.floor(minutes / 60),
        minutes % 60,
        0,
        0
      );

      return slotDate <= new Date();
    }

    function getBookingRoomFloor(booking) {
      return Number(
        booking.meeting_room_floor ||
        booking.room_floor ||
        booking.floor
      );
    }

function syncAdminRoomSelect(roomFloor) {
  if (!adminRoomSelect) {
    return;
  }

  const adminMeetingRooms =
    <%- JSON.stringify(meetingRooms || []).replace(/</g, '\\u003c') %>;

  const room = adminMeetingRooms.find(
    (item) =>
      String(item.floor) === String(roomFloor)
  );

  if (room) {
    adminRoomSelect.value = room.id;
  }
}

    function clearAdminCalendarSelection() {
      adminSelectedStartSlot = null;

      document
        .querySelectorAll(
          '#adminWeeklyCalendar .selected-start,' +
          '#adminWeeklyCalendar .selected-range'
        )
        .forEach((item) => {
          item.classList.remove(
            'selected-start',
            'selected-range'
          );
        });
    }

    function highlightAdminRange(
      date,
      startMinutes,
      endMinutes
    ) {
      document
        .querySelectorAll(
          `#adminWeeklyCalendar ` +
          `.calendar-slot[data-date="${date}"]`
        )
        .forEach((item) => {
          const itemMinutes = Number(
            item.dataset.startMinutes
          );

          if (
            itemMinutes >= startMinutes &&
            itemMinutes < endMinutes
          ) {
            item.classList.add('selected-range');
          }
        });
    }

    function adminRangeHasBooking(
      date,
      startMinutes,
      endMinutes
    ) {
      return adminMeetingBookings.some((booking) => {
        if (
          getBookingRoomFloor(booking) !==
          Number(selectedAdminRoomFloor)
        ) {
          return false;
        }

        if (
          normalizeAdminBookingDate(
            booking.booking_date
          ) !== date
        ) {
          return false;
        }

        const bookingStart =
          adminTimeToMinutes(booking.start_time);

        const bookingEnd =
          adminTimeToMinutes(booking.end_time);

        if (
          bookingStart === null ||
          bookingEnd === null
        ) {
          return false;
        }

        return (
          startMinutes < bookingEnd &&
          endMinutes > bookingStart
        );
      });
    }


    function formatAdminSelectedDate(dateString) {
      const [year, month, day] =
        dateString.split('-').map(Number);

      const date =
        new Date(
          year,
          month - 1,
          day
        );

      return date.toLocaleDateString(
        'he-IL',
        {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
        }
      );
    }


    function fillAdminEndTimeOptions(
      date,
      startMinutes
    ) {
      if (!adminEndTimeInput) {
        return;
      }

      adminEndTimeInput.innerHTML = '';

      for (
        let endMinutes =
          startMinutes + adminSlotMinutes;

        endMinutes <=
        adminCalendarEndHour * 60;

        endMinutes += adminSlotMinutes
      ) {

        /*
          ברגע שפוגשים שריון קיים,
          לא מאפשרים לעבור דרכו.
        */

        if (
          adminRangeHasBooking(
            date,
            startMinutes,
            endMinutes
          )
        ) {
          break;
        }

        const option =
          document.createElement('option');

        option.value =
          adminMinutesToTime(endMinutes);

        option.textContent =
          adminMinutesToTime(endMinutes);

        adminEndTimeInput.appendChild(option);
      }
    }

    function fillAdminStartTimeOptions(
  date,
  selectedStartMinutes
) {
  if (!adminPopupStartTime) {
    return;
  }

  adminPopupStartTime.innerHTML = '';

  for (
    let minutes =
      adminCalendarStartHour * 60;

    minutes <
      adminCalendarEndHour * 60;

    minutes += adminSlotMinutes
  ) {
    const option =
      document.createElement('option');

    option.value =
      adminMinutesToTime(minutes);

    option.textContent =
      adminMinutesToTime(minutes);

    option.selected =
      minutes === selectedStartMinutes;

    adminPopupStartTime.appendChild(
      option
    );
  }
}

  function openAdminBookingPopup(
  date,
  startMinutes,
  endMinutes
) {
  if (
    !adminBookingPopupOverlay ||
    !adminBookingDateInput ||
    !adminStartTimeInput ||
    !adminEndTimeInput
  ) {
    console.error(
      'Admin booking popup elements are missing'
    );

    return;
  }

  adminBookingDateInput.value = date;

  adminStartTimeInput.value =
    adminMinutesToTime(startMinutes);

  // ממלא את בחירת שעת ההתחלה
  if (adminPopupStartTime) {
    fillAdminStartTimeOptions(
      date,
      startMinutes
    );

    adminPopupStartTime.value =
      adminMinutesToTime(startMinutes);
  }

  // ממלא שעות סיום אפשריות
  fillAdminEndTimeOptions(
    date,
    startMinutes
  );

  const wantedEnd =
    adminMinutesToTime(endMinutes);

  const endExists =
    Array.from(
      adminEndTimeInput.options
    ).some(
      option =>
        option.value === wantedEnd
    );

  if (endExists) {
    adminEndTimeInput.value =
      wantedEnd;
  }

  if (adminBookingPopupDate) {
    adminBookingPopupDate.textContent =
      formatAdminSelectedDate(date);
  }

  if (adminBookingPopupTime) {
    adminBookingPopupTime.textContent =
      `${adminMinutesToTime(startMinutes)}–` +
      `${adminEndTimeInput.value}`;
  }

  adminBookingPopupOverlay
    .classList.add('open');

  document.body.style.overflow =
    'hidden';
}

    function closeAdminBookingPopup(
      clearSelection = true
    ) {
      adminBookingPopupOverlay
        ?.classList.remove('open');

      document.body.style.overflow = '';

      if (clearSelection) {
        clearAdminCalendarSelection();
      }
    }


    adminPopupStartTime
  ?.addEventListener(
    'change',
    () => {

      const date =
        adminBookingDateInput.value;

      const newStartMinutes =
        adminTimeToMinutes(
          adminPopupStartTime.value
        );

      if (
        !date ||
        newStartMinutes === null
      ) {
        return;
      }

      adminStartTimeInput.value =
        adminMinutesToTime(
          newStartMinutes
        );

      fillAdminEndTimeOptions(
        date,
        newStartMinutes
      );

      /*
        ברירת מחדל:
        שעה אחת אחרי שעת ההתחלה.
      */
      const preferredEnd =
        newStartMinutes + 60;

      const preferredEndValue =
        adminMinutesToTime(
          preferredEnd
        );

      const preferredExists =
        Array
          .from(
            adminEndTimeInput.options
          )
          .some(
            option =>
              option.value ===
              preferredEndValue
          );

      if (preferredExists) {
        adminEndTimeInput.value =
          preferredEndValue;
      }

      const endMinutes =
        adminTimeToMinutes(
          adminEndTimeInput.value
        );

      clearAdminCalendarSelection();

      if (endMinutes !== null) {
        highlightAdminRange(
          date,
          newStartMinutes,
          endMinutes
        );
      }
    }
  );
    adminEndTimeInput
      ?.addEventListener(
        'change',
        () => {

          const date =
            adminBookingDateInput.value;

          const startMinutes =
            adminTimeToMinutes(
              adminStartTimeInput.value
            );

          const endMinutes =
            adminTimeToMinutes(
              adminEndTimeInput.value
            );


          if (
            !date ||
            startMinutes === null ||
            endMinutes === null
          ) {
            return;
          }


          clearAdminCalendarSelection();

          highlightAdminRange(
            date,
            startMinutes,
            endMinutes
          );


          adminBookingPopupTime.textContent =
            `${adminMinutesToTime(startMinutes)}–` +
            `${adminMinutesToTime(endMinutes)}`;
        }
      );

    adminBookingPopupClose
      ?.addEventListener(
        'click',
        () => {
          closeAdminBookingPopup();
        }
      );


    adminBookingPopupCancel
      ?.addEventListener(
        'click',
        () => {
          closeAdminBookingPopup();
        }
      );


    adminBookingPopupOverlay
      ?.addEventListener(
        'click',
        (event) => {

          if (
            event.target ===
            adminBookingPopupOverlay
          ) {
            closeAdminBookingPopup();
          }
        }
      );


    document.addEventListener(
      'keydown',
      (event) => {

        if (
          event.key === 'Escape' &&
          adminBookingPopupOverlay
            ?.classList.contains('open')
        ) {
          closeAdminBookingPopup();
        }
      }
    );

  function finishAdminCalendarRange(
  date,
  firstMinutes,
  lastMinutes
) {
  const startMinutes =
    Math.min(firstMinutes, lastMinutes);

  // לחיצה בודדת = שעה כברירת מחדל
  let endMinutes;

  if (firstMinutes === lastMinutes) {
    endMinutes = startMinutes + 60;
  } else {
    endMinutes =
      Math.max(firstMinutes, lastMinutes) +
      adminSlotMinutes;
  }

  // לא לעבור את סוף היום
  endMinutes = Math.min(
    endMinutes,
    adminCalendarEndHour * 60
  );

  // אם השעה המלאה נתקלת בשריון,
  // ננסה לפחות חצי שעה
  if (
    adminRangeHasBooking(
      date,
      startMinutes,
      endMinutes
    )
  ) {
    const halfHourEnd =
      startMinutes + adminSlotMinutes;

    if (
      !adminRangeHasBooking(
        date,
        startMinutes,
        halfHourEnd
      )
    ) {
      endMinutes = halfHourEnd;
    } else {
      clearAdminCalendarSelection();

      alert('השעה שבחרת כבר תפוסה.');

      return;
    }
  }

  clearAdminCalendarSelection();

  highlightAdminRange(
    date,
    startMinutes,
    endMinutes
  );

  adminSelectedStartSlot = null;

  openAdminBookingPopup(
    date,
    startMinutes,
    endMinutes
  );
}
    /* =========================
