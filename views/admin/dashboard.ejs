  <script>
    /* =========================
   ADMIN TABS
========================= */

function openAdminTab(tabName, updateHash = true) {

  const buttons =
    document.querySelectorAll('.tab-btn');

  const panels =
    document.querySelectorAll('.tab-panel');

  const targetButton =
    document.querySelector(
      `.tab-btn[data-tab="${tabName}"]`
    );

  const targetPanel =
    document.getElementById(
      `tab-${tabName}`
    );

  if (!targetButton || !targetPanel) {
    return;
  }

  buttons.forEach((button) => {
    button.classList.remove('active');
  });

  panels.forEach((panel) => {
    panel.classList.remove('active');
  });

  targetButton.classList.add('active');
  targetPanel.classList.add('active');

  if (updateHash) {
    history.replaceState(
      null,
      '',
      `#${tabName}`
    );
  }
}


document
  .querySelectorAll('.tab-btn')
  .forEach((button) => {

    button.addEventListener(
      'click',
      (event) => {

        event.preventDefault();

        openAdminTab(
          button.dataset.tab
        );
      }
    );
  });


/* פתיחת הטאב הנכון בטעינת העמוד */

const initialAdminTab =
  window.location.hash === '#meeting-room'
    ? 'meeting-room'
    : 'clients';

openAdminTab(
  initialAdminTab,
  false
);

    /* =========================
       נתוני השריונים
    ========================= */

    const adminMeetingBookings =
  <%- JSON.stringify(meetingBookings || []).replace(/</g, '\\u003c') %>;
const adminClients =
  <%- JSON.stringify(clients || []).replace(/</g, '\\u003c') %>;
    const adminCalendar =
      document.getElementById('adminWeeklyCalendar');

    const adminWeekTitle =
      document.getElementById('adminCalendarWeekTitle');

    const adminBookingForm =
      document.getElementById('adminMeetingBookingForm');
const adminClientDetailsOverlay =
  document.getElementById(
    'adminClientDetailsOverlay'
  );

const adminClientDetailsClose =
  document.getElementById(
    'adminClientDetailsClose'
  );

const adminClientDetailsName =
  document.getElementById(
    'adminClientDetailsName'
  );

const adminClientDetailsMeta =
  document.getElementById(
    'adminClientDetailsMeta'
  );

const adminClientTotalHours =
  document.getElementById(
    'adminClientTotalHours'
  );

const adminClientMonthHours =
  document.getElementById(
    'adminClientMonthHours'
  );

const adminClientRemainingHours =
  document.getElementById(
    'adminClientRemainingHours'
  );

const adminClientFutureBookings =
  document.getElementById(
    'adminClientFutureBookings'
  );

const adminClientPastBookings =
  document.getElementById(
    'adminClientPastBookings'
  );
  function formatClientBookingDate(value) {
  const normalized =
    normalizeAdminBookingDate(value);

  if (!normalized) {
    return '';
  }

  const [year, month, day] =
    normalized.split('-').map(Number);

  return new Date(
    year,
    month - 1,
    day
  ).toLocaleDateString(
    'he-IL',
    {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
    }
  );
}


function clientBookingTimestamp(booking) {
  const date =
    normalizeAdminBookingDate(
      booking.booking_date
    );

  const time =
    normalizeAdminTime(
      booking.start_time
    );

  if (!date || !time) {
    return 0;
  }

  return new Date(
    `${date}T${time}:00`
  ).getTime();
}


function renderClientBookingList(
  container,
  bookings
) {
  if (!container) {
    return;
  }

  container.innerHTML = '';

  if (!bookings.length) {
    container.innerHTML = `
      <div class="client-bookings-empty">
        אין שריונים להצגה
      </div>
    `;

    return;
  }

  bookings.forEach((booking) => {

    const item =
      document.createElement('div');

    item.className =
      'client-booking-item';

    item.innerHTML = `
      <div class="client-booking-main">

        <span class="client-booking-date">
          ${formatClientBookingDate(
            booking.booking_date
          )}
        </span>

        <span class="client-booking-time">
          ${normalizeAdminTime(
            booking.start_time
          )}
          –
          ${normalizeAdminTime(
            booking.end_time
          )}
        </span>

      </div>

      <span class="client-booking-room">
        ${booking.meeting_room_name || ''}
      </span>
    `;

    container.appendChild(item);
  });
}


function openAdminClientDetails(userId) {

  const client =
    adminClients.find(
      item =>
        Number(item.id) ===
        Number(userId)
    );

  if (!client) {
    return;
  }


  if (adminClientDetailsName) {
    adminClientDetailsName.textContent =
      client.display_name || 'לקוח';
  }


  if (adminClientDetailsMeta) {
    const parts = [];

    if (client.business_name) {
      parts.push(client.business_name);
    }

    if (client.office_number) {
      parts.push(
        `משרד ${client.office_number}`
      );
    }

    if (client.floor) {
      parts.push(
        `קומה ${client.floor}`
      );
    }

    adminClientDetailsMeta.textContent =
      parts.join(' · ');
  }


  if (adminClientTotalHours) {
    adminClientTotalHours.textContent =
      `${Number(
        client.total_meeting_hours || 0
      ).toFixed(1)} שעות`;
  }


  if (adminClientMonthHours) {
    adminClientMonthHours.textContent =
      `${Number(
        client.month_meeting_hours || 0
      ).toFixed(1)} שעות`;
  }


  if (adminClientRemainingHours) {
    adminClientRemainingHours.textContent =
      `${Number(
        client.remaining_meeting_hours || 0
      ).toFixed(1)} שעות`;
  }


  const clientBookings =
    adminMeetingBookings.filter(
      booking =>
        Number(booking.user_id) ===
        Number(userId)
    );


  const now = Date.now();


  const futureBookings =
    clientBookings
      .filter(
        booking =>
          clientBookingTimestamp(
            booking
          ) >= now
      )
      .sort(
        (a, b) =>
          clientBookingTimestamp(a) -
          clientBookingTimestamp(b)
      );


  const pastBookings =
    clientBookings
      .filter(
        booking =>
          clientBookingTimestamp(
            booking
          ) < now
      )
      .sort(
        (a, b) =>
          clientBookingTimestamp(b) -
          clientBookingTimestamp(a)
      );


  renderClientBookingList(
    adminClientFutureBookings,
    futureBookings
  );

  renderClientBookingList(
    adminClientPastBookings,
    pastBookings
  );


  adminClientDetailsOverlay
    ?.classList.add('open');

  document.body.style.overflow =
    'hidden';
}


function closeAdminClientDetails() {

  adminClientDetailsOverlay
    ?.classList.remove('open');

  document.body.style.overflow = '';
}


adminClientDetailsClose
  ?.addEventListener(
    'click',
    closeAdminClientDetails
  );


adminClientDetailsOverlay
  ?.addEventListener(
    'click',
    (event) => {

      if (
        event.target ===
        adminClientDetailsOverlay
      ) {
        closeAdminClientDetails();
      }
    }
  );
    const adminRoomSelect =
