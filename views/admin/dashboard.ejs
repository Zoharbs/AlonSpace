      });
    }

========================= */
    /* =========================
       החלפת חדר
    ========================= */

    function selectAdminRoom(roomFloor) {
      closeAdminBookingPopup();
      selectedAdminRoomFloor =
        String(roomFloor);

      localStorage.setItem(
        'adminMeetingRoomFloor',
        selectedAdminRoomFloor
      );

      roomFilterButtons.forEach((button) => {
        const active =
          String(button.dataset.roomFloor) ===
          selectedAdminRoomFloor;

        button.classList.toggle(
          'primary',
          active
        );

        button.classList.toggle(
          'active',
          active
        );
      });

      syncAdminRoomSelect(
        selectedAdminRoomFloor
      );

      filterAdminBookingTable(
        selectedAdminRoomFloor
      );

      renderAdminCalendar();
    }

    roomFilterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selectAdminRoom(
          button.dataset.roomFloor
        );
      });
    });


    /* =========================
       מעבר בין שבועות
    ========================= */

    document
      .getElementById('adminPreviousWeek')
      ?.addEventListener('click', () => {
        adminDisplayedWeekStart =
          addAdminDays(
            adminDisplayedWeekStart,
            -7
          );

        renderAdminCalendar();
      });

    document
      .getElementById('adminNextWeek')
      ?.addEventListener('click', () => {
        adminDisplayedWeekStart =
          addAdminDays(
            adminDisplayedWeekStart,
            7
          );

        renderAdminCalendar();
      });

    document
      .getElementById('adminCurrentWeek')
      ?.addEventListener('click', () => {
        adminDisplayedWeekStart =
          getAdminStartOfWeek(new Date());

        renderAdminCalendar();
      });


    /* =========================
       התאמת לקוח לחדר
    ========================= */


    let adminBookingSubmitting = false;

    adminBookingForm?.addEventListener('submit', (event) => {

      if (adminBookingSubmitting) {

        event.preventDefault();

        return;

      }

      adminBookingSubmitting = true;

      const submitButton =

        adminBookingForm.querySelector(

          'button[type="submit"]'

        );

      if (submitButton) {

        submitButton.disabled = true;

        submitButton.textContent = 'יוצר שריון...';

      }

    });

    /* =============================
           אתחול
        ========================= */

    if (
      selectedAdminRoomFloor !== '4' &&
      selectedAdminRoomFloor !== '6'
    ) {
      selectedAdminRoomFloor = '4';
    }

    selectAdminRoom(
      selectedAdminRoomFloor
    );
    
