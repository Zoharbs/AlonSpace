<!DOCTYPE html>
<html lang="he" dir="rtl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="/css/style.css">

  <style>
    body {
      background: var(--stone);
    }

    .admin-header {
      background: var(--ink);
      color: var(--cream);
      padding: 18px 0;
    }

    .admin-header .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .admin-wrap {
      padding: 40px 0;
    }

    .stat-cards {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      margin-bottom: 36px;
    }

    .stat-card {
      background: var(--cream);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow);
    }

    .stat-card .n {
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: 700;
      color: var(--oak-dark);
    }

    .stat-card .l {
      font-size: .85rem;
      color: var(--ink-soft);
    }

    .tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--stone-dark);
      flex-wrap: wrap;
    }

    .tab-btn {
      padding: 12px 18px;
      background: none;
      border: none;
      font-weight: 600;
      color: var(--ink-soft);
      border-bottom: 2px solid transparent;
    }

    .tab-btn.active {
      color: var(--ink);
      border-color: var(--oak);
    }

    .tab-panel {
      display: none;
    }

    .tab-panel.active {
      display: block;
    }

    .admin-card {
      background: var(--cream);
      border-radius: var(--radius-lg);
      padding: 24px;
      box-shadow: var(--shadow);
      margin-bottom: 24px;
    }

    .admin-collapse {
      margin-bottom: 20px;
    }

    .admin-collapse>summary {
      cursor: pointer;
      background: var(--cream);
      padding: 16px 20px;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
      font-weight: 700;
      list-style: none;
    }

    .admin-collapse>summary::-webkit-details-marker {
      display: none;
    }

    .admin-collapse>summary::before {
      content: "▾";
      display: inline-block;
      margin-left: 8px;
      transition: transform .2s ease;
    }

    .admin-collapse[open]>summary::before {
      transform: rotate(180deg);
    }

    .admin-collapse[open]>summary {
      margin-bottom: 12px;
    }

    .table-wrap {
      width: 100%;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: var(--cream);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    th,
    td {
      padding: 12px 14px;
      text-align: right;
      font-size: .88rem;
      border-bottom: 1px solid var(--stone-dark);
      vertical-align: top;
    }

    th {
      background: var(--stone-dark);
      white-space: nowrap;
    }

    .row-actions {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .mini-btn {
      font-size: .78rem;
      padding: 6px 10px;
      border-radius: 6px;
      border: 1px solid var(--stone-dark);
      background: var(--cream);
    }

    .mini-btn.primary {
      background: var(--ink);
      color: var(--cream);
      border-color: var(--ink);
    }

    .mini-btn.danger {
      border-color: #c76c6c;
      color: #9c3b3b;
    }

    .pill {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: .75rem;
      font-weight: 700;
    }

    .pill.ok {
      background: #dce7d6;
      color: #3a5c33;
    }

    .pill.warn {
      background: #f3e3c4;
      color: #8a6a1f;
    }

    .pill.bad {
      background: #f1d4d4;
      color: #9c3b3b;
    }

    .inline-form {
      display: grid;
      gap: 8px;
      min-width: 190px;
    }

    .inline-form input,
    .inline-form select {
      width: 100%;
      padding: 7px 9px;
      border: 1px solid var(--stone-dark);
      border-radius: 6px;
    }

    .meeting-calendar-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      margin: 18px 0;
    }

    .calendar-navigation {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .weekly-calendar-wrap {
      overflow-x: auto;
      background: var(--cream);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
      margin-bottom: 24px;
    }

    .weekly-calendar {
      display: grid;
      grid-template-columns: 70px repeat(7, minmax(125px, 1fr));
      min-width: 980px;
      position: relative;
    }

    .calendar-corner,
    .calendar-day-header,
    .calendar-time-label,
    .calendar-slot {
      border-left: 1px solid var(--stone-dark);
      border-bottom: 1px solid var(--stone-dark);
    }

    .calendar-corner {
      min-height: 70px;
      background: var(--stone-dark);
    }

    .calendar-day-header {
      min-height: 70px;
      padding: 10px;
      text-align: center;
      background: var(--stone-dark);
      position: sticky;
      top: 0;
      z-index: 5;
    }

    .calendar-day-header.today {
      background: #e8dfc6;
    }

    .calendar-day-name {
      display: block;
      font-weight: 700;
    }

    .calendar-day-date {
      display: block;
      margin-top: 4px;
      font-size: .8rem;
      color: var(--ink-soft);
    }

    .calendar-time-label {
      height: 48px;
      padding: 5px 8px;
      font-size: .75rem;
      color: var(--ink-soft);
      background: var(--stone);
      text-align: center;
    }

    .calendar-slot {
      height: 48px;
      position: relative;
      background: var(--cream);
      cursor: pointer;
      transition: background .15s ease;
    }

    .calendar-slot:hover {
      background: #f5edd8;
    }

    .calendar-slot.past {
      background: #eceae4;
      cursor: not-allowed;
    }

    .calendar-slot.selected-start {
      background: #e8d49a;
      box-shadow: inset 0 0 0 2px var(--oak-dark);
    }

    .calendar-slot.selected-range {
      background: #f3e7bd;
    }

    .calendar-booking {
      position: absolute;
      inset: 3px;
      z-index: 3;
      padding: 5px 7px;
      border-radius: 7px;
      background: var(--ink);
      color: var(--cream);
      font-size: .72rem;
      line-height: 1.25;
      overflow: hidden;
      cursor: default;
    }

    .calendar-booking strong {
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .clients-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .client-card summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .client-card .admin-card {
      margin-top: 14px;
    }

    @media (max-width:900px) {
      .stat-cards {
        grid-template-columns: 1fr;
      }

      .admin-header .container {
        align-items: flex-start;
        flex-direction: column;
      }
    }
    .quota-alerts-section {
  margin-bottom: 32px;
}

.quota-alerts-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;

  margin-bottom: 14px;
}

.quota-alerts-heading h2 {
  margin: 5px 0 0;
}

.quota-alert-label {
  font-size: .78rem;
  font-weight: 800;
  color: #9c3b3b;
}

.quota-alert-count {
  min-width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #9c3b3b;
  color: #fff;

  font-weight: 800;
}

.quota-alerts-list {
  display: grid;
  gap: 14px;
}

.quota-admin-alert {
  background: #fff8e8;

  border: 1px solid #dfc684;
  border-right: 5px solid #c59631;

  border-radius: var(--radius-lg);

  padding: 20px;

  box-shadow: var(--shadow);
}

.quota-admin-alert.chargeable {
  background: #fff0f0;
  border-color: #df9c9c;
  border-right-color: #b74343;
}

.quota-admin-alert-main {
  display: flex;
  align-items: center;
  gap: 14px;

  margin-bottom: 18px;
}

.quota-admin-alert-icon {
  width: 42px;
  height: 42px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #c59631;
  color: #fff;

  font-size: 1.3rem;
  font-weight: 900;
}

.quota-admin-alert.chargeable
.quota-admin-alert-icon {
  background: #b74343;
}

.quota-admin-alert-title {
  color: #9c6c17;
  font-size: .8rem;
  font-weight: 800;
}

.quota-admin-alert.chargeable
.quota-admin-alert-title {
  color: #a32f2f;
}

.quota-admin-alert h3 {
  margin: 3px 0;
}

.quota-admin-numbers {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;

  margin-bottom: 18px;
}

.quota-admin-numbers > div {
  background: rgba(255, 255, 255, .65);
  border-radius: 9px;
  padding: 12px;
}

.quota-admin-numbers span {
  display: block;
  margin-bottom: 3px;

  font-size: .75rem;
  color: var(--ink-soft);
}

.quota-admin-numbers strong {
  font-size: 1rem;
}

.quota-admin-status {
  display: grid;
  gap: 4px;

  padding-top: 14px;
  border-top: 1px solid rgba(0, 0, 0, .1);
}

.quota-admin-status span {
  font-size: .85rem;
  color: var(--ink-soft);
}

.quota-admin-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;

  margin-top: 16px;
}

.quota-admin-actions a {
  text-decoration: none;
}

@media (max-width: 700px) {
  .quota-admin-numbers {
    grid-template-columns: 1fr;
  }
}
  </style>
</head>

<body>
  <header class="admin-header">
    <div class="container">
      <strong>פאנל ניהול AlonSpace</strong>

      <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
        <span>שלום, <%= adminName %></span>
        <a href="/" target="_blank" class="btn btn-outline-light" style="padding:8px 16px;">
          צפייה באתר
        </a>

        <form method="POST" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <button type="submit">
            התנתקות
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="container admin-wrap">
    <% if (error) { %>
      <div class="form-msg show err">
        <%= error %>
      </div>
      <% } %>

        <% if (success) { %>
          <div class="form-msg show ok">
            <%= success %>
          </div>
          <% } %>
<% if (quotaAlerts && quotaAlerts.length) { %>

  <section class="quota-alerts-section">

    <div class="quota-alerts-heading">
      <div>
        <span class="quota-alert-label">דורש טיפול</span>
        <h2>חריגות ממכסת חדר הישיבות</h2>
      </div>

      <span class="quota-alert-count">
        <%= quotaAlerts.length %>
      </span>
    </div>

    <div class="quota-alerts-list">

      <% quotaAlerts.forEach(alert => { %>

        <%
          const used = Number(alert.used_hours || 0);
          const limit = Number(alert.monthly_meeting_hours || 6);
          const exceeded = Math.max(0, used - limit);
          const hasChargeable =
            Number(alert.chargeable_bookings || 0) > 0;

          let whatsappPhone = String(alert.phone || '')
            .replace(/\D/g, '');

          if (whatsappPhone.startsWith('0')) {
            whatsappPhone =
              '972' + whatsappPhone.slice(1);
          }

          const whatsappText =
            encodeURIComponent(
              `שלום ${alert.display_name}, רצינו ליצור איתך קשר בנוגע למכסת שעות חדר הישיבות שלך ב-AlonSpace.`
            );
        %>

        <article
          class="quota-admin-alert <%= hasChargeable ? 'chargeable' : '' %>"
        >

          <div class="quota-admin-alert-main">

            <div class="quota-admin-alert-icon">
              !
            </div>

            <div>
              <div class="quota-admin-alert-title">

                <% if (hasChargeable) { %>
                  חריגה נוספת — נדרש טיפול
                <% } else { %>
                  הלקוח עבר את המכסה החודשית
                <% } %>

              </div>

              <h3>
                <%= alert.display_name %>
              </h3>

              <p class="small">
                משרד <%= alert.office_number || '-' %>
                · קומה <%= alert.floor || '-' %>
              </p>
            </div>

          </div>

          <div class="quota-admin-numbers">

            <div>
              <span>מכסה</span>
              <strong><%= limit.toFixed(1) %> שעות</strong>
            </div>

            <div>
              <span>נוצלו</span>
              <strong><%= used.toFixed(1) %> שעות</strong>
            </div>

            <div>
              <span>חריגה</span>
              <strong><%= exceeded.toFixed(1) %> שעות</strong>
            </div>

          </div>

          <div class="quota-admin-status">

            <% if (hasChargeable) { %>

              <strong>
                הלקוח כבר ביצע שריון נוסף לאחר חציית המכסה.
              </strong>

              <span>
                יש לבדוק חיוב וליצור קשר עם הלקוח.
              </span>

            <% } else { %>

              <strong>
                זו החריגה הראשונה שנרשמה החודש.
              </strong>

              <span>
                הלקוח קיבל התראה שהמשך שימוש מעבר למכסה עשוי להיות כרוך בתשלום.
              </span>

            <% } %>

          </div>

          <div class="quota-admin-actions">

            <% if (whatsappPhone) { %>
              <a
                href="https://wa.me/<%= whatsappPhone %>?text=<%= whatsappText %>"
                target="_blank"
                rel="noopener"
                class="mini-btn primary"
              >
                יצירת קשר ב־WhatsApp
              </a>
            <% } %>

            <% if (alert.phone) { %>
              <a
                href="tel:<%= alert.phone %>"
                class="mini-btn"
              >
                התקשר
              </a>
            <% } %>

          </div>

        </article>

      <% }) %>

    </div>

  </section>

<% } %>
            <div class="stat-cards">
              <div class="stat-card">
                <div class="n">
                  <%= stats.activeClients %>
                </div>
                <div class="l">לקוחות פעילים</div>
              </div>

              <div class="stat-card">
                <div class="n">
                  <%= stats.upcomingMeetings %>
                </div>
                <div class="l">שריונים עתידיים</div>
              </div>
            </div>


            <div class="tabs">
              <button class="tab-btn active" data-tab="clients">לקוחות</button>
              <button class="tab-btn" data-tab="meeting-room">חדר ישיבות</button>

            </div>

            <section class="tab-panel active" id="tab-clients">
              <details class="admin-collapse">
                <summary>יצירת חשבון לקוח</summary>

                <div class="admin-card">
                  <h3>יצירת חשבון לקוח</h3>

                  <form method="POST" action="/admin/clients/create" class="form-grid">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="form-row-2">
                      <div class="field">
                        <label>שם משתמש</label>
                        <input name="username" required autocomplete="off">
                      </div>


                    </div>

                    <div class="form-row-2">
                      <div class="field">
                        <label>שם לתצוגה</label>
                        <input name="display_name" required>
                      </div>

                      <div class="field">
                        <label>שם העסק</label>
                        <input name="business_name">
                      </div>
                    </div>

                    <div class="form-row-2">
                      <div class="field">
                        <label>אימייל</label>
                        <input type="email" name="email">
                      </div>

                      <div class="field">
                        <label>טלפון</label>
                        <input name="phone">
                      </div>
                    </div>

                    <div class="form-row-2">
                      <div class="field">
                        <label>מספר משרד</label>
                        <input name="office_number">
                      </div>

                      <div class="field">
                        <label>קומה</label>
                        <select name="floor">
                          <option value="">לא הוגדר</option>
                          <option value="4">קומה 4</option>
                          <option value="6">קומה 6</option>
                        </select>
                      </div>
                    </div>

                    <div class="form-row-2">
                      <div class="field">
                        <label>תחילת שכירות</label>
                        <input type="date" name="rental_start_date">
                      </div>

                      <div class="field">
                        <label>סיום שכירות</label>
                        <input type="date" name="rental_end_date">
                      </div>
                    </div>

                    <div class="field">
                      <label>מכסת חדר ישיבות חודשית</label>
                      <input type="number" name="monthly_meeting_hours" min="0.5" step="0.5" value="6">
                    </div>

                    <button class="btn btn-primary" type="submit">
                      צור חשבון לקוח
                    </button>
                  </form>
                </div>
              </details>
              <details class="admin-collapse">
                <summary>ניהול לקוחות</summary>

                <div class="table-wrap">
                  <div class="clients-list">

                    <% if (!clients.length) { %>

                      <div class="admin-card" style="text-align:center;">
                        עדיין אין לקוחות.
                      </div>

                      <% } %>

                        <% clients.forEach(client=> { %>

                          <details class="admin-collapse client-card">

                            <summary>

                              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">

                                <strong>
                                  <%= client.display_name %>
                                </strong>

                                <span class="small">
                                  @<%= client.username %>
                                </span>

                                <% if(client.business_name){ %>
                                  <span class="small">
                                    • <%= client.business_name %>
                                  </span>
                                  <% } %>

                              </div>

                              <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap;">

                                <span>
                                  משרד <%= client.office_number || "-" %>
                                </span>

                                <span>
                                  קומה <%= client.floor || "-" %>
                                </span>

                                <span class="pill <%= client.is_active ? 'ok' : 'bad' %>">
                                  <%= client.is_active ? 'פעיל' : 'מושבת' %>
                                </span>

                              </div>

                            </summary>

                            <div class="admin-card">

                              <div class="form-row-2">

                                <div>

                                  <h4>פרטי הלקוח</h4>

                                  <p><strong>טלפון:</strong>
                                    <%= client.phone || "-" %>
                                  </p>

                                  <p><strong>אימייל:</strong>
                                    <%= client.email || "-" %>
                                  </p>

                                  <p><strong>תקופת שכירות:</strong></p>

                                  <p>
                                    <%= formatDate(client.rental_start_date) %>
                                      -
                                      <%= formatDate(client.rental_end_date) || "-" %>
                                  </p>

                                </div>

                                <div>

                                  <h4>עריכת לקוח</h4>

                                  <form method="POST" action="/admin/clients/<%= client.id %>/update"
                                    class="inline-form">

                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                    <input name="display_name" value="<%= client.display_name %>" required>

                                    <input name="business_name" value="<%= client.business_name || '' %>"
                                      placeholder="שם העסק">

                                    <input type="email" name="email" value="<%= client.email || '' %>"
                                      placeholder="אימייל">

                                    <input name="phone" value="<%= client.phone || '' %>" placeholder="טלפון">

                                    <input name="office_number" value="<%= client.office_number || '' %>"
                                      placeholder="משרד">

                                    <select name="floor">

                                      <option value="">קומה</option>

                                      <option value="4" <%=Number(client.floor)===4 ? 'selected' : '' %>>
                                        4
                                      </option>

                                      <option value="6" <%=Number(client.floor)===6 ? 'selected' : '' %>>
                                        6
                                      </option>

                                    </select>

<input
  type="date"
  name="rental_start_date"
  value="<%= client.rental_start_date
    ? new Date(client.rental_start_date).toISOString().slice(0, 10)
    : '' %>"
>

<input
  type="date"
  name="rental_end_date"
  value="<%= client.rental_end_date
    ? new Date(client.rental_end_date).toISOString().slice(0, 10)
    : '' %>"
>
                                    <input type="number" min="0.5" step="0.5" name="monthly_meeting_hours"
                                      value="<%= client.monthly_meeting_hours %>">

                                    <label style="display:flex;gap:8px;align-items:center;">
  <input
    type="checkbox"
    name="is_active"
    value="1"
    <%= client.is_active ? 'checked' : '' %>
    style="width:auto;"
  >

  חשבון פעיל
</label>

                                    <button type="submit" class="mini-btn primary">
                                      שמור שינויים
                                    </button>

                                  </form>

                                </div>

                              </div>

                              <hr style="margin:25px 0;">

                              <div style="display:flex;gap:10px;flex-wrap:wrap;">

                                <form method="POST" action="/admin/clients/<%= client.id %>/reset-password">

                                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                  <button class="mini-btn">
                                    איפוס סיסמה
                                  </button>

                                </form>

                                <% if(client.is_active){ %>

                                  <form method="POST" action="/admin/clients/<%= client.id %>/delete"
                                    onsubmit="return confirm('להשבית את החשבון?')">

                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                    <button class="mini-btn danger">
                                      השבת חשבון
                                    </button>

                                  </form>

                                  <form method="POST" action="/admin/clients/<%= client.id %>/permanent-delete"
                                    onsubmit="return confirm('למחוק לצמיתות?')">

                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                    <button class="mini-btn danger" style="background:#c62828;color:#fff;">

                                      מחק לצמיתות

                                    </button>

                                  </form>

                                  <% } %>

                              </div>

                            </div>

                          </details>

                          <% }) %>

                  </div>
                </div>
              </details>
            </section>

            <section class="tab-panel" id="tab-meeting-room">

              <div class="admin-card" style="
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:14px;
    flex-wrap:wrap;
  ">
                <div>
                  <h3 style="margin:0 0 5px;">
                    יומן חדרי הישיבות
                  </h3>

                  <span class="small">
                    בחר חדר כדי להציג את השריונים הרלוונטיים.
                  </span>
                </div>

                <div id="meeting-room-switcher" style="
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    ">
                  <button type="button" class="mini-btn primary room-filter-btn active" data-room-floor="4">
                    חדר קומה 4
                  </button>

                  <button type="button" class="mini-btn room-filter-btn" data-room-floor="6">
                    חדר קומה 6
                  </button>


                </div>
              </div>

              <div class="meeting-calendar-toolbar">
                <div class="calendar-navigation">
                  <button type="button" class="mini-btn" id="adminPreviousWeek">
                    השבוע הקודם
                  </button>

                  <button type="button" class="mini-btn primary" id="adminCurrentWeek">
                    השבוע הנוכחי
                  </button>

                  <button type="button" class="mini-btn" id="adminNextWeek">
                    השבוע הבא
                  </button>
                </div>

                <strong id="adminCalendarWeekTitle"></strong>
              </div>

              <div class="weekly-calendar-wrap">
                <div class="weekly-calendar" id="adminWeeklyCalendar"></div>
              </div>
              <details class="admin-collapse">
                <summary>יצירת שריון בשם לקוח</summary>

                <div class="admin-card">
                  <div id="adminSelectedBookingRange" class="form-msg" style="margin-bottom:14px;"></div>

                  <form method="POST" action="/admin/meeting-bookings/create" class="form-grid"
                    id="adminMeetingBookingForm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="form-row-2">
                      <div class="field">
                        <label for="booking-user">
                          לקוח
                        </label>

                        <select id="booking-user" name="user_id" required>
                          <option value="">
                            בחירת לקוח
                          </option>

                          <% clients .filter(client=> client.is_active)
                            .forEach(client => { %>
                            <option value="<%= client.id %>" data-floor="<%= client.floor || '' %>">
                              <%= client.display_name %>
                                — קומה <%= client.floor || 'לא הוגדרה' %>
                            </option>
                            <% }) %>
                        </select>
                      </div>

                      <div class="field">
                        <label for="booking-room">
                          חדר ישיבות
                        </label>

                        <select id="booking-room" name="meeting_room_id" required>
                          <option value="">
                            בחירת חדר
                          </option>

                          <% meetingRooms.forEach(room=> { %>
                            <option value="<%= room.id %>" data-floor="<%= room.floor %>">
                              <%= room.name %>
                            </option>
                            <% }) %>
                        </select>
                      </div>
                    </div>

                    <div class="form-row-2">
                      <div class="field">
                        <label>תאריך</label>

                        <input id="admin_booking_date" type="date" name="booking_date" required>
                      </div>

                      <div class="field">
                        <label>הערה</label>

                        <input type="text" name="note" placeholder="אופציונלי">
                      </div>
                    </div>

                    <div class="form-row-2">
                      <div class="field">
                        <label>שעת התחלה</label>

                        <input id="admin_start_time" type="time" name="start_time" step="1800" required>
                      </div>

                      <div class="field">
                        <label>שעת סיום</label>

                        <input id="admin_end_time" type="time" name="end_time" step="1800" required>
                      </div>
                    </div>

                    <button type="submit" class="btn btn-primary">
                      יצירת שריון
                    </button>
                  </form>
                </div>
              </details>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>תאריך</th>
                      <th>שעות</th>
                      <th>לקוח</th>
                      <th>משרד</th>
                      <th>הערה</th>
                      <th>פעולות</th>
                    </tr>
                  </thead>

                  <tbody>
                    <% if (!meetingBookings.length) { %>
                      <tr>
                        <td colspan="6" style="text-align:center; padding:30px;">
                          אין שריונים.
                        </td>
                      </tr>
                      <% } %>

                        <% meetingBookings.forEach(booking=> { %>
                          <tr class="meeting-booking-row" data-room-floor="<%= booking.meeting_room_floor %>">
                            <td>
                              <%= booking.booking_date %>
                            </td>
                            <td>
                              <%= booking.start_time %>–<%= booking.end_time %>
                            </td>
                            <td>
                              <%= booking.display_name %>
                                <br><span class="small">
                                  <%= booking.business_name || '' %>
                                </span>
                            </td>
                            <td>
                              <%= booking.office_number ? `משרד ${booking.office_number}` : '-' %>
                                <%= booking.floor ? `, קומה ${booking.floor}` : '' %>
                            </td>
                            <td>
                              <%= booking.note || '-' %>
                            </td>
                            <td>
                              <form method="POST" action="/admin/meeting-bookings/<%= booking.id %>/delete"
                                onsubmit="return confirm('למחוק את השריון?')">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button class="mini-btn danger">מחיקה</button>
                              </form>
                            </td>
                          </tr>
                          <% }) %>
                  </tbody>
                </table>
              </div>
            </section>

  </main>



  <script>
    /* =========================
       טאבים
    ========================= */

    document.querySelectorAll('.tab-btn').forEach((button) => {
      button.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach((item) => {
          item.classList.remove('active');
        });

        document.querySelectorAll('.tab-panel').forEach((panel) => {
          panel.classList.remove('active');
        });

        button.classList.add('active');

        const panel = document.getElementById(
          'tab-' + button.dataset.tab
        );

        if (panel) {
          panel.classList.add('active');
        }

        window.location.hash = button.dataset.tab;
      });
    });

    const pageHash = window.location.hash.replace('#', '');

    if (pageHash) {
      const matchingButton = document.querySelector(
        `.tab-btn[data-tab="${pageHash}"]`
      );

      if (matchingButton) {
        matchingButton.click();
      }
    }


    /* =========================
       נתוני השריונים
    ========================= */

    const adminMeetingBookings =
  <%- JSON.stringify(meetingBookings || []).replace(/</g, '\\u003c') %>;

    const adminCalendar =
      document.getElementById('adminWeeklyCalendar');

    const adminWeekTitle =
      document.getElementById('adminCalendarWeekTitle');

    const adminBookingForm =
      document.getElementById('adminMeetingBookingForm');

    const adminRoomSelect =
      document.getElementById('booking-room');

    const adminUserSelect =
      document.getElementById('booking-user');

    const adminBookingDateInput =
      document.getElementById('admin_booking_date');

    const adminStartTimeInput =
      document.getElementById('admin_start_time');

    const adminEndTimeInput =
      document.getElementById('admin_end_time');
    const adminSelectedBookingRange =
      document.getElementById(
        'adminSelectedBookingRange'
      );
    const roomFilterButtons =
      document.querySelectorAll('.room-filter-btn');

    const meetingBookingRows =
      document.querySelectorAll('.meeting-booking-row');


    /* =========================
       הגדרות לוח
    ========================= */

    const adminDayNames = [
      'ראשון',
      'שני',
      'שלישי',
      'רביעי',
      'חמישי',
      'שישי',
      'שבת',
    ];

    const adminCalendarStartHour = 8;
    const adminCalendarEndHour = 21;
    const adminSlotMinutes = 30;

    let adminDisplayedWeekStart =
      getAdminStartOfWeek(new Date());

    let adminSelectedStartSlot = null;

    let selectedAdminRoomFloor =
      localStorage.getItem('adminMeetingRoomFloor') || '4';


    /* =========================
       פונקציות עזר
    ========================= */

    function getAdminStartOfWeek(date) {
      const result = new Date(date);

      result.setHours(0, 0, 0, 0);
      result.setDate(result.getDate() - result.getDay());

      return result;
    }

    function addAdminDays(date, amount) {
      const result = new Date(date);

      result.setDate(result.getDate() + amount);

      return result;
    }

    function adminDateKey(date) {
      const year = date.getFullYear();

      const month = String(
        date.getMonth() + 1
      ).padStart(2, '0');

      const day = String(
        date.getDate()
      ).padStart(2, '0');

      return `${year}-${month}-${day}`;
    }

    function normalizeAdminBookingDate(value) {
      if (!value) return '';

      const text = String(value);

      if (/^\d{4}-\d{2}-\d{2}/.test(text)) {
        return text.slice(0, 10);
      }

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) {
        return '';
      }

      return adminDateKey(date);
    }

    function normalizeAdminTime(value) {
      return String(value || '').slice(0, 5);
    }

    function adminTimeToMinutes(value) {
      const normalized = normalizeAdminTime(value);

      const match = /^(\d{2}):(\d{2})$/.exec(
        normalized
      );

      if (!match) {
        return null;
      }

      return (
        Number(match[1]) * 60 +
        Number(match[2])
      );
    }

    function adminMinutesToTime(minutes) {
      const hours = Math.floor(minutes / 60);
      const remainingMinutes = minutes % 60;

      return (
        String(hours).padStart(2, '0') +
        ':' +
        String(remainingMinutes).padStart(2, '0')
      );
    }

    function isAdminPastSlot(day, minutes) {
      const slotDate = new Date(day);

      slotDate.setHours(
        Math.floor(minutes / 60),
        minutes % 60,
        0,
        0
      );

      return slotDate <= new Date();
    }

    function getBookingRoomFloor(booking) {
      return Number(
        booking.meeting_room_floor ||
        booking.room_floor ||
        booking.floor
      );
    }

    function syncAdminRoomSelect(roomFloor) {
      if (!adminRoomSelect) return;

      const matchingOption = Array
        .from(adminRoomSelect.options)
        .find((option) => {
          return String(option.dataset.floor) ===
            String(roomFloor);
        });

      if (matchingOption) {
        adminRoomSelect.value =
          matchingOption.value;
      }
    }

    function clearAdminCalendarSelection() {
      adminSelectedStartSlot = null;

      document
        .querySelectorAll(
          '#adminWeeklyCalendar .selected-start,' +
          '#adminWeeklyCalendar .selected-range'
        )
        .forEach((item) => {
          item.classList.remove(
            'selected-start',
            'selected-range'
          );
        });
    }

    function highlightAdminRange(
      date,
      startMinutes,
      endMinutes
    ) {
      document
        .querySelectorAll(
          `#adminWeeklyCalendar ` +
          `.calendar-slot[data-date="${date}"]`
        )
        .forEach((item) => {
          const itemMinutes = Number(
            item.dataset.startMinutes
          );

          if (
            itemMinutes >= startMinutes &&
            itemMinutes < endMinutes
          ) {
            item.classList.add('selected-range');
          }
        });
    }


    /* =========================
       סינון טבלת השריונים
    ========================= */

    function filterAdminBookingTable(roomFloor) {
      meetingBookingRows.forEach((row) => {
        row.style.display =
          String(row.dataset.roomFloor) ===
            String(roomFloor)
            ? ''
            : 'none';
      });
    }


    /* =========================
       ציור הלוח
    ========================= */

    function renderAdminCalendar() {
      if (!adminCalendar || !adminWeekTitle) {
        return;
      }

      clearAdminCalendarSelection();
      adminCalendar.innerHTML = '';

      const weekEnd = addAdminDays(
        adminDisplayedWeekStart,
        6
      );

      adminWeekTitle.textContent =
        adminDisplayedWeekStart.toLocaleDateString(
          'he-IL',
          {
            day: 'numeric',
            month: 'long',
          }
        ) +
        ' – ' +
        weekEnd.toLocaleDateString(
          'he-IL',
          {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          }
        );

      const corner = document.createElement('div');
      corner.className = 'calendar-corner';

      adminCalendar.appendChild(corner);

      const todayKey = adminDateKey(new Date());

      for (
        let dayIndex = 0;
        dayIndex < 7;
        dayIndex += 1
      ) {
        const day = addAdminDays(
          adminDisplayedWeekStart,
          dayIndex
        );

        const header =
          document.createElement('div');

        header.className = 'calendar-day-header';

        if (adminDateKey(day) === todayKey) {
          header.classList.add('today');
        }

        header.innerHTML = `
        <span class="calendar-day-name">
          ${adminDayNames[dayIndex]}
        </span>

        <span class="calendar-day-date">
          ${day.toLocaleDateString('he-IL', {
          day: '2-digit',
          month: '2-digit',
        })}
        </span>
      `;

        adminCalendar.appendChild(header);
      }

      for (
        let minutes = adminCalendarStartHour * 60;
        minutes < adminCalendarEndHour * 60;
        minutes += adminSlotMinutes
      ) {
        const timeLabel =
          document.createElement('div');

        timeLabel.className =
          'calendar-time-label';

        timeLabel.textContent =
          adminMinutesToTime(minutes);

        adminCalendar.appendChild(timeLabel);

        for (
          let dayIndex = 0;
          dayIndex < 7;
          dayIndex += 1
        ) {
          const day = addAdminDays(
            adminDisplayedWeekStart,
            dayIndex
          );

          const currentDateKey =
            adminDateKey(day);

          const slot =
            document.createElement('div');

          slot.className = 'calendar-slot';
          slot.dataset.date = currentDateKey;
          slot.dataset.startMinutes =
            String(minutes);

          const past =
            isAdminPastSlot(day, minutes);

          if (past) {
            slot.classList.add('past');
          } else {
            slot.addEventListener('click', () => {
              handleAdminSlotClick(
                slot,
                currentDateKey,
                minutes
              );
            });
          }

          const booking =
            adminMeetingBookings.find((item) => {
              const bookingStart =
                adminTimeToMinutes(
                  item.start_time
                );

              const bookingEnd =
                adminTimeToMinutes(
                  item.end_time
                );

              return (
                getBookingRoomFloor(item) ===
                Number(selectedAdminRoomFloor) &&
                normalizeAdminBookingDate(
                  item.booking_date
                ) === currentDateKey &&
                bookingStart !== null &&
                bookingEnd !== null &&
                bookingStart <= minutes &&
                bookingEnd > minutes
              );
            });

          if (
            booking &&
            adminTimeToMinutes(
              booking.start_time
            ) === minutes
          ) {
            const bookingElement =
              document.createElement('div');

            bookingElement.className =
              'calendar-booking';

            const durationMinutes =
              adminTimeToMinutes(
                booking.end_time
              ) -
              adminTimeToMinutes(
                booking.start_time
              );

            const slotCount = Math.max(
              1,
              durationMinutes / adminSlotMinutes
            );

            bookingElement.style.height =
              `calc(${slotCount * 48}px - 6px)`;

            bookingElement.innerHTML = `
            <strong>
              ${booking.display_name || 'שריון'}
            </strong>

            ${normalizeAdminTime(
              booking.start_time
            )}
            –
            ${normalizeAdminTime(
              booking.end_time
            )}

            <br>

            משרד ${booking.office_number || '-'}
          `;

            bookingElement.title =
              `${booking.display_name || 'שריון'}\n` +
              `${normalizeAdminTime(
                booking.start_time
              )}–${normalizeAdminTime(
                booking.end_time
              )}\n` +
              `${booking.note || ''}`;

            slot.appendChild(bookingElement);
          }

          adminCalendar.appendChild(slot);
        }
      }
    }


    /* =========================
       בחירת טווח בלוח
    ========================= */

    function handleAdminSlotClick(
      slot,
      currentDateKey,
      minutes
    ) {
      if (
        !adminSelectedStartSlot ||
        adminSelectedStartSlot.date !==
        currentDateKey
      ) {
        clearAdminCalendarSelection();

        adminSelectedStartSlot = {
          date: currentDateKey,
          minutes,
          element: slot,
        };

        slot.classList.add('selected-start');

        adminBookingDateInput.value =
          currentDateKey;

        adminStartTimeInput.value =
          adminMinutesToTime(minutes);

        adminEndTimeInput.value = '';
        if (adminSelectedBookingRange) {
          adminSelectedBookingRange.classList.remove(
            'show',
            'ok'
          );

          adminSelectedBookingRange.textContent = '';
        }
        return;
      }

      if (
        minutes <=
        adminSelectedStartSlot.minutes
      ) {
        clearAdminCalendarSelection();

        adminSelectedStartSlot = {
          date: currentDateKey,
          minutes,
          element: slot,
        };

        slot.classList.add('selected-start');

        adminBookingDateInput.value =
          currentDateKey;

        adminStartTimeInput.value =
          adminMinutesToTime(minutes);

        adminEndTimeInput.value = '';
        if (adminSelectedBookingRange) {
          adminSelectedBookingRange.classList.remove(
            'show',
            'ok'
          );

          adminSelectedBookingRange.textContent = '';
        }
        return;
      }

      const selectedStartMinutes =
        adminSelectedStartSlot.minutes;

      const selectedEndMinutes =
        minutes + adminSlotMinutes;

      adminBookingDateInput.value =
        currentDateKey;

      adminStartTimeInput.value =
        adminMinutesToTime(
          selectedStartMinutes
        );

      adminEndTimeInput.value =
        adminMinutesToTime(
          selectedEndMinutes
        );
      if (adminSelectedBookingRange) {
        adminSelectedBookingRange.classList.add(
          'show',
          'ok'
        );

        adminSelectedBookingRange.textContent =
          `נבחר: ${currentDateKey}, ` +
          `${adminMinutesToTime(selectedStartMinutes)}–` +
          `${adminMinutesToTime(selectedEndMinutes)}`;
      }
      highlightAdminRange(
        currentDateKey,
        selectedStartMinutes,
        selectedEndMinutes
      );

      adminSelectedStartSlot.element
        .classList.remove('selected-start');

      adminSelectedStartSlot = null;

      adminBookingForm?.scrollIntoView({
        behavior: 'smooth',
        block: 'center',
      });
    }


    /* =========================
       החלפת חדר
    ========================= */

    function selectAdminRoom(roomFloor) {
      selectedAdminRoomFloor =
        String(roomFloor);

      localStorage.setItem(
        'adminMeetingRoomFloor',
        selectedAdminRoomFloor
      );

      roomFilterButtons.forEach((button) => {
        const active =
          String(button.dataset.roomFloor) ===
          selectedAdminRoomFloor;

        button.classList.toggle(
          'primary',
          active
        );

        button.classList.toggle(
          'active',
          active
        );
      });

      syncAdminRoomSelect(
        selectedAdminRoomFloor
      );

      filterAdminBookingTable(
        selectedAdminRoomFloor
      );

      renderAdminCalendar();
    }

    roomFilterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selectAdminRoom(
          button.dataset.roomFloor
        );
      });
    });


    /* =========================
       מעבר בין שבועות
    ========================= */

    document
      .getElementById('adminPreviousWeek')
      ?.addEventListener('click', () => {
        adminDisplayedWeekStart =
          addAdminDays(
            adminDisplayedWeekStart,
            -7
          );

        renderAdminCalendar();
      });

    document
      .getElementById('adminNextWeek')
      ?.addEventListener('click', () => {
        adminDisplayedWeekStart =
          addAdminDays(
            adminDisplayedWeekStart,
            7
          );

        renderAdminCalendar();
      });

    document
      .getElementById('adminCurrentWeek')
      ?.addEventListener('click', () => {
        adminDisplayedWeekStart =
          getAdminStartOfWeek(new Date());

        renderAdminCalendar();
      });


    /* =========================
       התאמת לקוח לחדר
    ========================= */

    adminUserSelect?.addEventListener('change', () => {
      const selectedOption =
        adminUserSelect.options[
        adminUserSelect.selectedIndex
        ];

      const tenantFloor =
        selectedOption?.dataset.floor;

      if (
        tenantFloor === '4' ||
        tenantFloor === '6'
      ) {
        selectAdminRoom(tenantFloor);
      }
    });


    /* =========================
       אתחול
    ========================= */

    if (
      selectedAdminRoomFloor !== '4' &&
      selectedAdminRoomFloor !== '6'
    ) {
      selectedAdminRoomFloor = '4';
    }

    selectAdminRoom(
      selectedAdminRoomFloor
    );
  </script>
  <% if (newClientInvite) { %>
    <script>
      const inviteMessage = `שלום <%= newClientInvite.displayName %>!

נוצר עבורך חשבון במערכת AlonSpace.

👤 שם משתמש:
<%= newClientInvite.username %>

🔑 סיסמה:
<%= newClientInvite.temporaryPassword %>

🔗 קישור לכניסה מהירה:
<%= newClientInvite.magicLoginUrl %>

הקישור תקף ל־48 שעות ולשימוש חד־פעמי.

לאחר מכן ניתן להתחבר כרגיל באמצעות שם המשתמש והסיסמה.

AlonSpace`;

      const copyBtn = document.createElement("button");

      copyBtn.textContent = "📋 העתק הודעת התחברות";

      copyBtn.style.position = "fixed";
      copyBtn.style.left = "20px";
      copyBtn.style.bottom = "20px";
      copyBtn.style.zIndex = "99999";

      copyBtn.onclick = async () => {
        await navigator.clipboard.writeText(inviteMessage);
        copyBtn.textContent = "✅ הועתק";
      };

      document.body.appendChild(copyBtn);
    </script>
    <% } %>

</body>

</html>