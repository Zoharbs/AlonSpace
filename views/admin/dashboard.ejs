            <% if (alert.phone) { %>

              <a
                href="tel:<%= alert.phone %>"
                class="mini-btn"
              >
                התקשר
              </a>

            <% } %>

          </div>

        </article>

      <% }) %>

    </div>

    </details>

<% } %>
